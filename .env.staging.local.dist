# Modele de secrets staging. Copier vers .env.staging.local (jamais
# committe) et renseigner avant tout demarrage :
#   cp .env.staging.local.dist .env.staging.local
#   docker compose -f compose.yml -f compose.staging.yml --env-file .env.staging.local up -d --wait

PHP_VERSION=8.4
FRANKENPHP_VERSION=1.12.7
PHP_EXTENSION_INSTALLER_VERSION=2.11.12
POSTGRES_VERSION=18
EMBER_VERSION=1.6.0
TARGET=staging
USER_ID=1000
GROUP_ID=1000
HTTP_PORT=80
HTTPS_PORT=443
HTTP3_PORT=443
EMBER_PORT=9191
RUN_MIGRATIONS=1
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=

# Variables obligatoires (${VAR:?...}) — jamais dans le .env racine.
APP_SECRET=
SERVER_NAME=
ACME_EMAIL=
