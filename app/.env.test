# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Rien n'injecte MAILER_DSN hors du conteneur — ni la CI, ni un phpunit lance a
# la main. Sans ces deux lignes, la compilation du conteneur echoue sur
# « Environment variable not found », et le message ne parle jamais d'email.
# Le transport null est ici le bon : un test ne doit joindre personne, et le
# profileur de test recense les messages sans les envoyer.
MAILER_DSN=null://null
MAILER_FROM=noreply@niout.test
