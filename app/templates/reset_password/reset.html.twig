{% extends 'auth/_layout.html.twig' %}

{% block title %}Nouveau mot de passe — Niout{% endblock %}
{% block titre_page %}Choisir un nouveau mot de passe{% endblock %}

{% block formulaire %}
    {{ form_start(resetForm) }}
        {{ form_errors(resetForm) }}
        {{ form_row(resetForm.plainPassword.first) }}
        {{ form_row(resetForm.plainPassword.second) }}

        <button type="submit"
                class="w-full rounded-sm bg-terre-500 px-4 py-2.5 font-medium text-sable-50 hover:bg-terre-600">
            Enregistrer le nouveau mot de passe
        </button>
    {{ form_end(resetForm) }}
{% endblock %}
