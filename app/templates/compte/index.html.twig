{% extends 'base.html.twig' %}

{% block title %}Mon compte — Niout{% endblock %}

{% block body %}
    <section class="mx-auto w-full max-w-2xl px-5 py-14">
        <h1 class="text-3xl text-encre-900">Mon compte</h1>

        {% if not user.verified %}
            <div role="status"
                 class="mt-6 rounded-sm border border-ocre-500/40 bg-ocre-300/15 px-4 py-4 text-sm">
                <p class="text-encre-700">
                    Votre adresse n'est pas encore vérifiée. Votre compte fonctionne normalement,
                    mais il sera supprimé le
                    <strong>{{ dateLimiteVerification|date('d/m/Y') }}</strong>
                    si vous ne validez pas le lien reçu par email.
                </p>
                <form method="post" action="{{ path('app_resend_verification') }}" class="mt-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('renvoyer-verification') }}">
                    <button type="submit" class="text-lapis-500 underline hover:text-lapis-600">
                        Renvoyer le message de vérification
                    </button>
                </form>
            </div>
        {% endif %}

        <dl class="mt-8 divide-y divide-ocre-500/25 border-y border-ocre-500/25">
            <div class="flex justify-between gap-4 py-3">
                <dt class="text-sm text-encre-500">Adresse email</dt>
                <dd class="text-sm text-encre-900">{{ user.email }}</dd>
            </div>
            <div class="flex justify-between gap-4 py-3">
                <dt class="text-sm text-encre-500">Adresse vérifiée</dt>
                <dd class="text-sm">
                    {% if user.verified %}
                        <span class="rounded-sm bg-lapis-500/10 px-2 py-0.5 text-lapis-600">Oui</span>
                    {% else %}
                        <span class="rounded-sm bg-ocre-400/20 px-2 py-0.5 text-ocre-600">En attente</span>
                    {% endif %}
                </dd>
            </div>
            <div class="flex justify-between gap-4 py-3">
                <dt class="text-sm text-encre-500">Inscrit le</dt>
                <dd class="text-sm text-encre-900">
                    {{ user.createdAt|date('d/m/Y') }}
                </dd>
            </div>
        </dl>

        <div class="mt-8 rounded-sm border border-ocre-500/30 bg-sable-50 px-5 py-4">
            <p class="text-sm text-encre-600">
                {% if partiesEnCours > 0 %}
                    Vous menez {{ partiesEnCours }} partie{{ partiesEnCours > 1 ? 's' : '' }} en cours.
                {% else %}
                    Aucune partie en cours. Le pharaon attend.
                {% endif %}
            </p>
            <a href="{{ path('app_parties') }}"
               class="mt-3 inline-block rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 no-underline hover:bg-terre-600">
                Mes parties
            </a>
        </div>


        {# Changer son mot de passe sans passer par « mot de passe oublié » :
           le parcours par email suppose de recevoir un message, ce qui prend du
           temps et suppose une adresse vérifiée. #}
        <section class="mt-10">
            <h2 class="text-2xl text-encre-900">Changer le mot de passe</h2>
            <p class="mt-2 text-sm text-encre-600">
                Le mot de passe actuel est demandé : une session laissée ouverte sur
                une machine partagée ne doit pas suffire à s'approprier le compte.
            </p>

            <div class="mt-5 rounded-sm border border-ocre-500/30 bg-sable-50 p-5">
                {{ form_start(formulaireDeMotDePasse, {action: path('app_compte_mot_de_passe')}) }}
                    {{ form_errors(formulaireDeMotDePasse) }}
                    {{ form_row(formulaireDeMotDePasse.ancienMotDePasse) }}

                    {# Mêmes règles annoncées qu'à l'inscription, et depuis le
                       même gabarit : trois écrans qui les énonceraient chacun à
                       sa façon finiraient par en énoncer une fausse. #}
                    <div data-controller="force-du-mot-de-passe">
                        {{ form_row(formulaireDeMotDePasse.plainPassword.first, {attr: {
                            'data-force-du-mot-de-passe-target': 'champ',
                            'data-action': 'input->force-du-mot-de-passe#evaluer',
                            'aria-describedby': 'regles-du-mot-de-passe',
                        }}) }}
                        <div id="regles-du-mot-de-passe">
                            {{ include('_regles_de_mot_de_passe.html.twig') }}
                        </div>
                    </div>
                    {{ form_row(formulaireDeMotDePasse.plainPassword.second) }}

                    <button type="submit"
                            class="rounded-sm bg-terre-500 px-5 py-2.5 font-medium text-sable-50 hover:bg-terre-600">
                        Changer le mot de passe
                    </button>
                {{ form_end(formulaireDeMotDePasse) }}
            </div>
        </section>
    </section>
{% endblock %}
