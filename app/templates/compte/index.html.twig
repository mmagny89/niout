{% extends 'base.html.twig' %}

{% block title %}Mon compte — Niout{% endblock %}

{% block body %}
    <section class="mx-auto w-full max-w-2xl px-5 py-14">
        <h1 class="text-3xl text-encre-900">Mon compte</h1>

        {% if not user.verified %}
            <div role="status"
                 class="mt-6 rounded-sm border border-ocre-500/40 bg-ocre-300/15 px-4 py-4 text-sm">
                <p class="text-encre-700">
                    Votre adresse n'est pas encore vérifiée. Votre compte fonctionne normalement,
                    mais il sera supprimé le
                    <strong>{{ dateLimiteVerification|date('d/m/Y') }}</strong>
                    si vous ne validez pas le lien reçu par email.
                </p>
                <form method="post" action="{{ path('app_resend_verification') }}" class="mt-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('renvoyer-verification') }}">
                    <button type="submit" class="text-lapis-500 underline hover:text-lapis-600">
                        Renvoyer le message de vérification
                    </button>
                </form>
            </div>
        {% endif %}

        <dl class="mt-8 divide-y divide-ocre-500/25 border-y border-ocre-500/25">
            <div class="flex justify-between gap-4 py-3">
                <dt class="text-sm text-encre-500">Adresse email</dt>
                <dd class="text-sm text-encre-900">{{ user.email }}</dd>
            </div>
            <div class="flex justify-between gap-4 py-3">
                <dt class="text-sm text-encre-500">Adresse vérifiée</dt>
                <dd class="text-sm">
                    {% if user.verified %}
                        <span class="rounded-sm bg-lapis-500/10 px-2 py-0.5 text-lapis-600">Oui</span>
                    {% else %}
                        <span class="rounded-sm bg-ocre-400/20 px-2 py-0.5 text-ocre-600">En attente</span>
                    {% endif %}
                </dd>
            </div>
            <div class="flex justify-between gap-4 py-3">
                <dt class="text-sm text-encre-500">Inscrit le</dt>
                <dd class="text-sm text-encre-900">
                    {{ user.createdAt|date('d/m/Y') }}
                </dd>
            </div>
        </dl>

        <section class="mt-10">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
                <h2 class="text-2xl text-encre-900">Vos parties</h2>
                {# Le plafond ne compte que les parties **en cours** : une
                   partie close reste consultable sans occuper de place, sans
                   quoi jouer longtemps finirait par interdire de jouer. #}
                <p class="text-sm text-encre-500" data-chiffres>
                    {{ partiesEnCours }} en cours sur {{ maxParties }}
                    {%- if parties|length > partiesEnCours %},
                        {{ parties|length - partiesEnCours }} close{{ parties|length - partiesEnCours > 1 ? 's' : '' }}
                    {%- endif %}
                </p>
            </div>

            {% if parties is empty %}
                <p class="mt-3 text-sm text-encre-600">
                    Aucune partie en cours. Le pharaon attend.
                </p>
            {% else %}
                <ul class="mt-4 space-y-3 list-none p-0">
                    {% for partie in parties %}
                        <li class="rounded-sm border border-ocre-500/30 bg-sable-50 p-5">
                            <div class="flex flex-wrap items-baseline justify-between gap-3">
                                <h3 class="font-display text-xl text-encre-900">
                                    {{ partie.ville.nom }}
                                </h3>
                                <span class="rounded-sm bg-lapis-500/10 px-2 py-0.5 text-xs text-lapis-600">
                                    {{ partie.mode.libelle }}
                                </span>
                            </div>

                            <p class="mt-1 text-sm text-encre-500">
                                {{ missionsParPartie[partie.id] ?? 'Succession des règnes' }}
                                · famille {{ partie.famille.nom }}
                            </p>

                            <dl class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm text-encre-600" data-chiffres>
                                <div class="flex gap-1.5">
                                    <dt class="text-encre-500">Cycle</dt>
                                    <dd>{{ partie.cycle }}</dd>
                                </div>
                                <div class="flex gap-1.5">
                                    <dt class="text-encre-500">Deben</dt>
                                    <dd>{{ partie.ville.deben }}</dd>
                                </div>
                                <div class="flex gap-1.5">
                                    <dt class="text-encre-500">Renommée</dt>
                                    <dd>{{ partie.famille.palierDeRenommee }}</dd>
                                </div>
                            </dl>

                            <div class="mt-4 flex flex-wrap items-center gap-4">
                                <a href="{{ path('app_partie_reprendre', {id: partie.id}) }}"
                                   class="rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 no-underline hover:bg-terre-600">
                                    Reprendre
                                </a>
                                <a href="{{ path('app_partie_abandonner', {id: partie.id}) }}"
                                   class="text-sm text-encre-500 hover:text-terre-600">
                                    Abandonner
                                </a>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            {% if plafondAtteint %}
                <p class="mt-4 rounded-sm border border-ocre-500/40 bg-ocre-300/15 px-4 py-3 text-sm text-encre-700">
                    Vous menez déjà {{ maxParties }} parties. Abandonnez-en une pour
                    en commencer une nouvelle.
                </p>
            {% else %}
                <a href="{{ path('app_partie_nouvelle') }}"
                   class="mt-5 inline-block rounded-sm bg-terre-500 px-5 py-2.5 font-medium text-sable-50 no-underline hover:bg-terre-600">
                    Commencer une partie
                </a>
            {% endif %}
        </section>
    </section>
{% endblock %}
