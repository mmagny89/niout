{# Les messages de la partie, flottant au-dessus du contenu : ce qu'une action
   vient de produire. Partagés par la coque du jeu et par les cadres de la
   fenêtre (qui les consomment eux-mêmes, la coque n'étant pas rendue pour une
   réponse de cadre). #}
    {% set typesDeFlash = { 'succes': 'good', 'erreur': 'bad' } %}
    <div class="pointer-events-none fixed inset-x-0 top-24 z-40 flex flex-col items-center gap-2 px-5">
        {% for type, style in typesDeFlash %}
            {% for message in app.flashes(type) %}
                <div role="{{ style == 'bad' ? 'alert' : 'status' }}" data-controller="flash"
                     class="pointer-events-auto flex w-full max-w-xl items-start gap-3 rounded-sm border-l-4 px-4 py-3 text-sm shadow-lg
                            {{ style == 'bad'
                                ? 'border-terre-500 bg-terre-50 text-terre-700'
                                : 'border-lapis-500 bg-sable-50 text-lapis-600' }}">
                    <span class="flex-1">{{ message }}</span>
                    <button type="button" data-action="flash#fermer"
                            class="shrink-0 rounded-sm px-2 text-lg leading-none text-encre-500 hover:text-terre-600"
                            aria-label="Fermer ce message">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
