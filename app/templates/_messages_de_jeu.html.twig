{# Les messages de la partie, flottant au-dessus du contenu : ce qu'une action
   vient de produire. Partagés par la coque du jeu et par les cadres de la
   fenêtre (qui les consomment eux-mêmes, la coque n'étant pas rendue pour une
   réponse de cadre). #}
    {% set typesDeFlash = { 'succes': 'good', 'erreur': 'bad' } %}
    <div class="pointer-events-none fixed inset-x-0 top-24 z-40 flex flex-col items-center gap-2 px-5">
        {# Le récapitulatif d'une quinzaine passe avant les messages : c'est ce qu'on veut lire en premier. #}
        {% for recap in app.flashes('quinzaine') %}
            {{ include('_recapitulatif_de_quinzaine.html.twig', {recap: recap}) }}
        {% endfor %}
        {% for type, style in typesDeFlash %}
            {% for message in app.flashes(type) %}
                {# Un message de deux phrases ou plus se lit en deux temps : la première en titre, la suite dessous.
                   Le texte reste entier (même ponctuation) : seul le gabarit le range. #}
                {% set morceaux = (message ~ '')|split('. ', 2) %}
                <div role="{{ style == 'bad' ? 'alert' : 'status' }}" data-controller="flash"
                     class="message-de-jeu pointer-events-auto flex w-full max-w-xl items-start gap-3 rounded-sm border-l-4 px-4 py-3 text-sm shadow-lg
                            {{ style == 'bad'
                                ? 'border-terre-500 bg-terre-50 text-terre-700'
                                : 'border-lapis-500 bg-sable-50 text-lapis-600' }}">
                    <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 size-5 shrink-0" aria-hidden="true" focusable="false">
                        {% if style == 'bad' %}
                            <path fill-rule="evenodd" d="M10 2.5a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15Zm-.9 4a.9.9 0 1 1 1.8 0v4a.9.9 0 1 1-1.8 0v-4Zm.9 7.9a1.1 1.1 0 1 1 0-2.2 1.1 1.1 0 0 1 0 2.2Z" clip-rule="evenodd"/>
                        {% else %}
                            <path fill-rule="evenodd" d="M10 2.5a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15Zm3.4 5.9a.9.9 0 0 0-1.3-1.2l-3 3.3-1.3-1.4a.9.9 0 1 0-1.3 1.2l2 2.1a.9.9 0 0 0 1.3 0l3.6-4Z" clip-rule="evenodd"/>
                        {% endif %}
                    </svg>
                    <span class="flex-1">
                        {% if morceaux|length > 1 %}
                            <strong class="block font-medium">{{ morceaux[0] }}.</strong>
                            {{ morceaux[1] }}
                        {% else %}
                            {{ message }}
                        {% endif %}
                    </span>
                    <button type="button" data-action="flash#fermer"
                            class="shrink-0 rounded-sm px-2 text-lg leading-none text-encre-500 hover:text-terre-600"
                            aria-label="Fermer ce message">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
