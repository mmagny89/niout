{% extends 'auth/_layout.html.twig' %}

{% block title %}Créer un compte — Niout{% endblock %}
{% block titre_page %}Créer un compte{% endblock %}

{% block intro %}
    <p class="mt-3 text-sm text-encre-600">
        Votre compte est utilisable immédiatement. Un message de vérification vous sera envoyé :
        sans validation sous {{ delaiVerification }} jours, le compte est supprimé.
    </p>
{% endblock %}

{% block formulaire %}
    {{ form_start(registrationForm) }}
        {{ form_errors(registrationForm) }}
        {{ form_row(registrationForm.email) }}
        {# Le champ et ses règles vivent sous le même contrôleur : c'est lui
           qui lit la frappe et coche ce qui est acquis. #}
        <div data-controller="force-du-mot-de-passe">
            {{ form_row(registrationForm.plainPassword.first, {attr: {
                'data-force-du-mot-de-passe-target': 'champ',
                'data-action': 'input->force-du-mot-de-passe#evaluer',
                'aria-describedby': 'regles-du-mot-de-passe',
            }}) }}
            <div id="regles-du-mot-de-passe">
                {{ include('_regles_de_mot_de_passe.html.twig') }}
            </div>
        </div>
        {{ form_row(registrationForm.plainPassword.second) }}

        <button type="submit"
                class="w-full rounded-sm bg-terre-500 px-4 py-2.5 font-medium text-sable-50 hover:bg-terre-600">
            Créer mon compte
        </button>
    {{ form_end(registrationForm) }}
{% endblock %}

{% block dessous %}
    <p class="mt-6 text-sm text-encre-600">
        Déjà inscrit ?
        <a href="{{ path('app_login') }}" class="text-lapis-500">Se connecter</a>
    </p>
{% endblock %}
