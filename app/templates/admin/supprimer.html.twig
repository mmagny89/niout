{% extends 'base.html.twig' %}

{% block title %}Supprimer {{ ligne.compte.email }} — administration Niout{% endblock %}

{% block body %}
    <section class="mx-auto w-full max-w-xl px-5 py-14">
        <h1 class="text-3xl text-encre-900">Supprimer ce compte ?</h1>

        <div class="mt-6 rounded-sm border border-ocre-500/30 bg-sable-50 p-5">
            <p class="font-display text-xl text-encre-900">{{ ligne.compte.email }}</p>
            <p class="mt-1 text-sm text-encre-500" data-chiffres>
                Inscrit le {{ ligne.compte.createdAt|date('d/m/Y') }}
                · {{ ligne.parties|length }} partie{{ ligne.parties|length > 1 ? 's' : '' }}
            </p>

            {# Ce qui va disparaître, nommément : un décompte seul ne dit pas
               si la partie qu'on s'apprête à détruire est un essai d'une
               quinzaine ou une campagne menée jusqu'à la dixième mission. #}
            {% if ligne.parties is not empty %}
                <ul class="mt-3 space-y-1 list-none p-0 text-sm text-encre-600">
                    {% for decrite in ligne.parties %}
                        <li data-chiffres>
                            {{ decrite.partie.ville.nom }} — {{ decrite.mission }}
                            · cycle {{ decrite.partie.cycle }}
                            · {{ decrite.partie.statut.libelle|lower }}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        <p class="mt-6 rounded-sm border-l-4 border-terre-500 bg-terre-500/10 px-4 py-3 text-sm text-terre-700">
            La suppression est <strong>définitive</strong>. Le compte, ses parties,
            leurs villes et leurs familles, et la lignée qui leur survivait
            disparaissent ensemble. Il n'y a pas d'archive à consulter ensuite,
            ni de retour en arrière.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-5">
            <form method="post" action="{{ path('app_admin_compte_supprimer', {id: ligne.compte.id}) }}">
                {# Jeton classique : « supprimer-compte » ne figure pas dans les
                   stateless_token_ids, il ne dépend donc d'aucun script. #}
                <input type="hidden" name="_token" value="{{ csrf_token('supprimer-compte') }}">
                <button type="submit"
                        class="rounded-sm bg-terre-600 px-5 py-2.5 font-medium text-sable-50 hover:bg-terre-700">
                    Oui, supprimer définitivement
                </button>
            </form>

            <a href="{{ path('app_admin_comptes') }}" class="text-sm text-encre-600 hover:text-terre-600">
                Revenir aux comptes
            </a>
        </div>
    </section>
{% endblock %}
