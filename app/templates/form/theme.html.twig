{% use 'tailwind_2_layout.html.twig' %}

{# Applique la palette du projet au thème Tailwind de Symfony, qui suppose
   par défaut les couleurs grises/indigo de la palette Tailwind d'origine. #}

{% block form_label %}
    {%- set label_attr = label_attr|merge({ class: (label_attr.class|default('') ~ ' block text-sm font-medium text-encre-700')|trim }) -%}
    {{- parent() -}}
{% endblock %}

{% block form_widget_simple %}
    {%- set attr = attr|merge({ class: (attr.class|default('') ~ ' mt-1 block w-full rounded-sm border border-ocre-500/40 bg-sable-50 px-3 py-2 text-encre-900 placeholder-encre-500 focus:border-lapis-500 focus:outline-none focus:ring-1 focus:ring-lapis-500')|trim }) -%}
    {{- parent() -}}
{% endblock %}

{% block form_errors %}
    {%- if errors|length > 0 -%}
        <ul class="mt-1 list-none space-y-1 p-0 text-sm text-terre-600">
            {%- for error in errors -%}
                <li>{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{% endblock %}

{% block form_row %}
    {%- set row_attr = row_attr|merge({ class: (row_attr.class|default('') ~ ' mb-5')|trim }) -%}
    {{- parent() -}}
{% endblock %}
