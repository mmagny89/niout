{# Les expéditions en route, dans la fenêtre : ce qui se lisait dans le
   deuxième onglet du panneau de droite de la carte. La pastille de la barre
   de jeu l'ouvre.

   **Chaque expédition est une piste** : la ville au départ, la case à l'arrivée, et un
   marcheur qui a fait la part du chemin que dit le pourcentage. La phrase et les chiffres
   disent la même chose en lettres ; le dessin est décoratif. #}
{% set icones = {eclaireur: 'expedition', emissaire: 'chef', chef_expedition: 'troupe', prospecteur: 'chantier'} %}
<turbo-frame id="fenetre" class="block h-full" data-forme="feuille">
    {{ include('_messages_de_jeu.html.twig') }}

    <div class="h-full overflow-y-auto p-5 pr-12 md:p-6 md:pr-12"
         data-controller="retour-en-haut" data-action="scroll->retour-en-haut#defiler">
        <div class="flex items-center gap-3">
            {{ include('partie/_pictogramme.html.twig', {nom: 'expedition', taille: 40}) }}
            <h2 id="fenetre-titre" class="font-display text-xl text-encre-900">Expéditions en route</h2>
            {% if ville.expeditions|length > 0 %}
                <span class="signal signal--neutre ml-auto" data-chiffres>{{ ville.expeditions|length }}</span>
            {% endif %}
        </div>

        {% if ville.expeditions|length > 0 %}
            <ul class="mt-4 space-y-3 list-none p-0">
                {% for expedition in ville.expeditions %}
                    {% set destination = expedition.destination %}
                    <li class="carte-vivante case-vivante rounded-sm border border-ocre-500/40 bg-ocre-300/10 px-4 py-3"
                        style="--i: {{ loop.index0 }}">
                        <div class="flex items-start gap-3">
                            {# La case visée, en miniature : ce qu'on sait d'elle, ou le brouillard qu'on y lève. #}
                            <a href="{{ path('app_partie_case', {id: partie.id, coordonnees: destination.x ~ '-' ~ destination.y}) }}"
                               data-turbo-frame="fenetre" class="shrink-0"
                               aria-label="Voir la case {{ destination.x }}, {{ destination.y }}">
                                <img src="{{ asset('images/tuiles/' ~ (destination.porteLaVille ? 'ville' : (destination.estDecouverte ? destination.terrain.tuile : 'brouillard')) ~ '.png') }}"
                                     alt="" class="w-16 select-none" width="188" height="116">
                            </a>
                            <div class="min-w-0 flex-1 text-sm">
                                <p class="flex items-center gap-2 text-encre-900">
                                    {{ include('partie/_pictogramme.html.twig', {nom: icones[expedition.role.value]|default('expedition'), taille: 22}) }}
                                    <span>
                                        {{ expedition.role.libelle }} vers la case
                                        <a href="{{ path('app_partie_case', {id: partie.id, coordonnees: destination.x ~ '-' ~ destination.y}) }}"
                                           data-turbo-frame="fenetre" class="text-lapis-500" data-chiffres>{{ destination.x }}, {{ destination.y }}</a>
                                    </span>
                                </p>
                                <p class="mt-0.5 text-encre-500" data-chiffres>
                                    encore {{ expedition.cyclesRestants }} cycle{{ expedition.cyclesRestants > 1 ? 's' : '' }}
                                    · {{ expedition.pourcentageDAvancement }} %
                                </p>
                            </div>
                        </div>

                        {# La piste : le marcheur arrive à sa part du chemin en marchant (`--part`). #}
                        <div class="piste mt-3" style="--part: {{ expedition.pourcentageDAvancement }}%; --part-nombre: {{ (expedition.pourcentageDAvancement / 100)|round(2) }}" aria-hidden="true">
                            <span class="piste__depart">{{ include('partie/_pictogramme.html.twig', {nom: 'habitants', taille: 18}) }}</span>
                            <span class="piste__ligne"><span class="piste__fait"></span></span>
                            <span class="piste__marcheur">{{ include('partie/_pictogramme.html.twig', {nom: 'expedition', taille: 22}) }}</span>
                            <span class="piste__arrivee">{{ include('partie/_pictogramme.html.twig', {nom: 'prestige', taille: 18}) }}</span>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <div class="mt-6 flex flex-col items-center gap-3 rounded-sm border border-dashed border-ocre-500/50 px-5 py-8 text-center">
                {{ include('partie/_pictogramme.html.twig', {nom: 'expedition', taille: 64, classe: 'opacity-70'}) }}
                <p class="text-sm text-encre-600">
                    Aucune expédition en route.
                </p>
                <p class="text-sm text-encre-500">
                    Envoyez un éclaireur depuis une case inexplorée, un émissaire vers une case
                    reconnue, ou des hommes déloger des brigands.
                </p>
                <a href="{{ path('app_partie_carte', {id: partie.id}) }}" data-turbo-frame="_top"
                   class="text-sm text-lapis-500 underline">Retour à la carte</a>
            </div>
        {% endif %}

        {{ include('fenetre/_retour_en_haut.html.twig') }}
    </div>
</turbo-frame>
