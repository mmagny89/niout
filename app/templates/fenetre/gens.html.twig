{# Les gens de la ville, en fenêtre : la liste de qui est où — **la voie équivalente**
   des silhouettes de la ville vue d'en haut, lisible sans image, au téléphone et au
   lecteur d'écran — et, sur `?cle=…`, la fiche de celui qu'on a cliqué.

   **Une feuille posée à droite** (`data-forme="feuille"`) : elle laisse la ville
   visible à côté, pour cliquer une silhouette après l'autre sans fermer. Sur
   téléphone, comme toute fenêtre, elle remplit la zone sous la barre.

   **Ce que ce panneau ne prétend pas** : le jeu ne suit pas chaque habitant, il
   compte des nombres (`Population`). Les maisons et les travailleurs sont donc dits
   *représentatifs* ; seuls les chefs, les Medjaÿ, le chef de famille et le rival sont
   de vraies personnes. #}
<turbo-frame id="fenetre" class="block h-full">
    <div data-forme="feuille" class="flex h-full min-h-0 flex-col overflow-y-auto p-4 pr-14 md:p-6 md:pr-14">
        <h2 id="fenetre-titre" class="font-display text-xl text-encre-900">Les gens de la ville</h2>
        <p class="mt-1 text-sm text-encre-600">
            Image reconstituée : le jeu ne suit pas chaque habitant, seulement ses chefs, ses Medjaÿ et son rival.
        </p>

        {{ include('partie/_frise_de_la_quinzaine.html.twig') }}

        {% if fiche %}
            <section class="mt-5 rounded-sm border border-ocre-500/30 bg-sable-50 p-4" aria-labelledby="fiche-titre">
                <p class="text-xs font-medium uppercase tracking-wide text-encre-500">{{ fiche.sousTitre }}</p>
                <h3 id="fiche-titre" class="mt-0.5 font-display text-lg text-encre-900">{{ fiche.titre }}</h3>

                {% if fiche.representatif %}
                    <p class="mt-2 rounded-sm bg-ocre-300/20 px-2.5 py-1.5 text-sm text-encre-700">
                        Représentatif : le jeu compte des habitants, pas des individus.
                    </p>
                {% endif %}

                <dl class="mt-3 space-y-2 text-sm" data-chiffres>
                    {% for ligne in fiche.lignes %}
                        <div class="flex flex-wrap gap-x-2">
                            <dt class="text-encre-500">{{ ligne.libelle }}</dt>
                            <dd class="text-encre-900">{{ ligne.valeur }}</dd>
                        </div>
                    {% endfor %}
                </dl>

                {% if fiche.lien %}
                    <p class="mt-4">
                        <a href="{{ path('app_partie_ville', {id: partie.id, onglet: fiche.lien.onglet}) }}"
                           class="inline-flex min-h-11 items-center rounded-sm border border-lapis-500/40 px-3 py-2 text-sm text-lapis-500
                                  hover:bg-lapis-500/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lapis-500">
                            {{ fiche.lien.libelle }}
                        </a>
                    </p>
                {% endif %}
            </section>

            {# Son journal : ce que la chorégraphie lui fait faire, jour après jour. #}
            {% if fiche.journal %}
                <section class="mt-5" aria-labelledby="journal-titre">
                    <h3 id="journal-titre" class="text-xs font-medium uppercase tracking-wide text-encre-500">Sa quinzaine passée, jour par jour</h3>
                    <p class="mt-1 text-sm text-encre-600">Reconstituée : le jeu ne suit pas ses journées.</p>
                    <ol class="mt-2 list-none space-y-1.5 p-0 text-sm" data-chiffres>
                        {% for ligne in fiche.journal %}
                            <li class="rounded-sm border px-3 py-1.5 {{ ligne.jour == jour ? 'border-terre-500 bg-ocre-300/30' : 'border-ocre-500/20' }}"
                                {{ ligne.jour == jour ? 'aria-current="true"' }}>
                                <span class="font-medium text-encre-900">Jour {{ ligne.jour }}</span>
                                {% if ligne.fait %}<span class="text-or-500" aria-label="jour marquant">★</span>{% endif %}
                                <span class="text-encre-700"> — {{ ligne.lignes|join(' ; ') }}</span>
                            </li>
                        {% endfor %}
                    </ol>
                </section>
            {% endif %}

            <p class="mt-4">
                <a href="{{ path('app_partie_gens', {id: partie.id, jour: jour, moment: jour ? moment : null}) }}"
                   class="inline-flex min-h-11 items-center text-sm text-lapis-500 underline-offset-2 hover:underline
                          focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lapis-500">
                    ← Tous les gens de la ville
                </a>
            </p>
        {% else %}
            <div class="mt-5 space-y-5">
                {% for lieu in lieux %}
                    <section aria-labelledby="lieu-{{ loop.index }}">
                        <h3 id="lieu-{{ loop.index }}" class="text-xs font-medium uppercase tracking-wide text-encre-500">{{ lieu.titre }}</h3>
                        <ul class="mt-1.5 list-none space-y-1.5 p-0">
                            {% for ligne in lieu.lignes %}
                                <li>
                                    {% if ligne.cle %}
                                        <a href="{{ path('app_partie_gens', {id: partie.id, cle: ligne.cle}) }}"
                                           class="flex min-h-11 items-center rounded-sm border border-ocre-500/30 bg-sable-50 px-3 py-2 text-sm text-encre-900
                                                  hover:border-terre-500/60 hover:bg-ocre-300/20
                                                  focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lapis-500">
                                            {{ ligne.texte }}
                                        </a>
                                    {% else %}
                                        <p class="flex min-h-11 items-center rounded-sm border border-ocre-500/20 px-3 py-2 text-sm text-encre-700">{{ ligne.texte }}</p>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% else %}
                    <p class="text-sm text-encre-600">La ville est calme : personne n'y travaille encore.</p>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</turbo-frame>
