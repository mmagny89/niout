{# Les routes commerciales que **ce** bâtiment arme (doc 08).

   Ce ne sont pas des cases sur la carte mais des débouchés, hors grille : le
   **type de route décide du bâtiment** — l'Entrepôt pour les pistes, le Port
   pour tout ce qui flotte —, et son niveau décide de ce qu'un convoi porte.
   Chaque panneau ne montre donc que les siennes.

   **Ouvertes d'abord, à ouvrir ensuite** : c'est sur une route ouverte qu'on
   agit chaque quinzaine — étals, convois en chemin —, tandis que celles qui
   restent à ouvrir sont un choix qu'on fait de temps en temps. Les voir
   mélangées noyait les premières sous les secondes. #}
{% set routesDIci = routes|filter(o => o.partenaire.route.batiment.value == onglet.type.value) %}
{% if routesDIci is not empty %}
    {% set ouvertes = routesDIci|filter(o => o.route and o.route.estOuverte) %}
    {% set enChemin = routesDIci|filter(o => o.route and not o.route.estOuverte) %}
    {% set aOuvrir = routesDIci|filter(o => not o.route) %}

    <h3 class="mt-8 text-xl text-encre-900">Routes commerciales</h3>
    {# Le décompte en trois pastilles : on voit d'un coup d'œil ce qui roule, ce qui marche, ce qui reste à faire. #}
    <ul class="mt-3 flex list-none flex-wrap gap-2 p-0 text-sm" data-chiffres>
        <li class="signal signal--bon">{{ ouvertes|length }} ouverte{{ ouvertes|length > 1 ? 's' : '' }}</li>
        <li class="signal signal--neutre">{{ enChemin|length }} en chemin</li>
        <li class="signal signal--neutre">{{ aOuvrir|length }} à ouvrir</li>
    </ul>

    <details class="mt-2 text-sm text-encre-500">
        <summary class="cursor-pointer text-encre-700">Comment ouvre-t-on une route ?</summary>
        <p class="mt-2">
            Ouvrir une route, c'est y envoyer une première caravane : elle
            déclare à la cité que vous êtes prêt à commercer, et la route
            n'existe qu'à son arrivée. Ensuite vous tenez un étal — « je vends
            du lin à 5 deben, j'achète du cèdre jusqu'à 19 » — et les convois
            partent d'eux-mêmes.
        </p>
    </details>

    {% macro carte(offre, partie, onglet, etals) %}
        {% set route = offre.route %}
        <li class="carte-vivante rounded-sm border p-4
                   {{ route or offre.realisable ? 'border-ocre-500/30 bg-sable-50' : 'border-ocre-500/20 bg-sable-50/40' }}">
            {# **La cité d'abord** : qui elle est, à quelle distance, ce qu'un convoi porte, ce qu'elle vend et achète.
               Chaque marchandise a son dessin ; la flèche dit le sens (↗ elle vend, on achète ; ↙ elle achète). #}
            <div class="flex flex-wrap items-start gap-3">
                <span class="grid size-12 shrink-0 place-items-center rounded-full border border-or-400/40 bg-or-300/20" aria-hidden="true">
                    {{ include('partie/_pictogramme.html.twig', {nom: 'expedition', taille: 30}) }}
                </span>
                <div class="min-w-0 flex-1 basis-60">
                    <h4 class="font-display text-xl leading-tight text-encre-900">{{ offre.partenaire.nom }}</h4>
                    <p class="mt-0.5 text-sm text-encre-500">{{ offre.partenaire.description }}</p>
                </div>
                {% if route and route.estOuverte %}
                    <span class="signal signal--bon">{{ offre.partenaire.route.libelle }} · ouverte</span>
                {% elseif route %}
                    <span class="signal signal--neutre">{{ offre.partenaire.route.libelle }} · en chemin</span>
                {% else %}
                    <span class="signal signal--neutre border-dashed">{{ offre.partenaire.route.libelle }} · à ouvrir</span>
                {% endif %}
            </div>

            <ul class="mt-3 flex list-none flex-wrap items-center gap-x-5 gap-y-2 p-0 text-sm text-encre-600" data-chiffres>
                <li class="inline-flex items-center gap-1.5">
                    {{ include('partie/_pictogramme.html.twig', {nom: 'quinzaine', taille: 20}) }}
                    {{ offre.partenaire.distanceEnQuinzaines }} quinzaines de trajet
                    {{ include('partie/batiments/_piste_de_route.html.twig', {total: offre.partenaire.distanceEnQuinzaines, parcouru: 0}) }}
                </li>
                <li class="inline-flex items-center gap-1.5">
                    {{ include('partie/_pictogramme.html.twig', {nom: 'echange', taille: 20}) }}
                    {{ offre.volume }} unités par convoi
                </li>
            </ul>

            <div class="mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
                {% for sens in [
                    {titre: 'Vend', fleche: '↗', liste: offre.partenaire.vend},
                    {titre: 'Achète', fleche: '↙', liste: offre.partenaire.achete},
                ] %}
                    <div class="flex flex-wrap items-center gap-1.5">
                        <span class="w-14 text-xs uppercase tracking-wide text-encre-500"><span aria-hidden="true">{{ sens.fleche }}</span> {{ sens.titre }}</span>
                        {% for ressource in sens.liste %}
                            <span class="inline-flex items-center gap-1 rounded-full border border-ocre-500/30 bg-sable-50 py-0.5 pl-1 pr-2 text-xs text-encre-700">
                                {{ include('partie/_icone_ressource.html.twig', {ressource: ressource, taille: 20}) }}{{ ressource.libelle }}
                            </span>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>

            {% if route %}
                {% if route.estOuverte %}
                    {# Ce qui est en chemin. Un convoi parti est un engagement pris : sa marchandise a déjà quitté les
                       réserves, ou ses deben la caisse. #}
                    {% set convoisEnChemin = route.convois|filter(c => not c.estRentre) %}
                    {% if convoisEnChemin|length > 0 %}
                        <ul class="mt-4 space-y-2 list-none p-0">
                            {% for convoi in convoisEnChemin %}
                                <li class="flex flex-wrap items-center gap-x-3 gap-y-1 rounded-sm border border-lapis-500/30 bg-lapis-500/5 px-3 py-2 text-sm text-encre-700" data-chiffres>
                                    {{ include('partie/_icone_ressource.html.twig', {ressource: convoi.ressource, taille: 28}) }}
                                    <span class="min-w-0 flex-1">
                                        {{ convoi.sens.value == 'vendre' ? 'Parti avec' : 'Ramène' }}
                                        {{ convoi.quantite }} {{ convoi.ressource.libelle }}
                                        à {{ convoi.prix }} deben —
                                        retour dans {{ convoi.quinzainesAvantRetour }}
                                        quinzaine{{ convoi.quinzainesAvantRetour > 1 ? 's' : '' }}.
                                    </span>
                                    {{ include('partie/batiments/_piste_de_route.html.twig', {
                                        total: 2 * offre.partenaire.distanceEnQuinzaines,
                                        parcouru: 2 * offre.partenaire.distanceEnQuinzaines - convoi.quinzainesAvantRetour,
                                    }) }}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    {# L'étal : le joueur affiche ses conditions et attend. Le prix décide de l'empressement du
                       partenaire, donc du volume qui bouge — et l'écran le montre **avant** qu'il ne s'engage.
                       Le prix se règle à la jauge, entre le plancher et le plafond de la cité : un champ numérique
                       doublerait la jauge, et laisserait taper un prix hors fourchette. #}
                    <ul class="mt-4 space-y-2 list-none p-0">
                        {% for ligne in etals[offre.partenaire.cle] ?? [] %}
                            <li class="rounded-sm border border-ocre-500/25 bg-sable-50 p-3">
                                <form method="post" action="{{ path('app_partie_etal', {id: partie.id}) }}"
                                      class="flex flex-wrap items-center gap-x-4 gap-y-2"
                                      {% if not ligne.ordre and partie.estEnCours %}data-controller="curseur" data-curseur-seuil-value="{{ ligne.plafond }}"{% endif %}>
                                    <input type="hidden" name="_token" value="{{ csrf_token('etal') }}">
                                    <input type="hidden" name="onglet" value="{{ onglet.cle }}">
                                    <input type="hidden" name="partenaire" value="{{ offre.partenaire.cle }}">
                                    <input type="hidden" name="ressource" value="{{ ligne.ressource.value }}">
                                    <input type="hidden" name="sens" value="{{ ligne.sens.value }}">

                                    <span class="flex min-w-40 items-center gap-2">
                                        {{ include('partie/_icone_ressource.html.twig', {ressource: ligne.ressource, taille: 36}) }}
                                        <span>
                                            <span class="inline-block rounded-full border px-2 text-xs {{ ligne.sens.value == 'vendre' ? 'border-lapis-500/40 text-lapis-600' : 'border-terre-500/40 text-terre-600' }}">{{ ligne.sens.libelle }}</span>
                                            <span class="block text-sm text-encre-900">{{ ligne.ressource.libelle|capitalize }}</span>
                                        </span>
                                    </span>

                                    {% if ligne.ordre %}
                                        {# Un ordre posé : son prix, son volume, et l'empressement qu'il suscite en jauge. #}
                                        <span class="min-w-0 flex-1 text-sm text-encre-900" data-chiffres>
                                            posé à {{ ligne.ordre.prix }} deben,
                                            {{ ligne.ordre.quantiteParConvoi }} par convoi
                                            <span class="mt-1 flex items-center gap-2 text-xs {{ ligne.empressement < 40 ? 'text-terre-600' : 'text-encre-500' }}">
                                                <span class="block h-1.5 w-24 overflow-hidden rounded-full bg-ocre-500/20" aria-hidden="true">
                                                    <span class="block h-full rounded-full {{ ligne.empressement < 40 ? 'bg-terre-500' : 'bg-lapis-500' }}" style="width: {{ ligne.empressement }}%"></span>
                                                </span>
                                                {{ ligne.empressement }} % d'empressement
                                            </span>
                                        </span>
                                        <button type="submit" name="retirer" value="1"
                                                class="ml-auto text-sm text-encre-500 underline hover:text-terre-600">
                                            Retirer
                                        </button>
                                    {% elseif partie.estEnCours %}
                                        <input type="hidden" id="prix-{{ offre.partenaire.cle }}-{{ ligne.ressource.value }}" name="prix"
                                               value="{{ ligne.plancher }}" min="{{ ligne.plancher }}" max="{{ ligne.plafond }}"
                                               data-curseur-target="champ">
                                        <span class="min-w-48 flex-1">
                                            <label for="prix-curseur-{{ offre.partenaire.cle }}-{{ ligne.ressource.value }}" class="flex items-baseline justify-between text-sm text-encre-600">
                                                <span class="text-xs text-encre-500" data-chiffres>{{ ligne.plancher }} – {{ ligne.plafond }} deben</span>
                                                <span><strong class="font-display text-xl font-normal text-encre-900" data-curseur-target="nombre" data-chiffres>{{ ligne.plancher }}</strong> deben</span>
                                            </label>
                                            <input type="range" id="prix-curseur-{{ offre.partenaire.cle }}-{{ ligne.ressource.value }}"
                                                   data-curseur-target="piste" data-action="input->curseur#deplacer" class="curseur w-full">
                                        </span>
                                        <label class="flex items-center gap-1.5 text-xs text-encre-500" for="qte-{{ offre.partenaire.cle }}-{{ ligne.ressource.value }}">
                                            × <input type="number" id="qte-{{ offre.partenaire.cle }}-{{ ligne.ressource.value }}"
                                                   name="quantite" value="{{ offre.volume }}" min="1"
                                                   class="w-16 rounded-sm border border-ocre-500/40 bg-sable-50 px-2 py-1 text-sm text-encre-900"
                                                   data-chiffres aria-label="Quantité par convoi">
                                            par convoi
                                        </label>
                                        <button type="submit"
                                                class="rounded-sm border border-lapis-500/50 px-3 py-1 text-sm text-lapis-600 hover:bg-lapis-500/10">
                                            Annoncer
                                        </button>
                                    {% endif %}
                                </form>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-sm border border-ocre-500/30 bg-ocre-500/5 px-3 py-2 text-sm text-encre-600" data-chiffres>
                        <span>
                            Convoi en chemin : encore
                            {{ route.quinzainesAvantOuverture }}
                            quinzaine{{ route.quinzainesAvantOuverture > 1 ? 's' : '' }}.
                        </span>
                        {{ include('partie/batiments/_piste_de_route.html.twig', {
                            total: offre.partenaire.distanceEnQuinzaines,
                            parcouru: offre.partenaire.distanceEnQuinzaines - route.quinzainesAvantOuverture,
                        }) }}
                    </p>
                {% endif %}
            {% elseif offre.empechement %}
                <p class="mt-4 text-sm text-terre-600">{{ offre.empechement }}</p>
            {% elseif partie.estEnCours %}
                <form method="post" action="{{ path('app_partie_commercer', {id: partie.id}) }}"
                      class="mt-4 flex flex-wrap items-center gap-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('commercer') }}">
                    <input type="hidden" name="onglet" value="{{ onglet.cle }}">
                    <input type="hidden" name="partenaire" value="{{ offre.partenaire.cle }}">
                    <span class="inline-flex items-center gap-1.5 text-sm text-encre-600" data-chiffres>
                        {{ include('partie/_pictogramme.html.twig', {nom: 'deben', taille: 22}) }}
                        {{ offre.cout }} deben
                    </span>
                    {# Le rabais du doc 12 : une route déjà armée dans une partie précédente s'ouvre moins cher. Dit ici,
                       à l'engagement, plutôt que découvert au débit. #}
                    {% if offre.heritee %}
                        <span class="text-sm text-ocre-700">— vous connaissez déjà ce chemin</span>
                    {% endif %}
                    <button type="submit"
                            class="bouton-offrande group ml-auto inline-flex items-center gap-2 rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                        {{ include('partie/_pictogramme.html.twig', {nom: 'expedition', taille: 22, classe: 'bouton-offrande__image'}) }}
                        Envoyer une première {{ offre.partenaire.route.convoi }}
                    </button>
                </form>
            {% endif %}
        </li>
    {% endmacro %}

    {% for groupe in [
        {titre: 'Routes ouvertes', liste: ouvertes},
        {titre: 'Convois en chemin', liste: enChemin},
        {titre: 'Routes à ouvrir', liste: aOuvrir},
    ] %}
        {% if groupe.liste is not empty %}
            <h4 class="mt-6 text-sm font-medium uppercase tracking-wide text-encre-500">{{ groupe.titre }}</h4>
            <ul class="mt-2 space-y-3 list-none p-0">
                {% for offre in groupe.liste %}
                    {{ _self.carte(offre, partie, onglet, etals) }}
                {% endfor %}
            </ul>
        {% endif %}
    {% endfor %}
{% endif %}
