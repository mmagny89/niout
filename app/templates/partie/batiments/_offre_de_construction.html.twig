{# Le coût et le geste d'une offre de construction : le même bloc pour
   « Construire » (À bâtir) et « Améliorer » (Bâtiments dressés), pour que les
   deux ne divergent pas. Attend `offre`, `partie`, `ville` et `onglet`. #}
    {% if offre.cout %}
        {# Le coût en pastilles, chaque ressource avec son illustration : ce qu'il faut réunir se
           reconnaît avant d'être lu. Le texte dit les mêmes chiffres (`aria-label`). #}
        <ul class="mt-3 flex list-none flex-wrap gap-1.5 p-0 text-sm" data-chiffres aria-label="Ce que coûte le chantier">
            {% for ressource in offre.cout.ressources %}
                <li class="inline-flex items-center gap-1 rounded-full bg-ocre-500/10 py-0.5 pl-1 pr-2.5">
                    {{ include('partie/_icone_ressource.html.twig', {ressource: ressource, taille: 24}) }}
                    <span class="text-encre-900">{{ offre.cout.quantiteDe(ressource) }}</span>
                    <span class="text-encre-500">{{ ressource.libelle }}</span>
                </li>
            {% endfor %}
            <li class="inline-flex items-center gap-1 rounded-full bg-lapis-500/10 py-0.5 pl-1 pr-2.5"
                data-infobulle="Le chantier avance d'un cycle à chaque quinzaine que vous déclenchez.">
                {{ include('partie/_pictogramme.html.twig', {nom: 'quinzaine', taille: 22}) }}
                <span class="text-encre-900">{{ offre.type.dureeDeBase + (offre.existant ? offre.existant.niveau + 1 : 1) }}</span>
                <span class="text-encre-500">cycles</span>
            </li>
        </ul>
    {% endif %}

    {% if not partie.estEnCours %}
        {# La partie a échoué : plus aucun chantier ne s'engage. #}
    {% elseif offre.empechement %}
        <p class="signal signal--mauvais mt-3 !inline-flex !whitespace-normal">{{ include('partie/_pictogramme.html.twig', {nom: 'danger', taille: 20}) }} {{ offre.empechement }}</p>
    {% elseif ville.aUnChantierPour(offre.type) %}
        <p class="signal signal--neutre mt-3 inline-flex">{{ include('partie/_pictogramme.html.twig', {nom: 'chantier', taille: 20}) }} Travaux déjà en cours</p>
    {% else %}
        <form method="post" action="{{ path('app_partie_batir', {id: partie.id}) }}" class="mt-4">
            <input type="hidden" name="_token" value="{{ csrf_token('batir') }}">
            <input type="hidden" name="onglet" value="{{ onglet.cle }}">
            <input type="hidden" name="type" value="{{ offre.type.value }}">
            <button type="submit"
                    class="bouton-offrande group inline-flex items-center gap-2 rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                {{ include('partie/_pictogramme.html.twig', {nom: offre.estDejaDressé ? 'amelioration' : 'chantier', taille: 22, classe: 'bouton-offrande__image'}) }}
                {{ offre.libelleDeLAction }}
            </button>
        </form>
    {% endif %}
