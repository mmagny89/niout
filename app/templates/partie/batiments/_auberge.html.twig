{# L'Auberge : voyageurs de passage, rumeurs, devinettes. **Un onglet, un
   bâtiment** — les énigmes qu'on y entend s'y posent, et pas chez les
   scribes.

   Même construction que tous les panneaux de bâtiment : des sous-onglets, dont
   le premier est celui qu'on vient ouvrir. Une page courte n'en est pas
   dispensée — **toutes se construisent de la même manière**, pour que le joueur
   apprenne une fois où chercher. #}
{{ include('partie/batiments/_entete.html.twig') }}

{% import 'partie/_sous_onglets.html.twig' as sous %}
{% set direction = directions[onglet.type.value] ?? null %}
{% set sections = [
    {cle: 'table', libelle: 'À la table'},
    {cle: 'salle', libelle: 'La salle'},
] %}
{% if direction %}
    {% set sections = sections|merge([{cle: 'direction', libelle: direction.chefs is empty ? 'Direction · vacante' : 'Direction'}]) %}
{% endif %}
{{ sous.debut('auberge', partie.id, "Sections de l'Auberge", sections) }}
{{ sous.panneau('auberge', 'table', true) }}
{{ include('partie/_enigmes.html.twig', {enigmes: enigmesDeLAuberge, titre: 'Ce qu\'on se demande à la table'}) }}
{% if enigmesDeLAuberge is empty %}
    <p class="mt-6 text-sm text-encre-500">
        La salle est calme ce soir : on a déjà répondu à tout ce qui s'y demandait.
    </p>
{% endif %}
    </div>

{{ sous.panneau('auberge', 'salle', false) }}
{# La salle, un soir : la braise rougeoie et la fumée monte. Décoratif, éteint si l'on a demandé moins de mouvement.
   **Une seule carte** : le texte qui la suivait en paragraphe vit maintenant dedans, avec ce qu'on y fait en pastilles. #}
<div class="salle mt-6 overflow-hidden rounded-sm border border-terre-500/30 px-5 py-5">
    <div class="flex items-center gap-4">
        <span class="salle__braise inline-flex">{{ include('partie/_pictogramme.html.twig', {nom: 'offrande', taille: 72}) }}</span>
        <div class="min-w-0">
            <p class="font-display text-2xl text-terre-700">La salle de l'Auberge</p>
            <p class="text-sm text-encre-600">Un feu, de la bière, et des histoires de passage.</p>
        </div>
    </div>
    <ul class="mt-4 flex list-none flex-wrap gap-2 p-0 text-xs text-encre-700">
        <li class="rounded-full border border-terre-500/30 bg-sable-50/70 px-3 py-1">Bateliers</li>
        <li class="rounded-full border border-terre-500/30 bg-sable-50/70 px-3 py-1">Porteurs de nouvelles</li>
        <li class="rounded-full border border-terre-500/30 bg-sable-50/70 px-3 py-1">Marchands en chemin</li>
    </ul>
    <p class="mt-3 max-w-3xl text-sm text-encre-600">
        On y boit, on y parle, et l'on s'y pose des devinettes. Rien de ce qui s'y dit
        n'engage la ville — mais on y apprend des choses.
    </p>
</div>
    </div>

{% if direction %}
{{ sous.panneau('auberge', 'direction', false) }}
{{ include('partie/batiments/_direction.html.twig') }}
    </div>
{% endif %}
</div>
