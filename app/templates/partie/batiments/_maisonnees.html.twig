{# Les habitants, rangés en maisonnées : un coup d'œil dit combien on est, qui
   travaille, qui est à charge, et combien de maisons restent vides.

   **C'est une représentation, pas un état** (`Maisonnees`) : le jeu ne tient
   que trois nombres, la répartition en maisons est déterministe. Les âges se
   lisent par la **forme** — grand, petit, canne — et l'activité par la
   **couleur** : jamais la couleur seule, pour qu'on lise aussi l'écran sans la
   distinguer. Chaque maison porte sa description écrite ; le dessin lui-même
   est masqué aux lecteurs d'écran.

   Les symboles sont définis une fois et réutilisés par `<use>` : une ville de
   cent soixante maisons ne répète pas cent soixante fois leurs tracés. #}
<svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
    <defs>
        {# Les personnages : tête, buste, pagne ou robe qui s'évase. La taille dit l'âge, le dos voûté
           et la canne l'ancien ; une croix claire marque l'alité. #}
        <symbol id="gens-adulte" viewBox="0 0 12 22">
            <circle cx="6" cy="4" r="2.7"/>
            <path d="M2.8 8.6 Q6 7.4 9.2 8.6 L10.4 21.5 H1.6 Z"/>
        </symbol>
        <symbol id="gens-enfant" viewBox="0 0 12 22">
            <circle cx="6" cy="11" r="2.4"/>
            <path d="M3.6 14.6 Q6 13.8 8.4 14.6 L9.2 21.5 H2.8 Z"/>
        </symbol>
        <symbol id="gens-ancien" viewBox="0 0 14 22">
            <circle cx="5" cy="5.6" r="2.5"/>
            <path d="M2 9.6 Q4.8 8.4 7.6 9.8 L8.6 21.5 H1.2 Z"/>
            <path d="M11.6 11 V21.5 M10.2 11 H11.6" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </symbol>
        <symbol id="gens-malade" viewBox="0 0 12 22">
            <circle cx="6" cy="4" r="2.7"/>
            <path d="M2.8 8.6 Q6 7.4 9.2 8.6 L10.4 21.5 H1.6 Z"/>
            <path d="M4.2 15 H7.8 M6 13.2 V16.8" fill="none" stroke="#fbf6ec" stroke-width="1.5" stroke-linecap="round"/>
        </symbol>
        {# La maison de briques crues : toit-terrasse débordant, façade qui s'évase, assises de briques,
           porte cintrée et deux petites ouvertures. Les habitants se tiennent dans l'embrasure. #}
        <symbol id="maison-egyptienne" viewBox="0 0 88 70">
            <rect x="14" y="2" width="16" height="5" rx="1" class="maison__acrotere"/>
            <rect x="2" y="6" width="84" height="8" rx="1.5" class="maison__toit"/>
            <path d="M8 14 H80 L83 69 H5 Z" class="maison__facade"/>
            <path d="M7 27 H81 M6 40 H82 M6 53 H82" class="maison__briques"/>
            <path d="M32 69 V42 a12 12 0 0 1 24 0 V69 Z" class="maison__porte"/>
            <rect x="12" y="22" width="9" height="9" rx="1" class="maison__ouverture"/>
            <rect x="67" y="22" width="9" height="9" rx="1" class="maison__ouverture"/>
        </symbol>
    </defs>
</svg>

<ul class="mt-4 grid list-none grid-cols-[repeat(auto-fill,minmax(5.75rem,1fr))] gap-3 p-0" data-chiffres>
    {% for habitants in maisons %}
        {# Chaque maison apparaît à son tour, et se soulève au survol avec sa description
           en infobulle. Les habitants se balancent à peine, chacun à son rythme. #}
        <li class="case-vivante maison relative" style="--i: {{ loop.index0 }}"
            data-infobulle="Maisonnée {{ loop.index }} : {{ descriptions[loop.index0] }}">
            <svg viewBox="0 0 88 70" class="maison__dessin block w-full" aria-hidden="true" focusable="false"><use href="#maison-egyptienne"/></svg>
            <div class="absolute inset-x-2 bottom-1 flex items-end justify-center gap-0.5"
                 role="img" aria-label="Maisonnée {{ loop.index }} : {{ descriptions[loop.index0] }}">
                {% for habitant in habitants %}
                    {% if habitant == 'actif' %}
                        <svg viewBox="0 0 12 22" class="habitant h-8 w-3.5 fill-lapis-500 drop-shadow-sm" style="--r: {{ (loop.index0 * 3 + loop.parent.loop.index0) % 7 }}" aria-hidden="true" focusable="false"><use href="#gens-adulte"/></svg>
                    {% elseif habitant == 'malade' %}
                        <svg viewBox="0 0 12 22" class="habitant habitant--malade h-8 w-3.5 fill-terre-500 drop-shadow-sm" aria-hidden="true" focusable="false"><use href="#gens-malade"/></svg>
                    {% elseif habitant == 'enfant' %}
                        <svg viewBox="0 0 12 22" class="habitant h-8 w-3.5 fill-or-500 drop-shadow-sm" style="--r: {{ (loop.index0 * 2 + loop.parent.loop.index0) % 7 }}" aria-hidden="true" focusable="false"><use href="#gens-enfant"/></svg>
                    {% else %}
                        <svg viewBox="0 0 14 22" class="h-8 w-4 fill-encre-500 text-encre-500 drop-shadow-sm" aria-hidden="true" focusable="false"><use href="#gens-ancien"/></svg>
                    {% endif %}
                {% endfor %}
            </div>
        </li>
    {% endfor %}
    {% if libres > 0 %}
        {% for vide in 1..libres %}
            <li class="maison-libre" role="img" aria-label="Maison libre">
                <svg viewBox="0 0 88 70" class="block w-full" aria-hidden="true" focusable="false"><use href="#maison-egyptienne"/></svg>
            </li>
        {% endfor %}
    {% endif %}
</ul>

<ul class="mt-3 flex list-none flex-wrap gap-x-5 gap-y-1 p-0 text-xs text-encre-600" aria-label="Légende">
    <li class="flex items-center gap-1.5"><svg viewBox="0 0 12 22" class="h-5 w-2.5 fill-lapis-500" aria-hidden="true"><use href="#gens-adulte"/></svg> Adulte qui travaille</li>
    <li class="flex items-center gap-1.5"><svg viewBox="0 0 12 22" class="h-5 w-2.5 fill-or-500" aria-hidden="true"><use href="#gens-enfant"/></svg> Enfant, à charge</li>
    <li class="flex items-center gap-1.5"><svg viewBox="0 0 14 22" class="h-5 w-3 fill-encre-500 text-encre-500" aria-hidden="true"><use href="#gens-ancien"/></svg> Ancien, à charge</li>
    <li class="flex items-center gap-1.5"><svg viewBox="0 0 12 22" class="h-5 w-2.5 fill-terre-500" aria-hidden="true"><use href="#gens-malade"/></svg> Alité par la fièvre</li>
    <li class="flex items-center gap-1.5"><svg viewBox="0 0 88 70" class="maison-libre h-4 w-5" aria-hidden="true"><use href="#maison-egyptienne"/></svg> Maison libre</li>
</ul>
