{# La Caserne lève et tient la troupe (doc 03, doc 01, lot 10.2).

   **Ce qui empêche de lever un homme se dit avant la tentative**, jamais par
   un refus : le niveau requis, l'effectif plein, la bourse courte. C'est la
   même discipline que le débouché du Marché ou le coût d'une route.

   L'escorte des caravanes et le combat lui-même viennent aux lots suivants ;
   ce panneau ne promet donc que ce qui existe. #}
{{ include('partie/batiments/_entete.html.twig') }}
{% import 'partie/_sous_onglets.html.twig' as sous %}
{% set direction = directions[onglet.type.value] ?? null %}
{% set sections = [
    {cle: 'troupe', libelle: 'Troupe'},
    {cle: 'recruter', libelle: 'Recruter'},
] %}
{% if direction %}
    {% set sections = sections|merge([{cle: 'direction', libelle: direction.chefs is empty ? 'Direction · vacante' : 'Direction'}]) %}
{% endif %}
{{ sous.debut('caserne', partie.id, "Sections de la Caserne", sections) }}
{{ sous.panneau('caserne', 'troupe', true) }}

<h3 class="mt-8 text-xl text-encre-900">Votre troupe</h3>

<p class="mt-2 max-w-4xl text-sm text-encre-500" data-chiffres>
    {{ medjays|length }} / {{ effectifMaximum }} hommes ·
    {{ entretienDesMedjays }} deben par quinzaine.
</p>

{# La troupe en cases : un homme levé, une case pleine ; une place libre, une
   case en pointillés. Un blessé est signalé par une case terre cuite. Le
   dessin est masqué aux lecteurs d'écran, le texte dessus dit la même chose. #}
<div class="mt-3 flex flex-wrap gap-1.5" aria-hidden="true">
    {% for rang in 1..max(effectifMaximum, 1) %}
        {% set medjay = medjays[rang - 1] ?? null %}
        {# Un écu par homme : levé, il est plein ; blessé, il vire à la terre
           cuite et s'éteint ; une place libre n'est qu'un écu fantôme. Les
           écus apparaissent l'un après l'autre (`--i`). #}
        <span class="case-vivante" style="--i: {{ rang }}"
              data-infobulle="{{ medjay ? medjay.specialisation.libelle ~ ', force ' ~ medjay.force ~ (medjay.estDisponible(partie.cycle) ? '' : ' — blessé') : 'Place libre' }}">
            {% if medjay and medjay.estDisponible(partie.cycle) %}
                {{ include('partie/_pictogramme.html.twig', {nom: 'troupe', taille: 34}) }}
            {% elseif medjay %}
                {{ include('partie/_pictogramme.html.twig', {nom: 'troupe', taille: 34, classe: 'sepia saturate-150 hue-rotate-[-20deg] opacity-60'}) }}
            {% else %}
                {{ include('partie/_pictogramme.html.twig', {nom: 'troupe', taille: 34, classe: 'opacity-20 grayscale'}) }}
            {% endif %}
        </span>
    {% endfor %}
</div>

{% if medjays is not empty %}
    <ul class="mt-4 grid list-none grid-cols-1 gap-2 p-0 md:grid-cols-2 2xl:grid-cols-3">
        {% for medjay in medjays %}
            <li class="carte-vivante flex items-start gap-3 rounded-sm border border-ocre-500/30 bg-sable-50 px-4 py-3">
                {{ include('partie/_pictogramme.html.twig', {nom: 'troupe', taille: 36, classe: 'mt-0.5 ' ~ (medjay.estDisponible(partie.cycle) ? '' : 'sepia opacity-60')}) }}
                <div>
                <span class="text-encre-900">{{ medjay.specialisation.libelle }}</span>
                <span class="text-sm text-encre-500" data-chiffres>
                    · force {{ medjay.force }}
                    {%- if medjay.experience > 0 %} (dont {{ medjay.experience }} % d'expérience){% endif %}
                </span>
                {% if not medjay.estDisponible(partie.cycle) %}
                    <span class="text-sm text-terre-600">
                        — blessé, de retour à la quinzaine {{ medjay.retabliAuCycle }}
                    </span>
                {% endif %}
                <p class="mt-1 text-sm text-encre-600">{{ medjay.specialisation.particularite }}</p>
                </div>
            </li>
        {% endfor %}
    </ul>
{% else %}
    <p class="mt-4 max-w-4xl text-sm text-encre-600">
        Aucun homme n'est encore levé. Une case tenue par des brigands restera
        hors d'atteinte tant qu'il en sera ainsi.
    </p>
{% endif %}
    </div>

{{ sous.panneau('caserne', 'recruter', false) }}
<h3 class="mt-8 text-xl text-encre-900">Lever un homme</h3>

<ul class="mt-3 grid list-none grid-cols-1 gap-3 p-0 md:grid-cols-2">
    {% for ligne in offreDeLaCaserne %}
        <li class="carte-vivante flex flex-col rounded-sm border p-4
                   {{ ligne.ouverte ? 'border-ocre-500/30 bg-sable-50' : 'border-ocre-500/20 bg-sable-50/40' }}">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
                <h4 class="flex items-center gap-2 font-display text-lg text-encre-900">
                    {{ include('partie/_pictogramme.html.twig', {nom: 'troupe', taille: 30, classe: ligne.ouverte ? '' : 'opacity-40 grayscale'}) }}
                    {{ ligne.specialisation.libelle }}
                </h4>
                <span class="text-sm text-encre-500" data-chiffres>
                    {{ ligne.specialisation.coutDeRecrutement }} deben ·
                    {{ ligne.specialisation.entretienParQuinzaine }} par quinzaine ·
                    force {{ ligne.specialisation.force }}
                </span>
            </div>

            <p class="mt-2 text-sm text-encre-600">{{ ligne.specialisation.particularite }}</p>

            {% if ligne.ouverte and partie.estEnCours %}
                <form method="post" action="{{ path('app_partie_lever_medjay', {id: partie.id}) }}" class="mt-auto pt-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('lever-medjay') }}">
                    <input type="hidden" name="onglet" value="{{ onglet.cle }}">
                    <input type="hidden" name="specialisation" value="{{ ligne.specialisation.value }}">
                    <button type="submit"
                            class="rounded-sm border border-ocre-500/40 px-4 py-1.5 text-sm font-medium text-encre-700
                                   transition hover:-translate-y-px hover:border-ocre-500 hover:bg-ocre-300/25 active:translate-y-0">
                        Lever
                    </button>
                </form>
            {% elseif ligne.empechement %}
                <p class="mt-3 text-sm text-terre-600">{{ ligne.empechement }}</p>
            {% endif %}
        </li>
    {% endfor %}
</ul>
    </div>

{% if direction %}
{{ sous.panneau('caserne', 'direction', false) }}
{{ include('partie/batiments/_direction.html.twig') }}
    </div>

{% endif %}
</div>
