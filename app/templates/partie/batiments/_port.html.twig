{# Le Port arme tout ce qui flotte : les routes fluviales et maritimes, et les
   barques de pêche. **Le poisson est la seule ressource renouvelable du jeu**
   — un banc ne s'épuise jamais —, et il ne se pêche que d'ici : c'est ce qui
   donne au bâtiment sa raison d'être. Les filets se jettent depuis la carte,
   case par case. #}
{{ include('partie/batiments/_entete.html.twig') }}
{% import 'partie/_sous_onglets.html.twig' as sous %}
{% set direction = directions[onglet.type.value] ?? null %}
{% set sections = [
    {cle: 'peche', libelle: 'Pêcheries'},
    {cle: 'routes', libelle: 'Routes'},
] %}
{% if direction %}
    {% set sections = sections|merge([{cle: 'direction', libelle: direction.chefs is empty ? 'Direction · vacante' : 'Direction'}]) %}
{% endif %}
{{ sous.debut('port', partie.id, "Sections du Port", sections) }}
{{ sous.panneau('port', 'peche', true) }}

{# Le fleuve en bandeau : des vagues qui glissent, décoratives et éteintes si l'on a
   demandé moins de mouvement. Le texte dessous dit tout ce qu'il y a à savoir. #}
<div class="vagues mt-6 flex items-center gap-4 overflow-hidden rounded-sm border border-lapis-500/30 px-5 py-4"
     data-infobulle="Le poisson est la seule ressource renouvelable : un banc se reconstitue d'une quinzaine à l'autre.">
    {{ include('partie/_icone_ressource.html.twig', {ressource: 'poisson', taille: 64}) }}
    <div>
        <p class="font-display text-xl text-lapis-600">Les eaux poissonneuses</p>
        <p class="text-sm text-encre-600">Une pêcherie ne s'épuise jamais.</p>
    </div>
</div>

<p class="mt-6 max-w-4xl text-sm text-encre-500">
    Le niveau du Port élargit l'équipe d'une pêcherie et ce qu'elle rend.
    <strong class="text-encre-700">Le poisson ne s'épuise jamais</strong> : un
    banc se reconstitue d'une quinzaine à l'autre.
</p>

{{ include('partie/batiments/_exploitations.html.twig', {titreDuRecap: 'Vos pêcheries', recapVide: 'Aucun banc reconnu. Les eaux poissonneuses se repèrent en explorant.'}) }}
    </div>

{{ sous.panneau('port', 'routes', false) }}
{{ include('partie/batiments/_routes.html.twig') }}
    </div>

{% if direction %}
{{ sous.panneau('port', 'direction', false) }}
{{ include('partie/batiments/_direction.html.twig') }}
    </div>

{% endif %}
</div>
