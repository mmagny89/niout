{# La direction d'**un** bâtiment : qui le tient, quels postes restent, quelle
   annonce est affichée.

   Elle vit désormais dans le panneau du bâtiment concerné, et non dans un
   onglet « Direction » commun : c'est au moment où l'on regarde sa Forge qu'on
   veut savoir qui la dirige, pas au bout d'une liste de douze.

   Le doc 03 veut la compétence « chiffrée en interne, qualitative à
   l'affichage » : ce gabarit n'imprime donc que des étoiles, jamais
   `competence`. #}
{% set direction = directions[onglet.type.value] ?? null %}
{% if direction %}
    <div class="mt-6 rounded-sm border border-ocre-500/30 bg-sable-50 p-5">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h3 class="font-display text-lg text-encre-900">Direction</h3>
            <span class="text-xs uppercase tracking-wide text-encre-500" data-chiffres>
                {{ direction.chefs|length }} / {{ direction.batiment.nombreDeChefs }} chef{{ direction.batiment.nombreDeChefs > 1 ? 's' : '' }}
            </span>
        </div>

        {# **Un chef qui arrive ouvre des postes** : le joueur doit savoir, avant
           de retenir un candidat, combien de bras ce bâtiment va réclamer et
           s'il les a. Sans cela, embaucher faisait baisser le rendement
           ailleurs sans que rien ne le dise. #}
        {% set effectif = effectifs[onglet.type.value] ?? null %}
        {% if effectif and effectif.requis > 0 %}
            <p class="mt-2 text-sm {{ effectif.affectes < effectif.requis ? 'text-terre-600' : 'text-encre-500' }}" data-chiffres>
                Ce bâtiment réclame {{ effectif.requis }} travailleur{{ effectif.requis > 1 ? 's' : '' }}
                et en a {{ effectif.affectes }}.
                {% if effectif.affectes < effectif.requis %}
                    Il tourne à {{ effectif.rendement }} % faute de bras.
                {% endif %}
            </p>
        {% elseif direction.postesLibres > 0 %}
            <p class="mt-2 text-sm text-encre-500" data-chiffres>
                Sans chef, ce bâtiment ne réclame personne et tourne au plancher.
                Un chef y ouvrirait {{ direction.batiment.type.travailleursDeBase }} poste{{ direction.batiment.type.travailleursDeBase > 1 ? 's' : '' }}
                au niveau 1 — il vous reste {{ mainDoeuvre.oisifs }} bras sans ouvrage.
            </p>
        {% endif %}

        {# **Ce qu'un chef change ici**, dit avant qu'on embauche : sans cela,
           l'annonce paraît une dépense de plus. Sans chef, le bâtiment tourne
           au plancher ; avec un chef, il ouvre ses postes et sa direction
           pèse sur tout ce qu'il produit. #}
        {% if direction.chefs is empty %}
            <p class="mt-3 rounded-sm border-l-4 border-terre-500 bg-terre-500/5 px-4 py-3 text-sm text-encre-700" data-chiffres>
                <strong class="font-medium">Sans chef, ce bâtiment tourne à {{ constant('App\\Game\\Effectifs::RENDEMENT_PLANCHER') }} %.</strong>
                Un chef le fait travailler à plein, et sa compétence se lit dans
                tout ce qu'il produit. Afficher une annonce ne coûte rien et ne
                prend aucune quinzaine : c'est le chef que vous retenez qui se
                paiera — et il s'installe avec les siens.
            </p>
        {% endif %}

        {% if direction.specialitesPossibles is not empty %}
            <details class="mt-3 text-sm text-encre-600">
                <summary class="cursor-pointer text-encre-700">Spécialités possibles ici</summary>
                <ul class="mt-2 list-none space-y-1 p-0">
                    {% for specialite in direction.specialitesPossibles %}
                        <li>
                            <strong class="font-medium">{{ specialite.libelle }}</strong>
                            — {{ specialite.description }}
                            {% if not specialite.agitDeja %}<span class="text-encre-500">(sans effet pour l'instant)</span>{% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </details>
        {% endif %}

        {% for chef in direction.chefs %}
            <div class="mt-3 flex flex-wrap items-baseline gap-x-4 gap-y-2 border-t border-ocre-500/20 pt-3">
                <span class="text-encre-900" aria-label="{{ chef.etoiles }} étoile{{ chef.etoiles > 1 ? 's' : '' }} sur 5">
                    {{ '★★★★★'|slice(0, chef.etoiles) }}{{ '☆☆☆☆☆'|slice(0, 5 - chef.etoiles) }}
                </span>
                <span class="text-sm text-encre-600">
                    {% if chef.specialite %}
                        {{ chef.specialite.libelle }}
                        {% if chef.specialite.agitDeja %}
                            <span class="text-encre-500">— {{ chef.specialite.description }}</span>
                        {% else %}
                            <span class="text-encre-500">(sans effet pour l'instant)</span>
                        {% endif %}
                    {% else %}
                        Sans spécialité
                    {% endif %}
                </span>
                <span class="text-sm text-encre-500" data-chiffres>{{ chef.salaire }} deben la quinzaine</span>

                {% if not chef.estEnPoste(partie.cycle) %}
                    <span class="text-sm text-encre-500">Prend son poste à la prochaine quinzaine</span>
                {% endif %}

                {% if partie.estEnCours %}
                    <form method="post" action="{{ path('app_partie_renvoyer', {id: partie.id}) }}" class="ml-auto">
                        <input type="hidden" name="_token" value="{{ csrf_token('renvoyer') }}">
                        <input type="hidden" name="onglet" value="{{ onglet.cle }}">
                        <input type="hidden" name="employe" value="{{ chef.id }}">
                        <button type="submit" class="text-sm text-encre-500 underline hover:text-terre-600">
                            Renvoyer
                        </button>
                    </form>
                {% endif %}
            </div>
        {% endfor %}

        {% if direction.offre %}
            <p class="mt-4 border-t border-ocre-500/20 pt-3 text-sm text-encre-500">
                {{ direction.offre.candidats|length }} candidats se présentent.
            </p>

            <ul class="mt-3 space-y-3 list-none p-0">
                {% for candidat in direction.offre.candidats %}
                    <li class="rounded-sm border border-ocre-500/20 bg-sable-50/60 p-4">
                        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
                            <span class="text-encre-900" aria-label="{{ candidat.etoiles }} étoile{{ candidat.etoiles > 1 ? 's' : '' }} sur 5">
                                {{ '★★★★★'|slice(0, candidat.etoiles) }}{{ '☆☆☆☆☆'|slice(0, 5 - candidat.etoiles) }}
                            </span>
                            <span class="text-sm text-encre-600">
                                {% if candidat.specialite %}
                                    {{ candidat.specialite.libelle }}
                                    {% if not candidat.specialite.agitDeja %}
                                        <span class="text-encre-500">(sans effet pour l'instant)</span>
                                    {% endif %}
                                {% else %}
                                    Sans spécialité
                                {% endif %}
                            </span>
                            <span class="text-sm text-encre-500" data-chiffres>
                                {{ candidat.salaire }} deben · {{ candidat.personnesAmenees }} personnes amenées
                            </span>
                        </div>

                        {% if loop.index0 == direction.rangDuPlusCompetent or loop.index0 == direction.rangDuMoinsCher %}
                            <p class="mt-2 flex flex-wrap gap-2 text-xs uppercase tracking-wide">
                                {% if loop.index0 == direction.rangDuPlusCompetent %}
                                    <span class="rounded-sm bg-lapis-500/10 px-2 py-0.5 text-lapis-500">Le plus compétent</span>
                                {% endif %}
                                {% if loop.index0 == direction.rangDuMoinsCher %}
                                    <span class="rounded-sm bg-ocre-500/10 px-2 py-0.5 text-encre-700">Le moins cher</span>
                                {% endif %}
                            </p>
                        {% endif %}

                        <p class="mt-2 text-sm text-encre-600">{{ candidat.appreciation }}</p>
                        <p class="mt-1 text-sm text-encre-500">{{ candidat.esperanceDeService }}</p>

                        {% for trait in candidat.traits %}
                            <p class="mt-2 text-sm text-encre-600">
                                <strong class="font-medium">{{ trait.libelle }}</strong> — {{ trait.description }}
                                {% if trait.dortEnAttendantSaPhase %}
                                    <span class="text-encre-500">(sans effet pour l'instant)</span>
                                {% endif %}
                            </p>
                        {% endfor %}

                        {% if partie.estEnCours %}
                            <form method="post" action="{{ path('app_partie_embaucher', {id: partie.id}) }}" class="mt-3">
                                <input type="hidden" name="_token" value="{{ csrf_token('embaucher') }}">
                                <input type="hidden" name="onglet" value="{{ onglet.cle }}">
                                <input type="hidden" name="batiment" value="{{ direction.batiment.type.value }}">
                                <input type="hidden" name="rang" value="{{ loop.index0 }}">
                                <button type="submit"
                                        class="rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                                    Retenir ce candidat
                                </button>
                            </form>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>

            {% if partie.estEnCours %}
                <form method="post" action="{{ path('app_partie_embaucher', {id: partie.id}) }}" class="mt-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('embaucher') }}">
                    <input type="hidden" name="onglet" value="{{ onglet.cle }}">
                    <input type="hidden" name="batiment" value="{{ direction.batiment.type.value }}">
                    <button type="submit" name="retirer" value="1"
                            class="text-sm text-encre-500 underline hover:text-terre-600">
                        Retirer l'annonce sans embaucher
                    </button>
                </form>
            {% endif %}
        {% elseif direction.postesLibres > 0 and partie.estEnCours %}
            <form method="post" action="{{ path('app_partie_poster', {id: partie.id}) }}" class="mt-3">
                <input type="hidden" name="_token" value="{{ csrf_token('poster') }}">
                <input type="hidden" name="onglet" value="{{ onglet.cle }}">
                <input type="hidden" name="batiment" value="{{ direction.batiment.type.value }}">
                <button type="submit"
                        class="rounded-sm border border-ocre-500/40 px-4 py-2 text-sm text-encre-700 hover:bg-ocre-500/10">
                    Afficher une annonce
                </button>
            </form>
        {% endif %}
    </div>
{% endif %}
