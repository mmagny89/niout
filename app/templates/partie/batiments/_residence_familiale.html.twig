{# **La Résidence familiale recueille tout ce qui n'appartient à aucun
   bâtiment** (décision de la joueuse) : elle est le foyer de la lignée,
   présente dès le premier jour et jamais construite. Le tableau de bord, la
   mission, la renommée, les chantiers et la liste de ce qui reste à bâtir y
   vivent — les envoyer dans un bâtiment les rendrait inaccessibles à une ville
   qui n'a encore rien dressé. #}
{{ include('partie/batiments/_entete.html.twig') }}

{% import 'partie/_sous_onglets.html.twig' as sous %}
{% set direction = directions[onglet.type.value] ?? null %}
{% set sections = [
    {cle: 'vue', libelle: "Vue d'ensemble"},
    {cle: 'mission', libelle: mission ? 'Mission' : 'Règne'},
    {cle: 'gouvernement', libelle: 'Gouvernement'},
    {cle: 'batiments', libelle: 'Bâtiments'},
] %}
{% if direction %}
    {% set sections = sections|merge([{cle: 'direction', libelle: direction.chefs is empty ? 'Direction · vacante' : 'Direction'}]) %}
{% endif %}
{{ sous.debut('residence', partie.id, "Sections de la Résidence", sections) }}
{{ sous.panneau('residence', 'vue', true) }}


{# **Le tableau de bord : tout ce qui se gouverne, en un coup d'œil.**

   Ces chiffres vivaient en trois cartes de prose qui les noyaient — il fallait
   lire une phrase pour retrouver un nombre, et comparer deux nombres demandait
   de lire deux phrases. Quatre petits tableaux les rangent par domaine ; ce qui
   cloche est dit **en dessous**, une fois, plutôt qu'à côté de chaque ligne.

   Quatre tableaux et non un seul : chacun porte sa légende, et un lecteur
   d'écran annonce ainsi le domaine avant la ligne. Chaque intitulé est un
   `<th scope="row">`, ce qui lie la valeur à ce qu'elle mesure. #}
<h3 class="mt-6 text-xl text-encre-900">Tableau de bord</h3>

{# **Cinq tuiles pour lire la ville d'un regard**, les quatre tableaux dessous pour
   le détail. Les tuiles ne portent aucune valeur que les tableaux n'aient pas :
   ce sont les mêmes chiffres, mis en jauge. Ce qui cloche vire à la terre cuite,
   avec les mêmes seuils que les tableaux. #}
{% import 'partie/batiments/_tuile_de_bord.html.twig' as tuiles %}
<div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-5">
    {{ tuiles.tuile('habitants', 'Habitants', ville.population,
        ville.foyersOccupes, ville.capaciteEnFoyers, ville.manqueDeLogements,
        ville.foyersOccupes ~ ' / ' ~ ville.capaciteEnFoyers ~ ' maisonnées · ' ~ ville.actifs ~ ' actifs',
        'Chaque maisonnée loge jusqu\'à quelques personnes. Quand la jauge est pleine, montez le Quartier d\'habitation avant de faire venir du monde.') }}
    {{ tuiles.tuile('chantier', 'Postes tenus', mainDoeuvre.affectes ~ ' / ' ~ mainDoeuvre.requis,
        mainDoeuvre.affectes, mainDoeuvre.requis, mainDoeuvre.oisifs > 0 or mainDoeuvre.manquants > 0,
        mainDoeuvre.oisifs > 0 ? mainDoeuvre.oisifs ~ ' sans ouvrage' : (mainDoeuvre.manquants > 0 ? mainDoeuvre.manquants ~ ' postes vides' : 'chacun a sa place'),
        'Les postes que vos bâtiments réclament, et ceux que vos bras tiennent. Des bras sans ouvrage mangent sans produire ; des postes vides font tourner un bâtiment au ralenti.') }}
    {{ tuiles.tuile('prestige', 'Vivres', ville.nourriture,
        ville.nourriture, ville.plafondDesVivres, ville.vivresPresqueSatures or (autonomie is not null and autonomie < quinzainesDeVivresInquietantes),
        autonomie is null ? 'sur ' ~ ville.plafondDesVivres : autonomie ~ ' quinzaine' ~ (autonomie > 1 ? 's' : '') ~ ' d\'autonomie',
        'Vos réserves de nourriture face au plafond du Grenier. L\'autonomie dit combien de quinzaines vous tiendriez sans rien récolter.') }}
    {{ tuiles.tuile('deben', 'Deben en caisse', ville.deben,
        null, null, masseSalariale > ville.deben,
        masseSalariale ~ ' de salaires · +' ~ impotPrevu ~ ' d\'impôt',
        'Votre bourse, ce que les salaires coûtent à chaque quinzaine, et l\'impôt attendu à la fin du mois.') }}
    {{ tuiles.tuile('pharaon', 'Renommée', partie.famille.renommee ~ ' / ' ~ renommeeMax,
        partie.famille.renommee, renommeeMax, false, palier.libelle,
        'La renommée fixe le prix d\'un appel d\'habitants et attire — ou repousse — les rivaux. Un gros contrat au Marché en vaut un point.') }}
</div>

{# Le détail, replié : les tuiles disent l'essentiel, le tableau garde chaque
   intitulé. Reste dans le document — lecteurs d'écran et tests le lisent. #}
<details class="mt-4 group">
    <summary class="inline-flex list-none items-center gap-2 rounded-sm px-2 py-1 text-sm text-encre-600 hover:bg-ocre-300/20">
        <span aria-hidden="true" class="transition-transform group-open:rotate-90">▸</span>
        Le détail en chiffres
    </summary>

{# Chaque tableau dans son propre conteneur qui défile : la règle vaut pour
   tous, y compris ceux qui tiennent aujourd'hui. Un tableau sans cadre ne
   déborde pas lui-même — il décale l'écran entier, barre de jeu comprise, et
   l'on cherche longtemps d'où vient le décalage. #}
<div class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="overflow-x-auto rounded-sm border border-ocre-500/30 bg-sable-50">
        <table class="w-full border-collapse text-sm">
        <caption class="px-4 pt-3 text-left font-display text-lg text-encre-900">Habitants</caption>
        <tbody data-chiffres>
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">Population</th>
                <td class="px-4 py-2 text-right text-encre-900">{{ ville.population }}</td>
            </tr>
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">Actifs</th>
                <td class="px-4 py-2 text-right text-encre-900">{{ ville.actifs }}</td>
            </tr>
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">
                    À charge
                    <span class="block text-xs text-encre-500">enfants et anciens</span>
                </th>
                <td class="px-4 py-2 text-right text-encre-900">{{ ville.inactifs }}</td>
            </tr>
            {% if ville.estFrappeeParUneEpidemie %}
                <tr class="border-t border-ocre-500/20">
                    <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">Alités</th>
                    <td class="px-4 py-2 text-right text-terre-600">{{ ville.malades }}</td>
                </tr>
            {% endif %}
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">Maisonnées logées</th>
                <td class="px-4 py-2 text-right {{ ville.manqueDeLogements ? 'text-terre-600' : 'text-encre-900' }}">
                    {{ ville.foyersOccupes }} / {{ ville.capaciteEnFoyers }}
                </td>
            </tr>
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">Places libres</th>
                <td class="px-4 py-2 text-right {{ ville.manqueDeLogements ? 'text-terre-600' : 'text-encre-900' }}">
                    {{ ville.foyersLibres }}
                </td>
            </tr>
        </tbody>
    </table>
    </div>

    <div class="overflow-x-auto rounded-sm border border-ocre-500/30 bg-sable-50">
        <table class="w-full border-collapse text-sm">
        <caption class="px-4 pt-3 text-left font-display text-lg text-encre-900">Travail</caption>
        <tbody data-chiffres>
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">
                    Bras disponibles
                    <span class="block text-xs text-encre-500">chefs déduits</span>
                </th>
                <td class="px-4 py-2 text-right text-encre-900">{{ mainDoeuvre.bras }}</td>
            </tr>
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">Postes ouverts</th>
                <td class="px-4 py-2 text-right text-encre-900">{{ mainDoeuvre.requis }}</td>
            </tr>
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">Postes tenus</th>
                <td class="px-4 py-2 text-right text-encre-900">{{ mainDoeuvre.affectes }}</td>
            </tr>
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">
                    Sans ouvrage
                    <span class="block text-xs text-encre-500">ils mangent et ne produisent rien</span>
                </th>
                <td class="px-4 py-2 text-right {{ mainDoeuvre.oisifs > 0 ? 'text-terre-600' : 'text-encre-900' }}">
                    {{ mainDoeuvre.oisifs }}
                </td>
            </tr>
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">Postes vides</th>
                <td class="px-4 py-2 text-right {{ mainDoeuvre.manquants > 0 ? 'text-terre-600' : 'text-encre-900' }}">
                    {{ mainDoeuvre.manquants }}
                </td>
            </tr>
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">Mécontentement</th>
                <td class="px-4 py-2 text-right {{ villeMecontente ? 'text-terre-600' : 'text-encre-900' }}">
                    {{ mecontentement }} quinzaine{{ mecontentement > 1 ? 's' : '' }}
                </td>
            </tr>
        </tbody>
    </table>
    </div>

    <div class="overflow-x-auto rounded-sm border border-ocre-500/30 bg-sable-50">
        <table class="w-full border-collapse text-sm">
        <caption class="px-4 pt-3 text-left font-display text-lg text-encre-900">Réserves</caption>
        <tbody data-chiffres>
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">
                    Vivres
                    <span class="block text-xs text-encre-500">au Grenier</span>
                </th>
                <td class="px-4 py-2 text-right {{ ville.vivresPresqueSatures ? 'text-terre-600' : 'text-encre-900' }}">
                    {{ ville.nourriture }} / {{ ville.plafondDesVivres }}
                </td>
            </tr>
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">Mangés par quinzaine</th>
                <td class="px-4 py-2 text-right text-encre-900">{{ ville.consommationDeNourriture }}</td>
            </tr>
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">
                    Autonomie
                    <span class="block text-xs text-encre-500">sans rien récolter</span>
                </th>
                <td class="px-4 py-2 text-right {{ autonomie is not null and autonomie < quinzainesDeVivresInquietantes ? 'text-terre-600' : 'text-encre-900' }}">
                    {% if autonomie is null %}
                        —
                    {% else %}
                        {{ autonomie }} quinzaine{{ autonomie > 1 ? 's' : '' }}
                    {% endif %}
                </td>
            </tr>
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">
                    Matériaux et ouvrages
                    <span class="block text-xs text-encre-500">à l'Entrepôt</span>
                </th>
                <td class="px-4 py-2 text-right {{ ville.materiauxPresqueSatures ? 'text-terre-600' : 'text-encre-900' }}">
                    {{ ville.materiaux }} / {{ ville.plafondDesMateriaux }}
                </td>
            </tr>
        </tbody>
    </table>
    </div>

    <div class="overflow-x-auto rounded-sm border border-ocre-500/30 bg-sable-50">
        <table class="w-full border-collapse text-sm">
        <caption class="px-4 pt-3 text-left font-display text-lg text-encre-900">Bourse et renom</caption>
        <tbody data-chiffres>
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">
                    Deben en caisse
                    <span class="block text-xs text-encre-500">sans plafond</span>
                </th>
                <td class="px-4 py-2 text-right text-encre-900">{{ ville.deben }}</td>
            </tr>
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">
                    Salaires
                    <span class="block text-xs text-encre-500">dus à chaque quinzaine</span>
                </th>
                <td class="px-4 py-2 text-right {{ masseSalariale > ville.deben ? 'text-terre-600' : 'text-encre-900' }}">
                    {{ masseSalariale }}
                </td>
            </tr>
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">
                    Impôt du mois
                    <span class="block text-xs text-encre-500">
                        {% if quinzainesAvantImpot == 1 %}perçu à la fin de cette quinzaine{% else %}perçu dans {{ quinzainesAvantImpot }} quinzaines{% endif %}
                    </span>
                </th>
                <td class="px-4 py-2 text-right text-encre-900">+ {{ impotPrevu }}</td>
            </tr>
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">Renommée</th>
                <td class="px-4 py-2 text-right text-encre-900">
                    {{ partie.famille.renommee }} / {{ renommeeMax }}
                </td>
            </tr>
            {% if chefDeFamille %}
                <tr class="border-t border-ocre-500/20">
                    <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">À sa tête</th>
                    <td class="px-4 py-2 text-right text-encre-900">
                        {{ chefDeFamille }}
                        <span class="text-sm text-encre-500" data-chiffres>· {{ generation }}<sup>e</sup> génération</span>
                    </td>
                </tr>
                {% if traitDeLignee %}
                    <tr class="border-t border-ocre-500/20">
                        <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">Ce qu'on en dit</th>
                        <td class="px-4 py-2 text-right text-encre-900">{{ traitDeLignee.libelle }}</td>
                    </tr>
                {% endif %}
            {% endif %}
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">Votre famille est</th>
                <td class="px-4 py-2 text-right text-encre-900">{{ palier.libelle }}</td>
            </tr>
            {# Ce que la renommée vaut sur les prix (doc 13). L'avantage total
               porte aussi le Négociateur, et il est plafonné : montrer les deux
               chiffres évite de laisser croire qu'ils s'additionnent sans fin. #}
            <tr class="border-t border-ocre-500/20">
                <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">Sur les prix</th>
                <td class="px-4 py-2 text-right text-encre-900">
                    {% if avantageDeRenommee > 0 %}
                        &minus;{{ avantageDeRenommee }}&nbsp;% à l'achat, +{{ avantageDeRenommee }}&nbsp;% à la vente
                    {% else %}
                        Rien encore : on ne vous fait pas de prix
                    {% endif %}
                </td>
            </tr>
            {% if carnet is not empty %}
                <tr class="border-t border-ocre-500/20">
                    <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">Vos contacts</th>
                    <td class="px-4 py-2 text-right text-encre-900">
                        {{ carnet|length }} ville{{ carnet|length > 1 ? 's' : '' }} où l'on vous connaît
                    </td>
                </tr>
            {% endif %}
            {% if avantageDeNegoce > avantageDeRenommee %}
                <tr class="border-t border-ocre-500/20">
                    <th scope="row" class="px-4 py-2 text-left font-normal text-encre-600">
                        Avec votre Négociateur
                    </th>
                    <td class="px-4 py-2 text-right text-encre-900">{{ avantageDeNegoce }}&nbsp;% en tout</td>
                </tr>
            {% endif %}
        </tbody>
    </table>
    </div>
</div>
</details>

{{ include('partie/_erudition.html.twig') }}

{# **Ce qui cloche est dit une fois, ici**, et non à côté de chaque chiffre :
   une remarque par ligne du tableau rendrait illisible ce qu'il est censé
   rendre lisible.

   La liste vient d'`EtatDeLaVille`, celle-là même que la carte affiche en
   pastilles — deux listes écrites séparément auraient fini par diverger, et
   c'est justement la carte qui aurait cessé de dire la vérité. Ici, elles sont
   dépliées : la Résidence est l'écran où l'on s'arrête pour décider. #}
{% if ennuis is not empty %}
    <h3 class="mt-8 text-xl text-encre-900">Ce qui demande votre attention</h3>
    <ul class="mt-3 grid list-none grid-cols-1 gap-3 p-0 md:grid-cols-2">
        {% for signal in ennuis %}
            <li class="carte-vivante flex items-start gap-3 rounded-sm border-l-4 border-terre-500 bg-terre-500/5 px-5 py-3">
                {{ include('partie/_pictogramme.html.twig', {nom: signal.icone, taille: 34, classe: 'mt-0.5'}) }}
                <div>
                <p class="text-encre-900">{{ signal.titre }}</p>
                <p class="mt-1 text-sm text-encre-600">{{ signal.detail }}</p>
                </div>
            </li>
        {% endfor %}
    </ul>
{% else %}
    <p class="mt-8 max-w-4xl text-sm text-encre-500">
        Rien ne presse : vos gens sont logés, employés, payés et nourris.
    </p>
{% endif %}

{# **Le bon compte autant que le mauvais** (décision de la joueuse) : un écran
   qui ne signalerait que les ennuis ferait du jeu une liste de pannes, et l'on
   manquerait les moments à saisir — une fête, une crue forte, des dieux
   acquis. #}
{% if bonnesNouvelles is not empty %}
    <h3 class="mt-8 text-xl text-encre-900">Ce qui joue pour vous</h3>
    <ul class="mt-3 grid list-none grid-cols-1 gap-3 p-0 md:grid-cols-2">
        {% for signal in bonnesNouvelles %}
            <li class="carte-vivante flex items-start gap-3 rounded-sm border-l-4 border-lapis-500 bg-lapis-500/5 px-5 py-3">
                {{ include('partie/_pictogramme.html.twig', {nom: signal.icone, taille: 34, classe: 'mt-0.5'}) }}
                <div>
                <p class="text-encre-900">{{ signal.titre }}</p>
                <p class="mt-1 text-sm text-encre-600">{{ signal.detail }}</p>
                </div>
            </li>
        {% endfor %}
    </ul>
{% endif %}

{# Ce qui reste à faire pour le palier suivant : un compteur nu se subit, un
   objectif se joue. #}
<p class="mt-6 max-w-4xl text-sm text-encre-600">
    {% if palierSuivant %}
        <span data-chiffres>
            {{ palier.attractivite }}
            Encore {{ seuilDuPalierSuivant - partie.famille.renommee }} points pour être
            {{ palierSuivant.libelle|lower }} : un gros contrat au Marché en vaut un.
        </span>
    {% else %}
        {{ palier.attractivite }} Votre nom porte aussi loin qu'il le peut.
    {% endif %}
</p>
    </div>

{{ sous.panneau('residence', 'mission', false) }}
{# En Aventure, il n'y a pas de mission mais un **règne** : la ville existe
   pour elle-même, et les pharaons se succèdent au-dessus d'elle (doc 14,
   lot 11.1). Le cartouche ne s'affiche que là où sa lecture est établie — on
   n'en approxime jamais un. #}
{% if regne %}
    <div class="decret relative mt-6 rounded-sm border border-or-400/40 p-5">
        <span class="decret__sceau absolute right-4 top-4" aria-hidden="true">{{ include('partie/_pictogramme.html.twig', {nom: 'pharaon', taille: 56}) }}</span>
        <h2 class="pr-20 text-2xl text-encre-900">
            {{ regne.pharaon }}
            <span class="font-hieroglyphes text-encre-600">{{ regne.cartouche ? regne.cartouche.signes : '' }}</span>
        </h2>
        <p class="mt-2 max-w-4xl text-sm text-encre-500">
            {{ regne.nomDeTrone }}{{ regne.nomDeTrone ? ' ·' : '' }} {{ regne.longueur.libelle }} ·
            <span data-chiffres>règne {{ rangDuRegne }} sur {{ nombreDeRegnes }}</span>
        </p>
        {# Où l'on en est dans la succession : un cran par règne, allumés jusqu'au courant. #}
        <p class="mt-2 flex gap-1" aria-hidden="true">
            {% for cran in 1..nombreDeRegnes %}
                <span class="size-2.5 rotate-45 {{ cran <= rangDuRegne ? 'bg-terre-500' : 'border border-ocre-500/50' }}"></span>
            {% endfor %}
        </p>
        <p class="mt-3 max-w-4xl text-sm text-encre-600">{{ regne.avenement }}</p>
    </div>
{% endif %}

{# La génération a fait son temps : le joueur choisit qui prend la suite.
   **Ce qui persiste** — renommée, contacts, faveur divine, la ville entière —
   n'est pas en jeu ; seul le chef change (doc 13, lot 11.5). #}
{% if heritiers is not empty %}
    <h3 class="mt-8 text-xl text-encre-900">La maison change de mains</h3>
    <p class="mt-2 max-w-4xl text-sm text-encre-600">
        La génération a fait son temps. Choisissez qui prend la suite : la
        ville, la renommée et vos contacts ne changent pas — c'est la personne
        qui change, pas la maison.
    </p>

    <ul class="mt-4 grid list-none grid-cols-1 gap-3 p-0 md:grid-cols-2 2xl:grid-cols-3">
        {% for rang, heritier in heritiers %}
            <li class="carte-vivante flex flex-col rounded-sm border border-ocre-500/30 bg-sable-50 p-4">
                <div class="flex items-center gap-3">
                    {{ include('partie/_pictogramme.html.twig', {nom: 'chef', taille: 40}) }}
                    <h4 class="font-display text-lg text-encre-900">{{ heritier.prenom }}</h4>
                </div>
                <p class="mt-2 text-sm text-encre-600">{{ heritier.description }}</p>

                {% if partie.estEnCours %}
                    <form method="post" action="{{ path('app_partie_heritier', {id: partie.id}) }}" class="mt-auto pt-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('heritier') }}">
                        <input type="hidden" name="onglet" value="{{ onglet.cle }}">
                        <input type="hidden" name="heritier" value="{{ rang }}">
                        <button type="submit"
                                class="rounded-sm border border-ocre-500/40 px-3 py-1.5 text-sm text-encre-700 transition hover:border-ocre-500 hover:bg-ocre-300/25">
                            Qu'il prenne la suite
                        </button>
                    </form>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endif %}

{# Pas d'objectif fermé en Aventure : un score qu'on regarde monter, et le
   détail de ce qui le compose — un total nu ne dit pas quoi faire pour le
   faire monter (doc 14, lot 11.4). #}
{% if scoreDAventure is not null %}
    <h3 class="mt-8 flex items-center gap-3 text-xl text-encre-900">
        {{ include('partie/_pictogramme.html.twig', {nom: 'prestige', taille: 36}) }}
        Ce que votre ville vaut — <span data-chiffres>{{ scoreDAventure }}</span>
    </h3>
    {# Chaque grandeur pèse en points : une barre proportionnelle à sa part du total, le texte dit les
       mêmes chiffres (ce qu'on mesure, ce que ça rapporte). #}
    {% set pointsMax = max(1, detailDuScore|map(l => l.points)|reduce((m, p) => max(m, p), 0)) %}
    <ul class="mt-3 list-none space-y-2 p-0">
        {% for ligne in detailDuScore %}
            <li class="rounded-sm border border-ocre-500/25 bg-sable-50 px-4 py-2.5">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                    <span class="text-encre-900">{{ ligne.libelle }}</span>
                    <span class="text-sm text-encre-500" data-chiffres>{{ ligne.mesure }} · <strong class="font-medium text-encre-900">{{ ligne.points }}</strong> points</span>
                </div>
                <div class="mt-1.5 h-2 w-full overflow-hidden rounded-full bg-ocre-500/20" aria-hidden="true">
                    <div class="jauge h-full rounded-full bg-linear-to-r from-lapis-500 to-lapis-400" style="width: {{ (ligne.points * 100 / pointsMax)|round }}%"></div>
                </div>
            </li>
        {% endfor %}
    </ul>
    <p class="mt-2 max-w-4xl text-sm text-encre-500">
        Rien à atteindre : le mode dure autant que la succession, et vous
        arrêtez quand il vous plaît.
    </p>
{% endif %}

{% if mission %}
        <div class="decret relative mt-6 rounded-sm border border-or-400/40 p-5">
            <span class="decret__sceau absolute right-4 top-4" aria-hidden="true">{{ include('partie/_pictogramme.html.twig', {nom: 'pharaon', taille: 56}) }}</span>
            <h2 class="pr-20 text-2xl text-encre-900">
                Mission <span data-chiffres>{{ mission.numero }}</span> sur 10 — {{ mission.ville }}
            </h2>
            <p class="mt-2 flex gap-1" aria-hidden="true">
                {% for cran in 1..10 %}
                    <span class="size-2.5 rotate-45 {{ cran <= mission.numero ? 'bg-terre-500' : 'border border-ocre-500/50' }}"></span>
                {% endfor %}
            </p>
            <p class="mt-3 max-w-4xl text-sm text-encre-500">
                Commandée par <strong class="text-encre-700">{{ mission.pharaon }}</strong>.
                {{ mission.contexte }}
            </p>
        </div>

        {# Le doc 09 veut les objectifs visibles dès le premier jour :
           découvrir tardivement une condition qu'on n'a pas pu
           anticiper serait injuste. #}
        <h4 class="mt-6 text-lg text-encre-900">Ce que le pharaon attend</h4>
        <ul class="mt-3 grid list-none grid-cols-1 gap-3 p-0 md:grid-cols-2">
            {% set accompli = filRouge and filRouge.value == 'accompli' %}
            <li class="carte-vivante rounded-sm border px-4 py-3 {{ accompli ? 'border-lapis-500/50 bg-lapis-500/5' : 'border-terre-500/40 bg-terre-500/5' }}">
                <div class="flex items-center gap-3">
                    {{ include('partie/_pictogramme.html.twig', {nom: 'enigme', taille: 36}) }}
                    <div class="min-w-0 flex-1">
                        <p class="text-encre-900">Résoudre le fil rouge de la mission</p>
                        <p class="text-xs text-encre-500">Obligatoire : sans lui, rien n'est accompli.</p>
                    </div>
                    <span class="signal {{ accompli ? 'signal--bon' : 'signal--neutre' }}">{{ accompli ? '✓ ' : '' }}{{ filRouge ? filRouge.libelle : 'à venir' }}</span>
                </div>
            </li>

            {% for ligne in objectifs %}
                <li class="carte-vivante rounded-sm border px-4 py-3 {{ ligne.atteint ? 'border-lapis-500/50 bg-lapis-500/5' : 'border-ocre-500/30 bg-sable-50' }}">
                    <div class="flex flex-wrap items-baseline justify-between gap-3">
                        <span class="text-encre-900">{{ ligne.objectif.libelle }}</span>
                        <span class="signal {{ ligne.atteint ? 'signal--bon' : 'signal--neutre' }}" data-chiffres>
                            {{ ligne.atteint ? '✓ ' : '' }}{{ ligne.avancement }} / {{ ligne.objectif.seuilMesure }}
                        </span>
                    </div>
                    <div class="mt-2 h-2.5 w-full overflow-hidden rounded-full bg-ocre-500/20" aria-hidden="true">
                        <div class="jauge h-full rounded-full {{ ligne.atteint ? 'bg-linear-to-r from-lapis-500 to-lapis-400' : 'bg-terre-500' }}"
                             style="width: {{ min(100, (ligne.avancement * 100 / max(1, ligne.objectif.seuilMesure))|round) }}%"></div>
                    </div>
                </li>
            {% endfor %}
        </ul>

        {# Les requêtes du pharaon ne comptent pas dans la réussite :
           elles font gagner du renom et de la faveur, et refuser ne
           coûte que deux points (doc 09). #}
        {% if quete %}
            <h4 class="mt-8 text-lg text-encre-900">Une requête du pharaon</h4>
            <div class="mt-3 rounded-sm border-l-4 border-or-300 bg-or-300/10 px-5 py-4">
                <div class="flex items-center gap-4">
                    {{ include('partie/_icone_ressource.html.twig', {ressource: quete.ressource, taille: 64}) }}
                    <div class="min-w-0 flex-1">
                        <p class="text-encre-900">
                            {{ mission.pharaon }} réclame
                            <span data-chiffres>{{ quete.quantite }}</span> {{ quete.ressource.libelle }}
                            pour {{ quete.chantier.libelle }}.
                        </p>
                        <p class="mt-1 text-sm text-encre-500">
                            Laisser filer le délai revient à décliner.
                        </p>
                    </div>
                    <span class="signal {{ quete.quinzainesRestantes <= 1 ? 'signal--mauvais' : 'signal--neutre' }}" data-chiffres>
                        {{ include('partie/_pictogramme.html.twig', {nom: 'quinzaine', taille: 18}) }} encore {{ quete.quinzainesRestantes }} quinzaine(s)
                    </span>
                </div>

                {% if partie.estEnCours %}
                    <form method="post" action="{{ path('app_partie_quete', {id: partie.id}) }}"
                          class="mt-3 flex flex-wrap items-center gap-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('quete') }}">
                        <input type="hidden" name="onglet" value="{{ onglet.cle }}">
                        <button type="submit"
                                class="bouton-offrande group inline-flex items-center gap-2 rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                            {{ include('partie/_pictogramme.html.twig', {nom: 'echange', taille: 22, classe: 'bouton-offrande__image'}) }}
                            Envoyer le chargement
                        </button>
                        <button type="submit" name="refuser" value="1"
                                class="text-sm text-encre-500 underline hover:text-terre-600">
                            Décliner
                        </button>
                    </form>
                {% endif %}
            </div>
        {% endif %}

        <p class="mt-4 max-w-4xl text-xs text-encre-500">
            Le fil rouge résolu suffit à clore la mission : les objectifs
            non atteints donnent une reconnaissance plus modeste, jamais un échec.
        </p>
{% endif %}
    </div>

{{ sous.panneau('residence', 'gouvernement', false) }}
{# Le salaire des bras vit ici, avec la main-d'œuvre : c'est le seul salaire
   que le joueur fixe lui-même, celui d'un chef se négociant candidat par
   candidat à l'embauche. #}
<h3 class="mt-8 text-xl text-encre-900">Ce que vous payez vos bras</h3>
<div class="mt-3 rounded-sm border border-ocre-500/30 bg-sable-50 p-4">
    <div class="flex items-start gap-3">
        {{ include('partie/_pictogramme.html.twig', {nom: 'deben', taille: 44}) }}
        <p class="text-sm text-encre-500"
           data-infobulle="Le salaire d'un travailleur, par quinzaine. Les chefs ne sont pas concernés : leur salaire se négocie à l'embauche.">
            Le salaire d'un travailleur, par quinzaine. L'usage est de
            <span data-chiffres>{{ salaireJuste }}</span> deben :
            <strong class="text-encre-700">payer moins mécontente la ville</strong>, et
            payer <span data-chiffres>{{ salaireGenereux }}</span> ou plus l'apaise deux
            fois plus vite.
        </p>
    </div>

    {% if partie.estEnCours %}
        {# Le curseur double le champ : terre cuite sous l'usage (la ville s'en plaint), lapis au-delà.
           Le champ reste la source soumise, et le serveur borne. #}
        <form method="post" action="{{ path('app_partie_train_de_vie', {id: partie.id}) }}"
              class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-3"
              data-controller="curseur" data-curseur-mauvais-en-bas-value="true"
              data-curseur-seuil-value="{{ salaireJuste }}" data-curseur-juste-value="{{ salaireJuste }}"
              data-curseur-genereux-value="{{ salaireGenereux }}">
            <input type="hidden" name="_token" value="{{ csrf_token('train-de-vie') }}">
            <input type="hidden" name="onglet" value="{{ onglet.cle }}">

            <label for="salaire" class="text-sm text-encre-600">Un travailleur touche</label>
            <input type="number" id="salaire" name="salaire" value="{{ ville.salaireDeBase }}"
                   min="{{ salaireMinimal }}" max="{{ salaireMaximal }}"
                   data-curseur-target="champ" data-action="input->curseur#saisir"
                   class="w-20 rounded-sm border border-ocre-500/40 bg-sable-50 px-3 py-2 text-sm text-encre-900"
                   data-chiffres>
            <span class="text-sm text-encre-500" data-curseur-target="valeur">deben la quinzaine</span>

            <button type="submit"
                    class="bouton-offrande group inline-flex items-center gap-2 rounded-sm border border-lapis-500/50 px-4 py-2 text-sm text-lapis-600 hover:bg-lapis-500/10">
                {{ include('partie/_pictogramme.html.twig', {nom: 'deben', taille: 20, classe: 'bouton-offrande__image'}) }}
                Fixer le salaire
            </button>

            <input type="range" aria-hidden="true" tabindex="-1" data-curseur-target="piste"
                   data-action="input->curseur#deplacer" class="curseur basis-full max-w-md">
            <p class="basis-full text-sm" data-curseur-target="verdict" data-chiffres
               data-bas="La ville s'en plaint : c'est moins que l'usage."
               data-milieu="C'est l'usage : la ville ne dit rien."
               data-haut="La ville s'apaise deux fois plus vite."></p>
        </form>
    {% else %}
        <p class="mt-3 text-sm text-encre-600" data-chiffres>Un travailleur touche {{ ville.salaireDeBase }} deben la quinzaine.</p>
    {% endif %}

    {% if griefsDeLaVille is not empty %}
        <ul class="mt-3 space-y-1 list-none p-0 text-sm text-terre-600">
            {% for grief in griefsDeLaVille %}
                <li class="flex items-start gap-2">{{ include('partie/_pictogramme.html.twig', {nom: 'danger', taille: 18, classe: 'mt-0.5'}) }} {{ grief }}</li>
            {% endfor %}
        </ul>
    {% endif %}
</div>

{# Tout ce qui est en route, en une seule liste. Ce panneau ne remplace aucun
   des écrans qui suivent et ne porte aucune action : il répond à une seule
   question — qu'est-ce que j'attends, et pour combien de temps ? #}
<h3 class="mt-8 text-xl text-encre-900">Ce que vous attendez</h3>
{% if travauxEnCours is empty %}
    <p class="mt-2 flex items-center gap-3 text-sm text-encre-500">
        {{ include('partie/_pictogramme.html.twig', {nom: 'quinzaine', taille: 36}) }}
        <span>Rien n'est en route : aucun chantier, aucun ouvrage, aucune expédition,
        aucun convoi. Avancer d'une quinzaine ne vous apportera que vos récoltes.</span>
    </p>
{% else %}
    {# La liste est triée du plus proche au plus lointain : chaque ligne est une échéance, avec le
       pictogramme de sa nature (chantier, expédition, convoi, présent du roi, ouvrage d'atelier). #}
    {% set natures = {'Chantier': 'chantier', 'Expédition': 'expedition', 'Convoi': 'echange', 'Présent du roi': 'pharaon'} %}
    <ol class="mt-4 list-none space-y-2 p-0" aria-label="Travaux, ouvrages et convois en cours, du plus proche au plus lointain">
        {% for travail in travauxEnCours %}
            <li class="carte-vivante case-vivante flex items-center gap-3 rounded-sm border border-ocre-500/30 bg-sable-50 px-4 py-2.5"
                style="--i: {{ loop.index0 }}">
                {{ include('partie/_pictogramme.html.twig', {nom: natures[travail.categorie]|default('amelioration'), taille: 32}) }}
                <div class="min-w-0 flex-1">
                    <p class="text-encre-900"><span class="text-encre-500">{{ travail.categorie }}</span> · {{ travail.libelle }}</p>
                    <p class="text-sm text-encre-600">{{ travail.detail }}</p>
                </div>
                <span class="signal {{ travail.quinzaines == 0 ? 'signal--mauvais' : (travail.quinzaines == 1 ? 'signal--bon' : 'signal--neutre') }}" data-chiffres>
                    {% if travail.quinzaines == 0 %}
                        à l'arrêt
                    {% elseif travail.quinzaines == 1 %}
                        la prochaine quinzaine
                    {% else %}
                        dans {{ travail.quinzaines }} quinzaines
                    {% endif %}
                </span>
            </li>
        {% endfor %}
    </ol>
{% endif %}

{% if chantiers|length > 0 %}
    <h3 class="mt-8 text-xl text-encre-900">Chantiers en cours</h3>
    <ul class="mt-4 grid list-none grid-cols-1 gap-3 p-0 md:grid-cols-2 2xl:grid-cols-3">
        {% for chantier in chantiers %}
            {% set sprite = image_de_batiment(chantier.type, chantier.estUneAmelioration ? chantier.niveauVise : 1) %}
            <li class="carte-vivante rounded-sm border border-ocre-500/40 bg-ocre-300/10 p-4">
                <div class="flex items-start gap-3">
                    {% if sprite %}<img src="{{ asset(sprite) }}" alt="" loading="lazy" decoding="async" class="w-20 shrink-0 select-none">{% endif %}
                    <div class="min-w-0 flex-1">
                        <h3 class="font-display text-lg leading-tight text-encre-900">{{ chantier.type.libelle }}</h3>
                        <p class="text-sm text-encre-500" data-chiffres>
                            {% if chantier.estUneAmelioration %}vers le niveau {{ chantier.niveauVise }} · {% endif %}
                            encore {{ chantier.cyclesRestants }} cycle{{ chantier.cyclesRestants > 1 ? 's' : '' }}
                        </p>
                        <div class="mt-2 h-3 w-full overflow-hidden rounded-full bg-ocre-500/20" aria-hidden="true">
                            <div class="jauge jauge--ouvrage h-full rounded-full bg-terre-500" style="width: {{ chantier.pourcentageDAvancement }}%"></div>
                        </div>
                    </div>
                </div>

                {# Les quatre étapes du doc 01, toutes affichées : un chantier court en traverse deux par
                   quinzaine, et n'en montrer qu'une escamoterait la moitié du contenu pédagogique. En frise
                   — une pastille par étape, reliées —, avec l'explication de celle qui est en cours. #}
                <ol class="mt-4 flex list-none items-start p-0">
                    {% for rang in chantier.etapes(partie.dateDeJeu.saison) %}
                        <li class="relative flex-1 text-center {{ rang.etat.value == 'a_venir' ? 'opacity-50' : '' }}">
                            {% if not loop.first %}
                                <span aria-hidden="true" class="absolute right-1/2 top-2.5 h-0.5 w-full -translate-y-1/2 {{ rang.etat.value == 'a_venir' ? 'bg-ocre-500/30' : 'bg-terre-500' }}"></span>
                            {% endif %}
                            <span aria-hidden="true"
                                  class="relative mx-auto flex size-5 items-center justify-center rounded-full text-xs
                                         {{ rang.etat.value == 'terminee' ? 'bg-terre-500 text-sable-50'
                                            : (rang.etat.value == 'en_cours' ? 'border-2 border-terre-500 bg-sable-50 text-terre-600'
                                            : 'border border-ocre-500/50 bg-sable-50 text-encre-500') }}"
                                  data-chiffres>{{ rang.etat.value == 'terminee' ? '✓' : rang.numero }}</span>
                            <p class="mt-1 px-0.5 text-xs leading-tight {{ rang.etat.value == 'en_cours' ? 'font-medium text-encre-900' : 'text-encre-600' }}">
                                {{ rang.etape.nom }}
                                {% if rang.etat.value == 'terminee' %}
                                    <span class="sr-only">— étape terminée</span>
                                {% elseif rang.etat.value == 'en_cours' %}
                                    <span class="sr-only">— étape en cours</span>
                                {% else %}
                                    <span class="sr-only">— étape à venir</span>
                                {% endif %}
                            </p>
                        </li>
                    {% endfor %}
                </ol>
                {% for rang in chantier.etapes(partie.dateDeJeu.saison) %}
                    {% if rang.etat.value == 'en_cours' %}
                        <p class="mt-3 rounded-sm bg-sable-50 px-3 py-2 text-sm text-encre-600">{{ rang.etape.explication }}</p>
                    {% endif %}
                {% endfor %}
            </li>
        {% endfor %}
    </ul>
{% endif %}
    </div>

{{ sous.panneau('residence', 'batiments', false) }}
{% set offresNeuves = offres|filter(offre => not offre.estDejaDressé) %}
{% set realisables = offresNeuves|filter(offre => offre.estRealisable)|length %}

{# Le bilan en trois pastilles : ce qui est debout, ce qu'on peut engager maintenant, ce qui attend. #}
<ul class="mt-6 flex list-none flex-wrap gap-2 p-0" data-chiffres>
    <li class="signal signal--bon">{{ include('partie/_pictogramme.html.twig', {nom: 'chantier', taille: 20}) }} {{ batimentsDresses|length }} dressé{{ batimentsDresses|length > 1 ? 's' : '' }}</li>
    {% if offresNeuves is not empty %}
        {# Rouge seulement quand il reste à bâtir **et** que rien ne peut être engagé. #}
        <li class="signal {{ realisables > 0 ? 'signal--neutre' : 'signal--mauvais' }}">{{ include('partie/_pictogramme.html.twig', {nom: 'amelioration', taille: 20}) }} {{ realisables }} à engager</li>
        <li class="signal signal--neutre">{{ include('partie/_pictogramme.html.twig', {nom: 'quinzaine', taille: 20}) }} {{ offresNeuves|length - realisables }} en attente</li>
    {% endif %}
</ul>

<h3 class="mt-6 text-xl text-encre-900">Les bâtiments de la ville</h3>
<p class="mt-2 text-sm text-encre-500">
    Les ressources sont payées à l'engagement du chantier ; les travaux
    n'avancent ensuite qu'aux quinzaines que vous déclenchez.
    {% if connaitLaCrue %}
        Pendant la crue d'Akhèt, la main-d'œuvre libérée les fait progresser de
        moitié plus vite.
    {% else %}
        Aucun fleuve ne monte ici : rien ne libère de main-d'œuvre, et les
        chantiers avancent au même rythme toute l'année.
    {% endif %}
</p>

{# **Une seule liste** : les bâtiments dressés d'abord (on y monte d'un niveau), puis ce qu'il reste à
   bâtir — ce qu'on peut engager avant ce qui est bloqué : une liste qui commence par le bloqué cache ce
   qu'on vient chercher. Dressés et à bâtir partagent la même carte (`_carte_de_batiment`). #}
{% set ordonnees = offresNeuves|filter(o => o.estRealisable)|merge(offresNeuves|filter(o => not o.estRealisable)) %}
<ul class="mt-4 grid list-none grid-cols-1 gap-3 p-0 md:grid-cols-2 2xl:grid-cols-3">
    {% for batiment in batimentsDresses %}
        {{ include('partie/batiments/_carte_de_batiment.html.twig', {
            batiment: batiment,
            offre: offres|filter(o => o.type == batiment.type)|first ?: null,
            rang: loop.index0,
        }) }}
    {% endfor %}
    {% for offre in ordonnees %}
        {{ include('partie/batiments/_carte_de_batiment.html.twig', {batiment: null, offre: offre, rang: batimentsDresses|length + loop.index0}) }}
    {% endfor %}
</ul>

{% if offresNeuves is empty %}
    <p class="mt-4 flex items-center gap-3 rounded-sm border border-dashed border-ocre-500/50 px-4 py-4 text-sm text-encre-600">
        {{ include('partie/_pictogramme.html.twig', {nom: 'faveur', taille: 36}) }}
        Tout est dressé : il ne reste qu'à monter les niveaux, sur les cartes ci-dessus.
    </p>
{% endif %}
    </div>

{% if direction %}
{{ sous.panneau('residence', 'direction', false) }}
{{ include('partie/batiments/_direction.html.twig') }}
    </div>
{% endif %}
</div>
