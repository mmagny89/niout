{# Le Marché : la seule entrée de deben du début de partie, et la seule source
   de renommée branchée à ce jour (doc 13).

   **Ce qu'on vient y faire, dans l'ordre où on le fait** : voir ce que la place
   peut encore absorber, écouler un lot, éventuellement régler le prix. Les
   explications de fond — pourquoi la place sature, pourquoi vendre cher écoule
   moins — vivent dans un repli : on les lit une fois, on ne les relit pas à
   chaque visite. #}
{{ include('partie/batiments/_entete.html.twig') }}
{% import 'partie/_sous_onglets.html.twig' as sous %}
{% set direction = directions[onglet.type.value] ?? null %}
{% set sections = [
    {cle: 'etal', libelle: 'Étal'},
    {cle: 'prix', libelle: 'Prix'},
] %}
{% if direction %}
    {% set sections = sections|merge([{cle: 'direction', libelle: direction.chefs is empty ? 'Direction · vacante' : 'Direction'}]) %}
{% endif %}
{{ sous.debut('marche', partie.id, "Sections du Marché", sections) }}
{{ sous.panneau('marche', 'etal', true) }}

{# La place de la quinzaine, en cases : ce qui est déjà écoulé (terre cuite) et
   ce qu'elle absorbe encore (pointillés). Le dessin est masqué aux lecteurs
   d'écran, la phrase dessous dit la même chose. #}
<h3 class="mt-8 text-xl text-encre-900">La place du jour</h3>

{% import 'partie/batiments/_tuile_de_bord.html.twig' as tuiles %}
<div class="mt-3">
    {# La place en jauge : pleine, il n'y a plus rien à écouler avant le prochain jour de
       marché. Les chiffres sont écrits dessous et dans la tuile ; la jauge est décorative. #}
    <div class="max-w-md">
        {{ tuiles.tuile('echange', 'La place peut encore absorber', venteRestante ~ ' deben',
            jaugeDuMarche.vendu, jaugeDuMarche.plafond, venteRestante == 0,
            jaugeDuMarche.vendu ~ ' écoulés sur ' ~ jaugeDuMarche.plafond ~ ' cette quinzaine',
            'Les gens de la ville et les voyageurs n\'achètent qu\'un montant par quinzaine. Pleine, la place rouvre au prochain jour de marché.') }}
    </div>
    <p class="mt-2 text-sm text-encre-600" data-chiffres>
        La place peut encore absorber
        <strong class="font-medium {{ venteRestante == 0 ? 'text-terre-600' : 'text-encre-900' }}">{{ venteRestante }}</strong> deben cette quinzaine,
        sur {{ plafondDuMarche }} —
        {{ ville.population }} habitants pour un Marché de niveau {{ niveauDuMarche }}.
        <span class="text-encre-500">Une case : {{ jaugeDuMarche.pas }} deben.</span>
    </p>
</div>

<details class="mt-3 text-sm text-encre-600">
    <summary class="cursor-pointer text-encre-700">Comment fonctionne la place ?</summary>
    <p class="mt-2">
        Vous vendez ici <strong class="text-encre-700">aux gens de la ville et
        aux voyageurs de passage</strong> : au cours de base, payé sur l'heure,
        mais une place n'absorbe qu'un temps. Peupler la ville ou agrandir le
        Marché élargit le débouché. Pour écouler de vrais volumes, et plus cher,
        il faut une route commerciale et la patience d'un convoi. Un gros contrat
        vous fait un nom.
    </p>
    <p class="mt-2">
        Ce que vous gardez de chaque ressource — et donc ce qui part ici de
        lui-même — se règle à l'Entrepôt, qui tient vos stocks.
    </p>
</details>

<h3 class="mt-8 text-xl text-encre-900">L'étal</h3>

{% if etal is empty %}
    <p class="mt-3 text-sm text-encre-500">Vos réserves n'ont rien à vendre pour le moment.</p>
{% else %}
    <p class="mt-2 max-w-4xl text-sm text-encre-500">
        La quantité proposée est la plus grande que la place absorbe encore :
        un clic suffit.
    </p>
    <ul class="mt-3 grid list-none grid-cols-1 gap-3 p-0 md:grid-cols-2">
        {% for lot in etal %}
            <li class="carte-vivante rounded-sm border border-ocre-500/30 bg-sable-50 px-4 py-3">
                {% if partie.estEnCours %}
                    <form method="post" action="{{ path('app_partie_vendre', {id: partie.id}) }}"
                          class="flex flex-wrap items-center gap-x-4 gap-y-2"
                          data-controller="vente" data-vente-prix-value="{{ lot.prix }}" data-vente-max-value="{{ lot.maxVendable }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('vendre') }}">
                        <input type="hidden" name="onglet" value="{{ onglet.cle }}">
                        <input type="hidden" name="ressource" value="{{ lot.ressource.value }}">

                        <span class="flex min-w-24 items-center gap-2 font-display text-lg text-encre-900">
                            {{ include('partie/_icone_ressource.html.twig', {ressource: lot.ressource, taille: 44}) }}
                            {{ lot.ressource.libelle }}
                        </span>
                        <span class="inline-flex items-center gap-1 text-sm text-encre-500" data-chiffres
                              data-infobulle="{{ lot.quantite }} en réserve ; chaque unité se vend {{ lot.prix }} deben au prix que vous faites.">
                            {{ lot.quantite }} en réserve ·
                            {{ include('partie/_pictogramme.html.twig', {nom: 'deben', taille: 18}) }}
                            {{ lot.prix }} l'unité
                        </span>

                        <span class="ml-auto flex items-center gap-2">
                            <label for="quantite-{{ lot.ressource.value }}" class="sr-only">
                                Quantité de {{ lot.ressource.libelle|lower }} à vendre
                            </label>
                            <input type="number" id="quantite-{{ lot.ressource.value }}" name="quantite"
                                   value="{{ max(1, lot.maxVendable) }}" min="1" max="{{ lot.quantite }}"
                                   data-vente-target="quantite" data-action="input->vente#calculer"
                                   class="w-20 rounded-sm border border-ocre-500/40 bg-sable-50 px-2 py-2 text-sm text-encre-900"
                                   data-chiffres>
                            <button type="button" data-action="vente#tout"
                                    class="rounded-sm border border-ocre-500/40 px-2 py-2 text-xs text-encre-600 hover:bg-ocre-300/25"
                                    data-infobulle="Remplit la plus grande quantité que la place absorbe encore.">
                                Tout
                            </button>
                            <span class="min-w-20 text-right text-sm font-medium text-lapis-600" data-chiffres data-vente-target="gain"
                                  data-infobulle="Ce que cette vente rapporterait. Le serveur plafonne selon la place restante."></span>
                            <button type="submit"
                                    class="bouton-offrande group inline-flex items-center gap-2 rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                                {{ include('partie/_pictogramme.html.twig', {nom: 'deben', taille: 20, classe: 'bouton-offrande__image'}) }}
                                Écouler
                            </button>
                        </span>
                        {% if lot.maxVendable < 1 %}
                            <span class="basis-full text-xs text-terre-600">
                                La place est pleine pour ce lot : attendez le prochain jour de marché.
                            </span>
                        {% endif %}
                    </form>
                {% else %}
                    <span class="flex items-center gap-2 text-lg text-encre-900">
                        {{ include('partie/_icone_ressource.html.twig', {ressource: lot.ressource, taille: 44}) }}
                        {{ lot.ressource.libelle }}
                    </span>
                    <span class="text-sm text-encre-500" data-chiffres>{{ lot.quantite }} en réserve</span>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endif %}
    </div>

{{ sous.panneau('marche', 'prix', false) }}
{# Le prix qu'on fait payer : un réglage rare, qui n'a pas à passer avant
   l'étal. Il vit en dessous, dans un repli ouvert d'office dès que la ville se
   plaint — c'est alors qu'on en a besoin. #}
<h3 class="mt-8 text-xl text-encre-900">Le prix que vous faites</h3>
<p class="mt-2 text-sm {{ prixAbusif ? 'text-terre-600' : 'text-encre-500' }}" data-chiffres>
    Vos habitants paient <strong class="font-medium">{{ ville.margeDuMarche }} %</strong> du cours.
    {% if prixAbusif %}
        On trouve vos prix excessifs, et cela mécontente la ville.
    {% else %}
        Un prix que la ville accepte sans rien dire.
    {% endif %}
</p>

<details class="mt-2 text-sm text-encre-600"{{ prixAbusif ? ' open' : '' }}>
    <summary class="cursor-pointer text-encre-700">Régler le prix</summary>
    <p class="mt-2">
        Vendre cher rapporte plus par unité — mais la place n'absorbe qu'un
        montant par quinzaine, donc <strong class="text-encre-700">vous écoulez
        d'autant moins de marchandise</strong>, et au-delà de
        <span data-chiffres>{{ margeQuiFache }} %</span> la ville s'en plaint.
        Vendre bon marché vide vos réserves bien plus vite et laisse les gens
        tranquilles.
    </p>

    {% if partie.estEnCours %}
        <form method="post" action="{{ path('app_partie_train_de_vie', {id: partie.id}) }}"
              class="mt-3 flex flex-wrap items-center gap-3"
              data-controller="curseur" data-curseur-seuil-value="{{ margeQuiFache }}">
            <input type="hidden" name="_token" value="{{ csrf_token('train-de-vie') }}">
            <input type="hidden" name="onglet" value="{{ onglet.cle }}">

            <label for="marge" class="text-sm text-encre-600">Vos habitants paient</label>
            <input type="number" id="marge" name="marge" value="{{ ville.margeDuMarche }}"
                   min="{{ margeMinimale }}" max="{{ margeMaximale }}" step="5"
                   data-curseur-target="champ" data-action="input->curseur#saisir"
                   class="w-24 rounded-sm border border-ocre-500/40 bg-sable-50 px-3 py-2 text-sm text-encre-900"
                   data-chiffres>
            <span class="text-sm text-encre-500" data-curseur-target="valeur">% du cours</span>
            {# Le curseur double le champ : lapis jusqu'au prix que la ville tolère, terre
               cuite au-delà. Le champ reste la source, et le serveur borne. #}
            <input type="range" aria-hidden="true" tabindex="-1" data-curseur-target="piste" data-action="input->curseur#deplacer"
                   class="curseur basis-full max-w-md sm:basis-64">

            <button type="submit"
                    class="rounded-sm border border-lapis-500/50 px-4 py-2 text-sm text-lapis-600 hover:bg-lapis-500/10">
                Fixer le prix
            </button>
        </form>
    {% endif %}
</details>
    </div>

{% if direction %}
{{ sous.panneau('marche', 'direction', false) }}
{{ include('partie/batiments/_direction.html.twig') }}
    </div>

{% endif %}
</div>
