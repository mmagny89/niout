{# Le Marché : la seule entrée de deben du début de partie, et la seule source
   de renommée branchée à ce jour (doc 13). #}
{{ include('partie/batiments/_entete.html.twig') }}
{{ include('partie/batiments/_direction.html.twig') }}

<h3 class="mt-8 text-xl text-encre-900">Le prix que vous faites</h3>
<p class="mt-2 max-w-2xl text-sm text-encre-500">
    Ce que vos propres habitants paient, en pourcentage du cours. Vendre cher
    rapporte plus par unité — mais la place n'absorbe qu'un montant par
    quinzaine, donc <strong class="text-encre-700">vous écoulez d'autant moins
    de marchandise</strong>, et au-delà de
    <span data-chiffres>{{ margeQuiFache }} %</span> la ville s'en plaint.
    Vendre bon marché vide vos réserves bien plus vite et laisse les gens
    tranquilles.
</p>

{% if partie.estEnCours %}
    <form method="post" action="{{ path('app_partie_train_de_vie', {id: partie.id}) }}"
          class="mt-3 flex flex-wrap items-baseline gap-3">
        <input type="hidden" name="_token" value="{{ csrf_token('train-de-vie') }}">
        <input type="hidden" name="onglet" value="{{ onglet.cle }}">

        <label for="marge" class="text-sm text-encre-600">Vos habitants paient</label>
        <input type="number" id="marge" name="marge" value="{{ ville.margeDuMarche }}"
               min="{{ margeMinimale }}" max="{{ margeMaximale }}" step="5"
               class="w-24 rounded-sm border border-ocre-500/40 bg-sable-50 px-3 py-2 text-sm text-encre-900"
               data-chiffres>
        <span class="text-sm text-encre-500">% du cours</span>

        <button type="submit"
                class="rounded-sm border border-lapis-500/50 px-4 py-2 text-sm text-lapis-600 hover:bg-lapis-500/10">
            Fixer le prix
        </button>
    </form>
{% endif %}

<p class="mt-3 text-sm {{ prixAbusif ? 'text-terre-600' : 'text-encre-500' }}">
    {% if prixAbusif %}
        On trouve vos prix excessifs, et cela mécontente la ville.
    {% else %}
        Un prix que la ville accepte sans rien dire.
    {% endif %}
</p>

<p class="mt-3 text-sm text-encre-500">
    Ce que vous gardez de chaque ressource — et donc ce qui part ici de
    lui-même — se règle à l'Entrepôt, qui tient vos stocks.
</p>

<h3 class="mt-8 text-xl text-encre-900">L'étal</h3>
<p class="mt-2 max-w-2xl text-sm text-encre-500">
    Vous vendez ici <strong class="text-encre-700">aux gens de la ville
    et aux voyageurs de passage</strong> : au cours de base, payé sur
    l'heure, mais une place n'absorbe qu'un temps. Pour écouler de
    vrais volumes, et plus cher, il faut une route commerciale et la
    patience d'un convoi. Un gros contrat vous fait un nom.
</p>

<p class="mt-3 rounded-sm border-l-4 border-lapis-500 bg-lapis-500/5 px-4 py-2 text-sm text-encre-600">
    La place peut encore absorber
    <span data-chiffres>{{ venteRestante }}</span> deben cette quinzaine,
    sur <span data-chiffres>{{ plafondDuMarche }}</span> —
    <span data-chiffres>{{ ville.population }}</span> habitants pour un
    Marché de niveau <span data-chiffres>{{ niveauDuMarche }}</span>.
    Peupler la ville ou agrandir le Marché élargit le débouché.
</p>

{% if etal is empty %}
    <p class="mt-4 text-sm text-encre-500">Vos réserves n'ont rien à vendre pour le moment.</p>
{% else %}
    <ul class="mt-4 space-y-3 list-none p-0">
        {% for lot in etal %}
            <li class="rounded-sm border border-ocre-500/30 bg-sable-50 p-5">
                {% if partie.estEnCours %}
                    <form method="post" action="{{ path('app_partie_vendre', {id: partie.id}) }}"
                          class="flex flex-wrap items-baseline gap-x-4 gap-y-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('vendre') }}">
                        <input type="hidden" name="onglet" value="{{ onglet.cle }}">
                        <input type="hidden" name="ressource" value="{{ lot.ressource.value }}">

                        <span class="font-display text-lg text-encre-900">{{ lot.ressource.libelle }}</span>
                        <span class="text-sm text-encre-500" data-chiffres>
                            {{ lot.quantite }} en réserve · {{ lot.prix }} deben l'unité
                        </span>

                        <span class="ml-auto flex items-baseline gap-3">
                            <label for="quantite-{{ lot.ressource.value }}" class="text-sm text-encre-600">Vendre</label>
                            <input type="number" id="quantite-{{ lot.ressource.value }}" name="quantite"
                                   value="1" min="1" max="{{ lot.quantite }}"
                                   class="w-24 rounded-sm border border-ocre-500/40 bg-sable-50 px-3 py-2 text-sm text-encre-900"
                                   data-chiffres>
                            <button type="submit"
                                    class="rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                                Écouler
                            </button>
                        </span>
                    </form>

                {% else %}
                    <span class="text-lg text-encre-900">{{ lot.ressource.libelle }}</span>
                    <span class="text-sm text-encre-500" data-chiffres>{{ lot.quantite }} en réserve</span>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endif %}
