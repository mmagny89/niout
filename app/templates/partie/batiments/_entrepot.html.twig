{# L'Entrepôt tient les matériaux et les ouvrages, **gouverne les carrières**,
   et arme les routes de terre. Le rival, quand il y en a un, rogne ce qui
   passe par elles : il se traite donc ici. #}
{{ include('partie/batiments/_entete.html.twig') }}
{% import 'partie/_sous_onglets.html.twig' as sous %}
{% set direction = directions[onglet.type.value] ?? null %}
{% set sections = [
    {cle: 'reserve', libelle: 'Réserve'},
    {cle: 'repartition', libelle: 'Répartition'},
    {cle: 'carrieres', libelle: 'Carrières'},
    {cle: 'routes', libelle: 'Routes'},
] %}
{% if direction %}
    {% set sections = sections|merge([{cle: 'direction', libelle: direction.chefs is empty ? 'Direction · vacante' : 'Direction'}]) %}
{% endif %}
{{ sous.debut('entrepot', partie.id, "Sections de l'Entrepôt", sections) }}
{{ sous.panneau('entrepot', 'reserve', true) }}

<h3 class="mt-8 text-xl text-encre-900">La réserve</h3>
{% import 'partie/batiments/_tuile_de_bord.html.twig' as tuiles %}
<div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:max-w-3xl">
    {{ tuiles.tuile('chantier', 'Matériaux et ouvrages', ville.materiaux,
        ville.materiaux, ville.plafondDesMateriaux, ville.materiauxPresqueSatures,
        'sur ' ~ ville.plafondDesMateriaux ~ ' que l\'Entrepôt peut tenir',
        'Toutes les ressources d\'une même réserve se partagent ce plafond. Au-delà, ce qui rentre se perd.') }}
    {{ tuiles.tuile('amelioration', 'Place libre', max(0, ville.plafondDesMateriaux - ville.materiaux), null, null, ville.materiauxPresqueSatures,
        'avant que le surplus ne se perde',
        'Écoulez, offrez ou agrandissez l\'Entrepôt avant qu\'il ne soit plein.') }}
</div>
{{ include('partie/batiments/_reserve_visuelle.html.twig', {vue: reserveDesMateriaux}) }}

<p class="mt-4 max-w-4xl text-sm text-encre-500">
    Les ressources d'une même réserve se partagent ce plafond : dix roseaux
    rangés, c'est dix de moins pour l'argile.
</p>
    </div>

{{ sous.panneau('entrepot', 'repartition', false) }}
{# La répartition des ressources vit ici, pas au Marché : c'est l'Entrepôt qui
   tient les stocks, et c'est d'un seul tableau qu'on veut décider de ce qu'on
   garde et de ce qui part. Le Marché ne garde que la vente à la main et le
   prix qu'on fait payer. #}
<h3 class="mt-8 text-xl text-encre-900">Ce que vous gardez, ce qui part</h3>
<p class="mt-2 max-w-4xl text-sm text-encre-500">
    Pour chaque ressource, dites <strong class="text-encre-700">combien vous en
    gardez</strong> : le surplus part au Marché de lui-même, jour de marché
    après jour de marché, jusqu'à ce que vos réserves y retombent. Rien n'est
    prélevé maintenant — la marchandise ne quitte la réserve qu'au moment
    d'être vendue.
</p>
{% if not aUnMarche %}
    <p class="mt-2 text-sm text-terre-600">
        Sans Marché, rien ne peut partir : ces seuils resteront sans effet
        jusqu'à ce que vous en dressiez un.
    </p>
{% endif %}

{% if repartition is empty %}
    <p class="mt-4 text-sm text-encre-500">Vos réserves sont vides.</p>
{% else %}
    {# Une carte par ressource : sa réserve en barre (ce qu'on garde en lapis, ce qui
       part en terre cuite), et un curseur pour fixer le seuil. Le champ numérique reste
       la source soumise ; la phrase dit en lettres combien partira. #}
    <ul class="mt-4 grid list-none grid-cols-1 gap-3 p-0 md:grid-cols-2 2xl:grid-cols-3">
        {% for ligne in repartition %}
            {% set garde = ligne.seuil is null ? ligne.enReserve : min(ligne.seuil, ligne.enReserve) %}
            {% set partGardee = ligne.enReserve > 0 ? (garde * 100 / ligne.enReserve)|round : 100 %}
            <li class="carte-vivante flex flex-col gap-2 rounded-sm border border-ocre-500/30 bg-sable-50 p-4">
                <div class="flex items-center gap-3">
                    {{ include('partie/_icone_ressource.html.twig', {ressource: ligne.ressource, taille: 52}) }}
                    <div class="min-w-0 flex-1">
                        <p class="font-display text-lg leading-tight text-encre-900">{{ ligne.ressource.libelle|capitalize }}</p>
                        <p class="text-xs text-encre-500" data-chiffres>{{ ligne.enReserve }} en réserve</p>
                    </div>
                    <span class="inline-flex items-center gap-1 text-sm text-encre-600" data-chiffres
                          data-infobulle="Le cours de base : ce que rapporte une unité vendue.">
                        {{ include('partie/_pictogramme.html.twig', {nom: 'deben', taille: 18}) }}
                        {{ ligne.prix }}
                    </span>
                </div>

                {# En cours de partie, la jauge du curseur dit déjà ce qu'on garde et ce qui part : la barre fixe la
                   doublerait. Elle ne reste que sur une partie échouée, où il n'y a plus de curseur. #}
                {% if not partie.estEnCours %}
                    <div class="flex h-2.5 w-full overflow-hidden rounded-full bg-ocre-500/20" aria-hidden="true">
                        <div class="h-full bg-lapis-500" style="width: {{ partGardee }}%"></div>
                        <div class="h-full bg-terre-500" style="width: {{ 100 - partGardee }}%"></div>
                    </div>
                {% endif %}

                {% if partie.estEnCours %}
                    <form method="post" action="{{ path('app_partie_reserve', {id: partie.id}) }}"
                          class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-2"
                          data-controller="curseur" data-curseur-mode-value="part" data-curseur-reserve-value="{{ ligne.enReserve }}"
                          data-curseur-seuil-value="{{ ligne.enReserve }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('reserve') }}">
                        <input type="hidden" name="onglet" value="{{ onglet.cle }}">
                        <input type="hidden" name="ressource" value="{{ ligne.ressource.value }}">
                        {# Le champ numérique doublait la jauge : la jauge seule se règle, au doigt comme au clavier
                           (flèches). Le champ caché reste la valeur soumise. #}
                        <input type="hidden" id="garde-{{ ligne.ressource.value }}" name="quantite"
                               value="{{ ligne.seuil is null ? ligne.enReserve : ligne.seuil }}" min="0"
                               data-curseur-target="champ">
                        {% if ligne.enReserve > 0 %}
                            <label for="garde-curseur-{{ ligne.ressource.value }}" class="flex basis-full items-baseline justify-between text-sm text-encre-600">
                                <span>Je garde</span>
                                <strong class="font-display text-xl font-normal text-encre-900" data-curseur-target="nombre" data-chiffres>{{ ligne.seuil is null ? ligne.enReserve : ligne.seuil }}</strong>
                            </label>
                            <input type="range" id="garde-curseur-{{ ligne.ressource.value }}" data-curseur-target="piste"
                                   data-action="input->curseur#deplacer" class="curseur basis-full">
                        {% endif %}
                        <p class="min-w-0 flex-1 text-xs {{ ligne.surplus > 0 ? 'text-terre-600' : 'text-encre-500' }}" data-chiffres data-curseur-target="surplus">
                            {% if ligne.seuil is null %}rien ne partira
                            {% elseif ligne.surplus > 0 %}{{ ligne.surplus }} partiront au Marché
                            {% else %}rien ne partira{% endif %}
                        </p>
                        {% if ligne.seuil is not null %}
                            <button type="submit" name="retirer" value="1"
                                    class="rounded-sm border border-ocre-500/40 px-3 py-1 text-sm text-encre-600 transition hover:bg-ocre-500/10">
                                Tout garder
                            </button>
                        {% endif %}
                        <button type="submit"
                                class="rounded-sm border border-lapis-500/50 px-3 py-1 text-sm text-lapis-600 transition hover:bg-lapis-500/10">
                            Fixer
                        </button>
                    </form>
                {% else %}
                    <p class="text-sm text-encre-600" data-chiffres>
                        On garde {{ ligne.seuil is null ? 'tout' : ligne.seuil }} ·
                        {{ ligne.surplus > 0 ? ligne.surplus ~ ' partent au Marché' : 'rien ne part' }}
                    </p>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endif %}
    </div>

{{ sous.panneau('entrepot', 'carrieres', false) }}
{{ include('partie/batiments/_exploitations.html.twig', {titreDuRecap: 'Vos carrières et vos mines', recapVide: 'Aucun filon reconnu. Les gisements se découvrent en explorant.'}) }}
    </div>

{{ sous.panneau('entrepot', 'routes', false) }}
{{ include('partie/batiments/_rival.html.twig') }}
{{ include('partie/batiments/_routes.html.twig') }}
    </div>

{% if direction %}
{{ sous.panneau('entrepot', 'direction', false) }}
{{ include('partie/batiments/_direction.html.twig') }}
    </div>

{% endif %}
</div>
