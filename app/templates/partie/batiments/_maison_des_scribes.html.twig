{# La Maison des scribes : ce qu'on y déchiffre, ce qu'on y enquête, et ce
   qu'elle ouvre de la clé de lecture. #}
{{ include('partie/batiments/_entete.html.twig') }}

{% import 'partie/_sous_onglets.html.twig' as sous %}
{% set direction = directions[onglet.type.value] ?? null %}
{% set sections = [
    {cle: 'afaire', libelle: 'À lire et à résoudre'},
    {cle: 'cle', libelle: 'Clé de lecture'},
    {cle: 'alphabet', libelle: 'Alphabet'},
    {cle: 'exercices', libelle: 'Exercices'},
] %}
{% if direction %}
    {% set sections = sections|merge([{cle: 'direction', libelle: direction.chefs is empty ? 'Direction · vacante' : 'Direction'}]) %}
{% endif %}
{{ sous.debut('scribes', partie.id, "Sections de la Maison des scribes", sections) }}
{{ sous.panneau('scribes', 'afaire', true) }}
{# **Ce que la ville sait de l'écriture, en tuiles** (la section « Les écritures de votre ville » redisait trois fois le même
   compte, sur sa barre, dans sa phrase et dans chaque onglet) : le rang d'érudition et ce qu'il rapporte, les signes appris,
   la clé et l'alphabet. La Résidence garde sa section, où l'on gouverne ; ici, où l'on apprend, les chiffres suffisent. #}
{% import 'partie/batiments/_tuile_de_bord.html.twig' as tuiles %}
{% set suivantDeLErudition = erudition.suivant %}
<div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
    {{ tuiles.tuile('prestige', 'Érudition', erudition.libelle, null, null, false,
        'l\'impôt du mois rapporte ' ~ erudition.bonusDImpot ~ ' % de plus',
        erudition.description) }}
    {{ tuiles.tuile('enigme', 'Signes appris', nombreDeSignesAppris ~ ' / ' ~ totalDesSignes,
        nombreDeSignesAppris, totalDesSignes, false,
        suivantDeLErudition
            ? 'encore ' ~ (suivantDeLErudition.seuilDEntree - nombreDeSignesAppris) ~ ' pour devenir ' ~ suivantDeLErudition.libelle|lower ~ ' (+' ~ (suivantDeLErudition.bonusDImpot - erudition.bonusDImpot) ~ ' % d\'impôt)'
            : 'vos scribes lisent tout',
        'Chaque niveau de la Maison des scribes, chaque inscription déchiffrée et chaque énigme résolue ouvrent de nouveaux signes.') }}
    {{ tuiles.tuile('quinzaine', 'Clé de lecture', cleDeLecture|length ~ ' / ' ~ signesEnTout,
        cleDeLecture|length, signesEnTout, false,
        'les signes qui montrent une chose',
        'Les signes de la liste de Gardiner que vos scribes savent lire : chacun porte son vrai code et son vrai sens.') }}
    {{ tuiles.tuile('echange', 'Alphabet', alphabet|length ~ ' / ' ~ signesDeLAlphabetEnTout,
        alphabet|length, signesDeLAlphabetEnTout, false,
        'les signes qui notent un son',
        'Les vingt-quatre signes qui notent un son, et non une chose : la vraie porte d\'entrée de la lecture hiéroglyphique.') }}
</div>


        {# Le fil rouge d'abord : c'est ce que le roi attend, et un fil
   dont on ne sait pas ce qu'il demande n'est qu'une décoration. #}
{% if filRouge %}
    <div class="carte-vivante mt-4 flex items-start gap-4 rounded-sm border-l-4 border-terre-500 bg-terre-500/5 px-5 py-4">
        {{ include('partie/_pictogramme.html.twig', {nom: 'pharaon', taille: 44}) }}
        <div>
            <h3 class="font-display text-lg text-encre-900">{{ filRouge.libelle }}</h3>
            <p class="mt-1 text-sm text-encre-700">{{ filRouge.consigne }}</p>
        </div>
    </div>
{% endif %}

{# L'inscription passe avant la clé : c'est ce qu'on vient
   faire ici, la clé n'est que l'outil. #}
{% if inscription %}
    <h3 class="mt-8 text-xl text-encre-900">Une inscription à lire</h3>
    <p class="mt-2 max-w-4xl text-sm text-encre-500">{{ inscription.provenance }}</p>

    <form method="post" action="{{ path('app_partie_dechiffrer', {id: partie.id}) }}"
          class="mt-4 rounded-sm border border-ocre-500/30 bg-sable-50 p-5"
          data-controller="dechiffrage">
        <input type="hidden" name="_token" value="{{ csrf_token('dechiffrer') }}">
        <input type="hidden" name="onglet" value="{{ onglet.cle }}">
        <input type="hidden" name="inscription" value="{{ inscription.value }}">
        <input type="hidden" name="ordre" value="" data-dechiffrage-target="reponse">

        <p class="inscription-gravee text-center font-hieroglyphes text-5xl leading-tight text-encre-900" aria-hidden="true">
            {%- for signe in inscription.signes %}{{ signe.signe }}{% endfor -%}
        </p>
        <p class="mt-1 text-center text-xs text-encre-500">
            <span data-chiffres>{{ inscription.signes|length }}</span> signes, gravés dans cet ordre.
        </p>

        <p class="mt-5 text-sm text-encre-600">
            Placez les sens dans l'ordre des signes. Cliquez un mot pour le
            poser, une case pour la vider — ou faites-les glisser.
        </p>

        <ol class="mt-3 flex flex-wrap justify-center gap-3 list-none p-0">
            {% for rang in 1..inscription.signes|length %}
                <li>
                    <button type="button" data-dechiffrage-target="case"
                            data-action="click->dechiffrage#retirer dragover->dechiffrage#survoler drop->dechiffrage#deposer"
                            aria-label="Case {{ rang }}, vide"
                            class="flex h-16 w-16 items-center justify-center rounded-sm border-2 border-dashed
                                   border-ocre-500/50 bg-sable-100 font-hieroglyphes text-3xl text-encre-900"></button>
                </li>
            {% endfor %}
        </ol>

        <ul class="mt-5 flex flex-wrap justify-center gap-2 list-none p-0"
            data-dechiffrage-target="reserve">
            {% for signe in melange %}
                <li>
                    <button type="button" draggable="true"
                            data-signe="{{ signe.value }}"
                            data-glyphe="{{ signe.signe }}"
                            data-libelle="{{ signe.libelle }}"
                            data-action="click->dechiffrage#placer dragstart->dechiffrage#prendre"
                            class="rounded-sm border border-ocre-500/40 bg-sable-100 px-3 py-2 text-sm
                                   text-encre-700 hover:bg-ocre-300/20">
                        {{ signe.libelle }}
                    </button>
                </li>
            {% endfor %}
        </ul>

        <div class="mt-5 text-center">
            <button type="submit" data-dechiffrage-target="valider" disabled
                    class="inline-flex items-center gap-2 rounded-sm bg-terre-500 px-5 py-2 text-sm font-medium text-sable-50
                           hover:bg-terre-600 disabled:cursor-not-allowed disabled:opacity-40">
                {{ include('partie/_pictogramme.html.twig', {nom: 'enigme', taille: 22}) }}
                Lire l'inscription
            </button>
        </div>
    </form>
{% elseif inscriptionsLues > 0 %}
    <h3 class="mt-8 text-xl text-encre-900">Rien à lire pour l'instant</h3>
    <p class="mt-2 max-w-4xl text-sm text-encre-500">
        Vos scribes ont lu tout ce qui leur est passé sous les yeux.
        De nouveaux signes ouvriront de nouvelles inscriptions.
    </p>
{% endif %}

{% if inscriptionsLues > 0 %}
    <details class="mt-8">
        <summary class="cursor-pointer text-xl text-encre-900">Déjà lues <span class="text-sm text-encre-500" data-chiffres>({{ inscriptionsLues }})</span></summary>
    <ul class="mt-3 space-y-2 list-none p-0">
        {% for lue in ville.inscriptionsDechiffrees %}
            <li class="rounded-sm border border-ocre-500/30 bg-sable-50 px-4 py-3 text-sm">
                <span class="font-hieroglyphes text-2xl align-middle" aria-hidden="true">
                    {%- for signe in lue.signes %}{{ signe.signe }}{% endfor -%}
                </span>
                <span class="ml-3 text-encre-700">{{ lue.lecture }}</span>
            </li>
        {% endfor %}
    </ul>
    </details>
{% endif %}

{% if dossiers is not empty %}
    <h3 class="mt-8 text-xl text-encre-900">Dossiers d'enquête</h3>
    <p class="mt-2 max-w-4xl text-sm text-encre-500">
        Ce que vos gens ont rapporté. Tout ne concourt pas :
        c'est à vous de démêler ce qui tient de ce qui égare.
    </p>

    <ul class="mt-4 grid list-none grid-cols-1 gap-3 p-0 md:grid-cols-2">
        {% for entree in dossiers %}
            {% set dossier = entree.dossier %}
            <li class="carte-vivante rounded-sm border border-ocre-500/30 bg-sable-50 p-4">
                <div class="flex flex-wrap items-baseline justify-between gap-3">
                    <h3 class="flex items-center gap-2 font-display text-lg text-encre-900">
                        {{ include('partie/_pictogramme.html.twig', {nom: 'enigme', taille: 32}) }}
                        {{ dossier.enquete.libelle }}
                        {% if dossier.enquete.estPrincipale %}
                            <span class="ml-2 text-xs text-terre-600">fil rouge</span>
                        {% endif %}
                    </h3>
                    <span class="flex items-center gap-2 text-sm text-encre-500" data-chiffres>
                        {# Un point par indice requis : plein pour ceux qui concordent. #}
                        <span class="flex gap-1" aria-hidden="true">
                            {% for rang in 1..max(dossier.enquete.indicesRequis, 1) %}
                                <span class="case-vivante size-3 rounded-full {{ rang <= dossier.concordantsReunis ? 'bg-lapis-500' : 'border border-ocre-500/60' }}" style="--i: {{ rang }}"></span>
                            {% endfor %}
                        </span>
                        {{ dossier.concordantsReunis }} / {{ dossier.enquete.indicesRequis }}
                        indices concordants
                    </span>
                </div>

                <p class="mt-2 text-sm text-encre-600">{{ dossier.enquete.question }}</p>

                <ul class="mt-3 space-y-2 list-none p-0">
                    {% for indice in dossier.indices %}
                        <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-l-2 border-ocre-500/40 pl-3 text-sm">
                            <span class="text-encre-700">{{ indice.texte }}</span>
                            <span class="text-xs text-encre-500">
                                {{ indice.source.libelle }} · {{ indice.nature.libelleAffiche|lower }}
                            </span>
                        </li>
                    {% endfor %}
                </ul>

                {% if dossier.statut.value != 'en_cours' %}
                    <p class="mt-3 text-sm {{ dossier.statut.value == 'resolue' ? 'text-lapis-500' : 'text-terre-600' }}">
                        {{ dossier.statut.libelle }}. {{ dossier.enquete.denouement }}
                    </p>
                {% elseif entree.peutConclure %}
                    <p class="mt-4 text-sm text-encre-700">
                        Vous en savez assez pour trancher.
                        {% if dossier.enquete.estPrincipale %}
                            Se tromper coûtera deux quinzaines, et rien d'autre.
                        {% else %}
                            Se tromper enterrera l'affaire.
                        {% endif %}
                    </p>

                    <form method="post" action="{{ path('app_partie_conclure', {id: partie.id}) }}"
                          class="mt-3 flex flex-col gap-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('conclure') }}">
                        <input type="hidden" name="onglet" value="{{ onglet.cle }}">
                        <input type="hidden" name="enquete" value="{{ dossier.enquete.value }}">

                        {% for conclusion in entree.conclusions %}
                            <button type="submit" name="conclusion" value="{{ conclusion }}"
                                    class="rounded-sm border border-ocre-500/40 bg-sable-100 px-4 py-2 text-left
                                           text-sm text-encre-700 hover:bg-ocre-300/20">
                                {{ conclusion }}
                            </button>
                        {% endfor %}
                    </form>
                {% elseif dossier.rejouableAuCycle > partie.cycle %}
                    <p class="mt-3 text-sm text-encre-500">
                        Vos scribes reprennent le dossier depuis le début : encore
                        <span data-chiffres>{{ dossier.rejouableAuCycle - partie.cycle }}</span>
                        quinzaine(s).
                    </p>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endif %}

{{ include('partie/_enigmes.html.twig', {enigmes: enigmesDesScribes, titre: 'Questions en suspens'}) }}
    </div>

{{ sous.panneau('scribes', 'cle', false) }}
<h3 class="mt-8 text-xl text-encre-900">Clé de lecture</h3>
<p class="mt-2 max-w-4xl text-sm text-encre-500">
    Les signes que vos scribes savent lire, tirés de la liste de
    Gardiner — la classification de référence des hiéroglyphes.
    Chacun porte son vrai code et son vrai sens : ce que vous
    apprenez ici est ce qu'un égyptologue lirait.
</p>

{% if prochainSigne %}
    <p class="mt-3 rounded-sm border-l-4 border-lapis-500 bg-lapis-500/5 px-4 py-2 text-sm text-encre-600">
        Monter la Maison des scribes ouvrirait le signe suivant :
        <span class="font-hieroglyphes text-2xl align-middle">{{ prochainSigne.signe }}</span>
        {{ prochainSigne.libelle|lower }} ({{ prochainSigne.codeDeGardiner }}).
    </p>
{% endif %}

<ul class="mt-4 grid gap-3 list-none p-0 sm:grid-cols-2 lg:grid-cols-3">
    {% for symbole in cleDeLecture %}
        <li class="carte-vivante signe-carte flex gap-4 rounded-sm border border-ocre-500/30 bg-sable-50 p-4"
            data-infobulle="{{ symbole.codeDeGardiner }} — {{ symbole.libelle }}">
            <span class="signe-plaque font-hieroglyphes text-4xl leading-none text-encre-900"
                  aria-hidden="true">{{ symbole.signe }}</span>
            <span>
                <span class="block text-encre-900">{{ symbole.libelle }}</span>
                <span class="block text-xs text-encre-500" data-chiffres>{{ symbole.codeDeGardiner }}</span>
                <span class="mt-1 block text-sm text-encre-600">{{ symbole.sens }}</span>

                {# **Ce n'est pas un doublon, c'est la leçon** : un même dessin
                   sert tantôt à montrer une chose, tantôt à noter un son. #}
                {% if symbole.sonDeLAlphabet %}
                    <span class="mt-2 block text-xs text-lapis-500">
                        Note aussi le son <strong>{{ symbole.sonDeLAlphabet.translitteration }}</strong>
                        dans l'alphabet des scribes.
                    </span>
                {% endif %}
            </span>
        </li>
    {% endfor %}
</ul>

{# **La stèle du pharaon** (doc 09). Chaque commanditaire en a laissé une, et
   le document veut que les déchiffrages y fassent écho plutôt que d'inventer
   de toutes pièces.

   Elle n'est **pas** l'inscription qu'on déchiffre : les dalles du jeu restent
   des rébus — signes vrais, combinaisons inventées —, et la stèle est ce
   qu'elles rappellent. Les confondre laisserait croire au joueur qu'il lit de
   l'égyptien.

   Ce qui s'affiche est un **résumé**, jamais une traduction : le doc 09 le
   demande deux fois, et cela vaut aussi pour les traductions anciennes. #}
{% if stele %}
    <h3 class="mt-10 text-xl text-encre-900">{{ stele.nom }}</h3>
    <p class="mt-2 max-w-4xl text-sm text-encre-500">
        {{ stele.lieu }}.
    </p>

    <div class="mt-3 rounded-sm border-l-4 border-or-300 bg-or-300/5 px-5 py-4">
        <p class="text-sm text-encre-700">{{ stele.contenu }}</p>
        <p class="mt-3 text-xs text-encre-500">
            Résumé de ce que {{ stele.estUneStele ? 'la pierre' : 'le document' }} dit,
            jamais une traduction. Les dalles que vos scribes déchiffrent ici en
            reprennent l'esprit : leurs signes sont vrais, mais ce qu'ils forment
            est un rébus, pas de l'égyptien.
        </p>
    </div>
{% endif %}
    </div>

{{ sous.panneau('scribes', 'alphabet', false) }}
{# **L'alphabet des scribes** — la seconde piste du doc 10, celle des sons.

   Elle ne se mélange jamais à la clé de lecture, alors même que six dessins
   leur sont communs : un même signe n'y veut pas dire la même chose. `N35` est
   « l'eau » dans la clé, et le son *n* ici. Le même glyphe paraît donc dans les
   deux tables, avec deux lectures — **ne pas dédupliquer**, c'est justement ce
   qui montre que l'écriture égyptienne est mixte. #}
<h3 class="mt-10 text-xl text-encre-900">L'alphabet des scribes</h3>
<p class="mt-2 max-w-4xl text-sm text-encre-500">
    Les vingt-quatre signes qui notent un <em>son</em>, et non une chose : la
    vraie porte d'entrée de la lecture hiéroglyphique, celle par laquelle on
    passe encore aujourd'hui.
</p>
<details class="mt-2 text-sm text-encre-500">
    <summary class="cursor-pointer text-encre-700">Pourquoi trois dessins se retrouvent-ils dans les deux tables ?</summary>
    <p class="mt-2">
    <strong class="text-encre-700">Trois dessins se retrouvent dans les deux
    tables</strong>, et ce n'est pas une redite : l'écriture égyptienne est
    mixte, un même signe y servant tantôt à montrer une chose, tantôt à noter un
    son. La bouche en est le cas le plus net — elle dit « bouche », et elle note
    le <em>r</em>.
</p>
</details>

{# La leçon fondatrice : écrire le nom du jeu. Elle se retente — remettre
   quatre signes dans l'ordre est un exercice, pas une devinette. #}
<div class="mt-4 rounded-sm border border-lapis-500/40 bg-lapis-500/5 p-5">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h4 class="font-display text-lg text-encre-900">Écrire « Niout »</h4>
        {% if nioutDejaEcrite %}
            <span class="text-sm text-lapis-500">Leçon sue</span>
        {% endif %}
    </div>

    <p class="mt-2 text-sm text-encre-600">
        Le nom de cette ville, et celui de ce jeu. Il s'écrit avec quatre signes,
        dans l'ordre <strong class="text-encre-900">n · i · w · t</strong> —
        l'égyptien ne notait pas les voyelles. Placez-les.
    </p>

    {% if partie.estEnCours %}
        <form method="post" action="{{ path('app_partie_niout', {id: partie.id}) }}"
              class="mt-4" data-controller="dechiffrage">
            <input type="hidden" name="_token" value="{{ csrf_token('niout') }}">
            <input type="hidden" name="onglet" value="{{ onglet.cle }}">
            <input type="hidden" name="ordre" value="" data-dechiffrage-target="reponse">

            <ol class="flex flex-wrap justify-center gap-3 list-none p-0">
                {% for son in ['n', 'i', 'w', 't'] %}
                    <li class="text-center">
                        <button type="button" data-dechiffrage-target="case"
                                data-action="click->dechiffrage#retirer dragover->dechiffrage#survoler drop->dechiffrage#deposer"
                                aria-label="Case {{ loop.index }}, le son {{ son }}, vide"
                                class="flex h-16 w-16 items-center justify-center rounded-sm border-2 border-dashed
                                       border-lapis-500/50 bg-sable-50 font-hieroglyphes text-3xl text-encre-900"></button>
                        <span class="mt-1 block text-sm text-encre-500">{{ son }}</span>
                    </li>
                {% endfor %}
            </ol>

            <ul class="mt-5 flex flex-wrap justify-center gap-2 list-none p-0"
                data-dechiffrage-target="reserve">
                {% for signe in leconDeNiout %}
                    <li>
                        <button type="button" draggable="true"
                                data-signe="{{ signe.value }}"
                                data-glyphe="{{ signe.signe }}"
                                data-libelle="{{ signe.objet }}, le son {{ signe.translitteration }}"
                                data-action="click->dechiffrage#placer dragstart->dechiffrage#prendre"
                                aria-label="{{ signe.objet }}, le son {{ signe.translitteration }}"
                                class="rounded-sm border border-ocre-500/40 bg-sable-100 px-4 py-2
                                       font-hieroglyphes text-3xl text-encre-900 hover:bg-ocre-300/20">
                            {{ signe.signe }}
                        </button>
                    </li>
                {% endfor %}
            </ul>

            <div class="mt-5 text-center">
                <button type="submit" data-dechiffrage-target="valider" disabled
                        class="inline-flex items-center gap-2 rounded-sm bg-lapis-500 px-5 py-2 text-sm font-medium text-sable-50
                               hover:bg-lapis-600 disabled:cursor-not-allowed disabled:opacity-40">
                    {{ include('partie/_pictogramme.html.twig', {nom: 'pharaon', taille: 22}) }}
                    Écrire le nom
                </button>
            </div>
        </form>
    {% endif %}
</div>

{# **Écrire le nom de la famille**, à la manière des cartouches de musée.

   La transcription est **entière** dès que la Maison des scribes est dressée —
   ce sont les scribes qui écrivent, pas le joueur —, et les signes que la ville
   n'a pas encore appris s'y montrent en retrait. Les cacher la rendrait
   invisible jusqu'au niveau 6 ou 7 : les lettres d'un nom sont dispersées dans
   l'ordre des grammaires, et il faut presque tout l'alphabet pour en écrire un
   entier. #}
<div class="mt-4 rounded-sm border border-ocre-500/30 bg-sable-50 p-5">
    <h4 class="font-display text-lg text-encre-900">Votre nom, écrit par vos scribes</h4>

    {% if nomTranscrit.signes is empty %}
        <p class="mt-2 text-sm text-encre-500">
            Rien de ce nom ne s'écrit avec ces signes.
        </p>
    {% else %}
        <ol class="mt-4 flex flex-wrap items-end justify-center gap-2 list-none p-0">
            {% for signe in nomTranscrit.signes %}
                {% set connu = signe in signesConnus %}
                <li class="text-center" title="{{ signe.objet }} ({{ signe.codeDeGardiner }}), le son {{ signe.translitteration }}">
                    <span class="block font-hieroglyphes text-4xl leading-none
                                 {{ connu ? 'text-encre-900' : 'text-encre-500/40' }}">{{ signe.signe }}</span>
                    <span class="mt-1 block text-xs {{ connu ? 'text-encre-500' : 'text-encre-500/80' }}">
                        {{ signe.translitteration }}
                    </span>
                </li>
            {% endfor %}
        </ol>

        {% set inconnus = nomTranscrit.signes|filter(s => s not in signesConnus) %}
        {% if inconnus|length > 0 %}
            <p class="mt-3 text-sm text-encre-500" data-chiffres>
                {% if inconnus|length == 1 %}
                    <span class="text-encre-700">Un</span> de ces signes n'est pas
                    encore appris de vos scribes — il paraît en creux.
                {% else %}
                    <span class="text-encre-700">{{ inconnus|length }}</span> de ces
                    signes ne sont pas encore appris de vos scribes — ils
                    paraissent en creux.
                {% endif %}
                Montez la Maison des scribes pour lire votre nom en entier.
            </p>
        {% endif %}

        {% if nomTranscrit.ecartes is not empty %}
            <p class="mt-2 text-sm text-terre-600">
                Écarté, faute de signe correspondant :
                {% for caractere in nomTranscrit.ecartes %}« {{ caractere }} »{{ not loop.last ? ', ' : '' }}{% endfor %}.
                Aucun signe n'est inventé pour boucher un trou.
            </p>
        {% endif %}
    {% endif %}

    <details class="mt-3 text-sm text-encre-500">
        <summary class="cursor-pointer text-encre-700">Une convention de musée, pas de l'égyptologie</summary>
    <p class="mt-2">
        C'est la convention des musées, pas de l'égyptologie : l'égyptien ne
        notait <strong class="text-encre-700">pas les voyelles</strong>, et un
        scribe du Nouvel Empire aurait cherché des signes valant deux ou trois
        sons à la fois. Ce que vous lisez là sert à reconnaître les signes, jamais
        à traduire un nom.
    </p>
    </details>
</div>

{% if prochainSigneDeLAlphabet %}
    <p class="mt-4 rounded-sm border-l-4 border-lapis-500 bg-lapis-500/5 px-4 py-2 text-sm text-encre-600">
        Monter la Maison des scribes ouvrirait
        <span data-chiffres>{{ signesParNiveauDAlphabet }}</span> signes de plus,
        à commencer par
        <span class="font-hieroglyphes text-2xl align-middle">{{ prochainSigneDeLAlphabet.signe }}</span>
        {{ prochainSigneDeLAlphabet.objet|lower }} ({{ prochainSigneDeLAlphabet.codeDeGardiner }}),
        le son {{ prochainSigneDeLAlphabet.translitteration }}.
    </p>
{% endif %}


<ul class="mt-4 grid gap-3 list-none p-0 sm:grid-cols-2 lg:grid-cols-3">
    {% for signe in alphabet %}
        <li class="carte-vivante signe-carte flex gap-4 rounded-sm border border-ocre-500/30 bg-sable-50 p-4"
            data-infobulle="{{ signe.codeDeGardiner }} — le son {{ signe.translitteration }} ({{ signe.objet|lower }})">
            <span class="signe-plaque font-hieroglyphes text-4xl leading-none text-encre-900"
                  aria-hidden="true">{{ signe.signe }}</span>
            <span>
                <span class="block text-encre-900">
                    {{ signe.translitteration }}
                    <span class="text-sm text-encre-500">— {{ signe.son }}</span>
                </span>
                <span class="block text-xs text-encre-500" data-chiffres>{{ signe.codeDeGardiner }}</span>
                <span class="mt-1 block text-sm text-encre-600">
                    {{ signe.objet }}{% if signe.objetIncertain %} <span class="text-encre-500">(débattu)</span>{% endif %}
                </span>

                {% if signe.dessinDeLaCle %}
                    <span class="mt-2 block text-xs text-lapis-500">
                        Le même dessin sert de « {{ signe.dessinDeLaCle.libelle|lower }} »
                        dans la clé de lecture.
                    </span>
                {% endif %}
            </span>
        </li>
    {% endfor %}
</ul>
    </div>

{{ sous.panneau('scribes', 'exercices', false) }}
{# **Pratiquer, pas seulement regarder** : la grille des signes montre, ces deux
   exercices font retrouver. Les séries se tirent à l'affichage et la graine
   revient avec les réponses ; le serveur recompose les mêmes questions pour
   corriger. Une récompense par exercice et par quinzaine, jamais plus. #}
<div class="mt-4 grid gap-6 lg:grid-cols-2">
    <section aria-labelledby="exercice-sons-titre">
        <h3 id="exercice-sons-titre" class="text-xl text-encre-900">Sons et signes</h3>
        <p class="mt-2 text-sm text-encre-500" data-chiffres>
            {{ questionsDesSons }} questions sur les signes que vos scribes connaissent.
            Une récompense à partir de {{ constant('App\\Game\\ExerciceDesSons::SEUIL_DE_REUSSITE') }}
            bonnes réponses, une fois par quinzaine ; on peut recommencer, la série change.
        </p>

        {% if partie.estEnCours %}
            <form method="post" action="{{ path('app_partie_exercice_sons', {id: partie.id}) }}" class="mt-4">
                <input type="hidden" name="_token" value="{{ csrf_token('exercice-sons') }}">
                <input type="hidden" name="onglet" value="{{ onglet.cle }}">
                <input type="hidden" name="graine" value="{{ graineDesSons }}">

                <ol class="grid list-none gap-3 p-0 sm:grid-cols-2">
                    {% for question in serieDesSons %}
                        {% set rang = loop.index0 %}
                        <li>
                            <fieldset class="h-full rounded-sm border border-ocre-500/30 bg-sable-50 p-3">
                                <legend class="px-1 text-sm text-encre-900">
                                    <span class="text-encre-500" data-chiffres>{{ loop.index }}.</span>
                                    {{ question.enonce }}
                                </legend>
                                {% if question.glyphe %}
                                    <p class="text-center font-hieroglyphes text-4xl leading-none text-encre-900" aria-hidden="true">{{ question.glyphe }}</p>
                                {% endif %}
                                <div class="mt-2 grid gap-1">
                                    {% for option in question.options %}
                                        <label class="flex cursor-pointer items-center gap-2 rounded-sm border border-transparent px-2 py-1 text-sm text-encre-700 transition hover:bg-ocre-300/20
                                                 has-checked:border-lapis-500/50 has-checked:bg-lapis-500/10">
                                            <input type="radio" name="reponse[{{ rang }}]" value="{{ option.valeur }}" required>
                                            <span class="{{ option.glyphe ? 'font-hieroglyphes text-2xl leading-none' : '' }}">{{ option.libelle }}</span>
                                        </label>
                                    {% endfor %}
                                </div>
                            </fieldset>
                        </li>
                    {% endfor %}
                </ol>

                <button type="submit"
                        class="mt-4 rounded-sm bg-lapis-500 px-5 py-2 text-sm font-medium text-sable-50 hover:bg-lapis-600">
                    Corriger
                </button>
            </form>
        {% endif %}
    </section>

    <section aria-labelledby="exercice-cartouche-titre">
        <h3 id="exercice-cartouche-titre" class="text-xl text-encre-900">Lire un cartouche</h3>
        <p class="mt-2 text-sm text-encre-500">
            Un vrai nom de trône, signe par signe. Un cartouche mêle des
            <strong class="text-encre-700">sons</strong> à des
            <strong class="text-encre-700">mots entiers</strong> : dites ce que
            chaque signe y fait. Une récompense si tout est juste, une fois par
            quinzaine.
        </p>

        {% if lectureDeCartouche and partie.estEnCours %}
            <form method="post" action="{{ path('app_partie_lecture_cartouche', {id: partie.id}) }}" class="mt-4">
                <input type="hidden" name="_token" value="{{ csrf_token('lecture-cartouche') }}">
                <input type="hidden" name="onglet" value="{{ onglet.cle }}">
                <input type="hidden" name="graine" value="{{ graineDeLecture }}">

                <p class="rounded-sm border border-or-300/60 bg-or-300/5 px-4 py-3 text-center font-hieroglyphes text-4xl leading-none text-encre-900"
                   aria-label="Cartouche de {{ lectureDeCartouche.cartouche.lecture }}">
                    <span aria-hidden="true">{{ lectureDeCartouche.cartouche.signes }}</span>
                </p>
                <p class="mt-1 text-center text-xs text-encre-500">
                    Le nom de trône de {{ lectureDeCartouche.cartouche.lecture }} — que vous lirez après.
                </p>

                <ul class="mt-4 grid list-none gap-2 p-0">
                    {% for signe in lectureDeCartouche.signes %}
                        <li class="flex flex-wrap items-center gap-3 rounded-sm border border-ocre-500/30 bg-sable-50 px-3 py-2">
                            <span class="font-hieroglyphes text-3xl leading-none text-encre-900" aria-hidden="true">{{ signe.glyphe }}</span>
                            <label for="lecture-{{ signe.code }}" class="text-xs text-encre-500" data-chiffres>
                                signe {{ signe.code }}
                            </label>
                            <select id="lecture-{{ signe.code }}" name="reponse[{{ signe.code }}]" required
                                    class="ml-auto min-w-48 rounded-sm border border-ocre-500/40 bg-sable-50 px-2 py-1.5 text-sm text-encre-900">
                                <option value="">— que fait-il ici ? —</option>
                                {% for option in lectureDeCartouche.options %}
                                    <option value="{{ option.valeur }}">{{ option.libelle }}</option>
                                {% endfor %}
                            </select>
                        </li>
                    {% endfor %}
                </ul>

                <button type="submit"
                        class="mt-4 rounded-sm bg-lapis-500 px-5 py-2 text-sm font-medium text-sable-50 hover:bg-lapis-600">
                    Lire le cartouche
                </button>
            </form>
        {% endif %}
    </section>
</div>
    </div>

{% if direction %}
{{ sous.panneau('scribes', 'direction', false) }}
{{ include('partie/batiments/_direction.html.twig') }}
    </div>
{% endif %}
</div>
