{% extends 'partie/_layout.html.twig' %}

{% block title %}Territoire {{ ville.avecPreposition }} — Niout{% endblock %}

{% block body %}
    {# Géométrie mesurée sur la planche « tuiles » du Drive. Le losange occupe
       174 × 140 px dans une cellule de 189 × 206 : le pas vaut donc la moitié
       de chaque dimension. Un pas plus grand écarterait les tuiles, et
       l'épaisseur du prisme masquerait mal les marches ainsi créées. #}
    {% set cellule = { largeur: 174, hauteur: 185 } %}
    {% set pas = { x: 87, y: 70 } %}
    {% set cote = ville.tailleGrille %}
    {% set origineX = (cote - 1) * pas.x %}

    <section class="mx-auto w-full max-w-5xl px-5 py-10">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
            <h1 class="text-3xl text-encre-900">Le territoire {{ ville.avecPreposition }}</h1>
            <a href="{{ path('app_partie_ville', {id: partie.id}) }}" class="text-sm text-lapis-500">
                Bâtiments {{ ville.avecPreposition }}
            </a>
        </div>

        <p class="mt-2 text-sm text-encre-500">
            {{ cote }} × {{ cote }} cases. Cliquez votre ville pour en gérer les
            bâtiments ; les dalles gravées de hiéroglyphes attendent un éclaireur.
        </p>

        {# La carte déborde en largeur sur les grandes régions : elle défile
           dans son propre conteneur, jamais la page entière. #}
        <div class="mt-6 overflow-x-auto">
            <div class="relative mx-auto"
                 style="width: {{ 2 * (cote - 1) * pas.x + cellule.largeur }}px;
                        height: {{ 2 * (cote - 1) * pas.y + cellule.hauteur }}px;">

                {# Couche visible. Les tuiles se recouvrent : elles ne captent
                   aucun clic, sinon celles du premier plan voleraient ceux des
                   cases situées derrière. #}
                {% for zone in zones %}
                    <img src="{{ asset('images/tuiles/' ~ (zone.porteLaVille ? 'ville' : (zone.estDecouverte ? zone.terrain.tuile : 'brouillard')) ~ '.png') }}"
                         alt=""
                         class="pointer-events-none absolute select-none"
                         style="left: {{ origineX + (zone.x - zone.y) * pas.x }}px;
                                top: {{ (zone.x + zone.y) * pas.y }}px;
                                width: {{ cellule.largeur }}px;">
                {% endfor %}

                {# Couche cliquable, découpée à la forme exacte du losange. Les
                   losanges pavent le plan sans se chevaucher : chaque point de
                   la carte appartient donc à une seule case, et le clic tombe
                   toujours juste. #}
                {% for zone in zones %}
                    {% set estSelectionnee = zoneDetaillee and zoneDetaillee.x == zone.x and zoneDetaillee.y == zone.y %}
                    <a href="{{ zone.porteLaVille
                           ? path('app_partie_ville', {id: partie.id})
                           : path('app_partie_carte', {id: partie.id, zone: zone.x ~ '-' ~ zone.y}) ~ '#case' }}"
                       class="absolute block transition-colors
                              {{ estSelectionnee ? 'bg-or-300/45' : 'hover:bg-sable-50/35' }}"
                       style="left: {{ origineX + (zone.x - zone.y) * pas.x }}px;
                              top: {{ (zone.x + zone.y) * pas.y }}px;
                              width: {{ cellule.largeur }}px;
                              height: {{ cellule.hauteur }}px;
                              clip-path: polygon(50% 15%, 100% 52%, 50% 89%, 0% 52%);"
                       {{ zone.porteLaVille ? 'title="Entrer dans la ville"' : '' }}
                       aria-label="{{ zone.porteLaVille
                           ? 'Entrer dans ' ~ ville.nom
                           : 'Case ' ~ zone.x ~ ', ' ~ zone.y ~ ' — ' ~ (zone.estDecouverte ? zone.terrain.libelle : 'inexplorée') }}"></a>
                {% endfor %}
            </div>
        </div>

        {% if ville.expeditions|length > 0 %}
            <section class="mt-8">
                <h2 class="text-xl text-encre-900">Expéditions en route</h2>
                <ul class="mt-3 space-y-2 list-none p-0">
                    {% for expedition in ville.expeditions %}
                        <li class="rounded-sm border border-ocre-500/40 bg-ocre-300/10 px-5 py-3">
                            <div class="flex flex-wrap items-baseline justify-between gap-3 text-sm">
                                <span class="text-encre-900">
                                    {{ expedition.role.libelle }} vers la case
                                    <span data-chiffres>{{ expedition.destination.x }}, {{ expedition.destination.y }}</span>
                                </span>
                                <span class="text-encre-500" data-chiffres>
                                    encore {{ expedition.cyclesRestants }} cycle{{ expedition.cyclesRestants > 1 ? 's' : '' }}
                                </span>
                            </div>
                            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-sm bg-ocre-500/20">
                                <div class="h-full bg-lapis-500" style="width: {{ expedition.pourcentageDAvancement }}%"></div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        <div id="case" class="mt-8">
            {% if zoneDetaillee %}
                <article class="rounded-sm border border-ocre-500/30 bg-sable-50 p-6">
                    <div class="flex flex-wrap items-baseline justify-between gap-3">
                        <h2 class="font-display text-xl text-encre-900">
                            {% if zoneDetaillee.porteLaVille %}
                                {{ ville.nom }}
                            {% elseif zoneDetaillee.estDecouverte %}
                                {{ zoneDetaillee.terrain.libelle }}
                            {% else %}
                                Territoire inexploré
                            {% endif %}
                        </h2>
                        <span class="text-sm text-encre-500" data-chiffres>
                            case {{ zoneDetaillee.x }}, {{ zoneDetaillee.y }}
                            {% if not zoneDetaillee.porteLaVille %}
                                · à {{ zoneDetaillee.distanceDepuis(ville.zoneDeLaVille) }} de la ville
                            {% endif %}
                        </span>
                    </div>

                    {# Une case sous brouillard ne dit rien de son terrain ni de
                       son contenu : c'est justement ce que l'éclaireur va
                       chercher. #}
                    <p class="mt-3 text-sm text-encre-600">
                        {% if zoneDetaillee.porteLaVille %}
                            Votre ville se dresse ici.
                        {% elseif not zoneDetaillee.estDecouverte %}
                            Nul ne sait ce qui s'y trouve. Une reconnaissance le dira.
                        {% elseif zoneDetaillee.porteUnChamp %}
                            {% set etape = zoneDetaillee.etapeDuChamp(partie.dateDeJeu.saison, partie.dateDeJeu.rangDansLaSaison) %}
                            Un champ y est établi, semé de <strong>{{ zoneDetaillee.culture.libelle }}</strong>.
                            {% set equipageDuChamp = equipages[zoneDetaillee.x ~ ':' ~ zoneDetaillee.y ~ ':champ'] %}
                            {% if equipageDuChamp %}
                                <span class="text-encre-500" data-chiffres>
                                    {{ equipageDuChamp.affectes }} / {{ equipageDuChamp.requis }} travailleurs
                                    · {{ equipageDuChamp.rendement }} % de rendement
                                </span>
                            {% endif %}
                            {{ zoneDetaillee.culture.usage }}
                            <br>
                            <strong>{{ etape.libelle }}</strong> — {{ etape.explication }}
                        {% elseif zoneDetaillee.porteUnGisement %}
                            Ce que la case recèle :
                        {% else %}
                            {{ zoneDetaillee.contenu.libelle }}.
                        {% endif %}
                    </p>

                    {% if zoneDetaillee.porteUnChamp and not aUnGrenier %}
                        <p class="mt-3 text-sm text-terre-600">
                            Sans Grenier, ce champ travaille pour rien : la récolte n'a nulle part
                            où se conserver.
                        </p>
                    {% endif %}

                    {% if not zoneDetaillee.estDecouverte %}
                        {% if not partie.estEnCours %}
                            <p class="mt-4 text-sm text-encre-500">La partie a échoué : plus aucun éclaireur ne part.</p>
                        {% elseif expeditionEnCours %}
                            <p class="mt-4 text-sm text-encre-500">
                                Un éclaireur est déjà en chemin.
                            </p>
                        {% else %}
                            <form method="post" action="{{ path('app_partie_explorer', {id: partie.id}) }}" class="mt-5">
                                <input type="hidden" name="_token" value="{{ csrf_token('explorer') }}">
                                <input type="hidden" name="zone" value="{{ zoneDetaillee.x }}-{{ zoneDetaillee.y }}">
                                <button type="submit"
                                        class="rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                                    Envoyer un éclaireur
                                </button>
                                <span class="ml-3 text-sm text-encre-500" data-chiffres>
                                    {# Les cases à moins de trois cases de la
                                       ville se reconnaissent entièrement
                                       gratuitement — ni or ni vivres. #}
                                    {% if coutDeReconnaissance == 0 and provisionsDeReconnaissance == 0 %}
                                        gratuit
                                    {% else %}
                                        {{ coutDeReconnaissance > 0 ? coutDeReconnaissance ~ ' or' : 'sans frais' }}
                                        · {{ provisionsDeReconnaissance }} vivres
                                    {% endif %}
                                    · {{ dureeDeReconnaissance }} cycle{{ dureeDeReconnaissance > 1 ? 's' : '' }}
                                </span>
                            </form>
                        {% endif %}
                    {% else %}
                        {# Gisements et champ ne s'excluent pas : une berge du
                           Nil peut être à la fois poissonneuse et cultivable.
                           Les deux actions s'affichent donc côte à côte, là où
                           un enchaînement `elseif` masquait la seconde. #}
                        {% if zoneDetaillee.porteUnGisement %}
                            {# Une case porte jusqu'à deux gisements : chacun s'ouvre
                               pour lui-même, l'argile sans engager les roseaux. #}
                            <ul class="mt-4 space-y-3 list-none p-0">
                                {% for gisement in zoneDetaillee.gisements %}
                                    {% set estPoisson = gisement.ressource.value == 'poisson' %}
                                    <li class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
                                        <span class="text-sm text-encre-900">
                                            <strong>{{ gisement.ressource.libelle }}</strong>
                                            <span class="text-encre-500" data-chiffres>
                                                {# Un banc de poisson se reconstitue :
                                                   afficher un compteur qui ne bouge
                                                   jamais tromperait le joueur. #}
                                                · {{ estPoisson ? 'inépuisable' : gisement.quantiteRestante ~ ' unités' }}
                                            </span>
                                        </span>

                                        {% if not partie.estEnCours %}
                                            <span class="text-sm text-encre-500">Partie échouée.</span>
                                        {% elseif gisement.estEpuise %}
                                            <span class="text-sm text-encre-500">Filon épuisé.</span>
                                        {% elseif gisement.estExploitee %}
                                            {# L'équipage, pas seulement l'activité : c'est ce
                                               qui dit au joueur pourquoi une carrière rapporte
                                               moitié moins qu'attendu. #}
                                            {% set equipage = equipages[zoneDetaillee.x ~ ':' ~ zoneDetaillee.y ~ ':' ~ gisement.ressource.value] %}
                                            <span class="text-sm text-encre-500">
                                                {{ estPoisson ? 'Pêche en cours.' : 'Extraction en cours.' }}
                                                {% if equipage %}
                                                    <span data-chiffres>{{ equipage.affectes }} / {{ equipage.requis }} travailleurs · {{ equipage.rendement }} %</span>
                                                {% endif %}
                                            </span>
                                        {% elseif estPoisson and not aUnPort %}
                                            <span class="text-sm text-encre-500">Il faudra un Port pour pêcher ici.</span>
                                        {% else %}
                                            <form method="post" action="{{ path('app_partie_exploiter', {id: partie.id}) }}" class="ml-auto">
                                                <input type="hidden" name="_token" value="{{ csrf_token('exploiter') }}">
                                                <input type="hidden" name="zone" value="{{ zoneDetaillee.x }}-{{ zoneDetaillee.y }}">
                                                <input type="hidden" name="ressource" value="{{ gisement.ressource.value }}">
                                                <button type="submit"
                                                        class="rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                                                    {{ estPoisson ? 'Jeter les filets' : 'Ouvrir une carrière' }}
                                                </button>
                                            </form>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}

                        {% if zoneDetaillee.accepteUnChamp and not zoneDetaillee.porteUnChamp and partie.estEnCours %}
                            <form method="post" action="{{ path('app_partie_semer', {id: partie.id}) }}" class="mt-5 flex flex-wrap items-center gap-3">
                                <input type="hidden" name="_token" value="{{ csrf_token('semer') }}">
                                <input type="hidden" name="zone" value="{{ zoneDetaillee.x }}-{{ zoneDetaillee.y }}">
                                <label for="culture" class="text-sm text-encre-600">Semer</label>
                                <select id="culture" name="culture"
                                        class="rounded-sm border border-ocre-500/40 bg-sable-50 px-3 py-2 text-sm text-encre-900">
                                    {% for culture in cultures %}
                                        <option value="{{ culture.value }}">{{ culture.libelle }}</option>
                                    {% endfor %}
                                </select>
                                <button type="submit"
                                        class="rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                                    Établir un champ
                                </button>
                            </form>
                        {% endif %}
                    {% endif %}
                </article>
            {% else %}
                <p class="text-sm text-encre-500">
                    Cliquez une case pour en voir le détail, ou y envoyer un éclaireur.
                </p>
            {% endif %}
        </div>
    </section>
{% endblock %}
