{% extends 'partie/_layout.html.twig' %}

{% block title %}Territoire {{ ville.avecPreposition }} — Niout{% endblock %}

{% block body %}
    {# Géométrie **mesurée sur les tuiles elles-mêmes**, jamais devinée : dans
       une image de 188 × 116, la face supérieure est un losange de 186 × 90,
       de son sommet (y = 12) à sa pointe basse (y = 102), le plus large à
       y = 57. Les treize pixels du bas sont l'épaisseur du prisme, et les
       arbres d'une forêt débordent par le haut — ni les uns ni les autres
       n'entrent dans le pas.

       Le pas vaut donc la moitié du losange, pas la moitié de l'image : c'est
       ce qui fait que les cases pavent le plan au lieu de s'écarter. La zone
       cliquable se découpe à partir des deux mêmes nombres — centre et pas —,
       pour qu'aucun réglage ne puisse dériver de l'autre. #}
    {% set cellule = { largeur: 188, hauteur: 116 } %}
    {% set centre = { x: 94, y: 57 } %}
    {% set pas = { x: 93, y: 45 } %}
    {% set cote = ville.tailleGrille %}
    {% set origineX = (cote - 1) * pas.x %}

    {# Deux panneaux qui remplissent la fenêtre : le territoire à gauche, à
       l'échelle qui le fait tenir en entier ; le détail à droite, seul à
       défiler. La page, elle, ne défile jamais. #}
    <section class="flex h-full min-h-0 overflow-hidden">
        <div class="relative min-w-0 flex-1 overflow-hidden bg-sable-100"
             data-controller="carte"
             data-carte-min-value="0.25"
             data-carte-max-value="1.5"
             data-carte-pas-value="0.15">

            <div class="absolute inset-0 flex items-center justify-center p-4">
                <div class="relative origin-center transition-transform"
                     data-carte-target="grille"
                     style="width: {{ 2 * (cote - 1) * pas.x + cellule.largeur }}px;
                            height: {{ 2 * (cote - 1) * pas.y + cellule.hauteur }}px;">

                {# Couche visible. Les tuiles se recouvrent : elles ne captent
                   aucun clic, sinon celles du premier plan voleraient ceux des
                   cases situées derrière. #}
                {% for zone in zones %}
                    <img src="{{ asset('images/tuiles/' ~ (zone.porteLaVille ? 'ville' : (zone.estDecouverte ? zone.terrain.tuile : 'brouillard')) ~ '.png') }}"
                         alt=""
                         class="pointer-events-none absolute select-none"
                         style="left: {{ origineX + (zone.x - zone.y) * pas.x }}px;
                                top: {{ (zone.x + zone.y) * pas.y }}px;
                                width: {{ cellule.largeur }}px;">
                {% endfor %}

                {# Couche cliquable, découpée à la forme exacte du losange. Les
                   losanges pavent le plan sans se chevaucher : chaque point de
                   la carte appartient donc à une seule case, et le clic tombe
                   toujours juste. #}
                {% for zone in zones %}
                    {% set estSelectionnee = zoneDetaillee and zoneDetaillee.x == zone.x and zoneDetaillee.y == zone.y %}
                    <a href="{{ zone.porteLaVille
                           ? path('app_partie_ville', {id: partie.id})
                           : path('app_partie_carte', {id: partie.id, zone: zone.x ~ '-' ~ zone.y}) ~ '#case' }}"
                       class="absolute block transition-colors
                              {{ estSelectionnee ? 'bg-or-300/45' : 'hover:bg-sable-50/35' }}"
                       style="left: {{ origineX + (zone.x - zone.y) * pas.x }}px;
                              top: {{ (zone.x + zone.y) * pas.y }}px;
                              width: {{ cellule.largeur }}px;
                              height: {{ cellule.hauteur }}px;
                              clip-path: polygon({{ centre.x }}px {{ centre.y - pas.y }}px,
                                                  {{ centre.x + pas.x }}px {{ centre.y }}px,
                                                  {{ centre.x }}px {{ centre.y + pas.y }}px,
                                                  {{ centre.x - pas.x }}px {{ centre.y }}px);"
                       {{ zone.porteLaVille ? 'title="Entrer dans la ville"' : '' }}
                       aria-label="{{ zone.porteLaVille
                           ? 'Entrer dans ' ~ ville.nom
                           : 'Case ' ~ zone.x ~ ', ' ~ zone.y ~ ' — ' ~ (zone.estDecouverte ? zone.terrain.libelle : 'inexplorée') }}"></a>
                {% endfor %}
                </div>
            </div>

            {# Les commandes flottent au-dessus du territoire plutôt que de lui
               prendre de la hauteur : c'est la carte qui doit occuper l'écran. #}
            <div class="absolute left-4 top-4 flex items-center gap-2 rounded-sm border border-ocre-500/30
                        bg-sable-50/90 px-3 py-2 text-sm shadow-sm">
                <h1 class="font-display text-base text-encre-900">Territoire {{ ville.avecPreposition }}</h1>
                <span class="text-encre-500" data-chiffres>{{ cote }} × {{ cote }}</span>
            </div>

            <div class="absolute bottom-4 left-4 flex items-center gap-1 rounded-sm border border-ocre-500/30
                        bg-sable-50/90 p-1 text-sm shadow-sm">
                <button type="button" data-action="carte#eloigner"
                        class="rounded-sm px-2 py-1 text-encre-700 hover:bg-ocre-300/30" aria-label="Éloigner">−</button>
                <span class="w-12 text-center text-xs text-encre-500" data-chiffres data-carte-target="facteur">100 %</span>
                <button type="button" data-action="carte#approcher"
                        class="rounded-sm px-2 py-1 text-encre-700 hover:bg-ocre-300/30" aria-label="Approcher">+</button>
                <button type="button" data-action="carte#revenir"
                        class="rounded-sm px-2 py-1 text-xs text-encre-600 hover:bg-ocre-300/30">Ajuster</button>
            </div>
        </div>

        {# Le panneau de droite : tout ce qui se lit, et le seul endroit qui
           défile. #}
        <aside class="flex w-96 shrink-0 flex-col overflow-y-auto border-l border-ocre-500/25 bg-sable-50 p-5">
            <div class="flex items-baseline justify-between gap-3">
                <a href="{{ path('app_partie_ville', {id: partie.id}) }}" class="text-sm text-lapis-500">
                    Bâtiments {{ ville.avecPreposition }} →
                </a>
            </div>

            <p class="mt-2 text-xs text-encre-500">
                Cliquez votre ville pour en gérer les bâtiments ; les dalles
                gravées de hiéroglyphes attendent un éclaireur.
            </p>

            {# **L'état de la ville se lit aussi d'ici.** On passe des
               quinzaines entières sur la carte à explorer et à exploiter : la
               fièvre, la disette ou une fête se découvraient en rentrant,
               plusieurs quinzaines trop tard. Le panneau défile pour son
               compte, donc ces pastilles ne coûtent la hauteur de personne. #}
            {{ include('partie/_signaux.html.twig') }}

        {# Reconnaître une grille du Sinaï case par case demande des dizaines de
           quinzaines : c'est ce temps de jeu que le mode d'essai permet de
           sauter. Le bouton n'existe que pour un compte qui porte le rôle, et
           la route le vérifie de son côté. #}
        {% if is_granted('ROLE_DIVIN') and partie.estEnModeDivin %}
            <form method="post" action="{{ path('app_partie_divin', {id: partie.id}) }}" class="mt-4">
                <input type="hidden" name="_token" value="{{ csrf_token('divin') }}">
                <input type="hidden" name="retour" value="app_partie_carte">
                <button type="submit" name="brouillard" value="1"
                        class="rounded-sm border border-lapis-500/50 px-4 py-2 text-sm text-encre-700 hover:bg-lapis-500/10">
                    Lever le brouillard sur toute la carte
                </button>
            </form>
        {% endif %}


        {% if ville.expeditions|length > 0 %}
            <section class="mt-6">
                <h2 class="text-lg text-encre-900">Expéditions en route</h2>
                <ul class="mt-3 space-y-2 list-none p-0">
                    {% for expedition in ville.expeditions %}
                        <li class="rounded-sm border border-ocre-500/40 bg-ocre-300/10 px-5 py-3">
                            <div class="flex flex-wrap items-baseline justify-between gap-3 text-sm">
                                <span class="text-encre-900">
                                    {{ expedition.role.libelle }} vers la case
                                    <span data-chiffres>{{ expedition.destination.x }}, {{ expedition.destination.y }}</span>
                                </span>
                                <span class="text-encre-500" data-chiffres>
                                    encore {{ expedition.cyclesRestants }} cycle{{ expedition.cyclesRestants > 1 ? 's' : '' }}
                                </span>
                            </div>
                            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-sm bg-ocre-500/20">
                                <div class="h-full bg-lapis-500" style="width: {{ expedition.pourcentageDAvancement }}%"></div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        <div id="case" class="mt-6">
            {% if zoneDetaillee %}
                <article class="rounded-sm border border-ocre-500/30 bg-sable-50 p-6">
                    <div class="flex flex-wrap items-baseline justify-between gap-3">
                        <h2 class="font-display text-xl text-encre-900">
                            {% if zoneDetaillee.porteLaVille %}
                                {{ ville.nom }}
                            {% elseif zoneDetaillee.estDecouverte %}
                                {{ zoneDetaillee.terrain.libelle }}
                            {% else %}
                                Territoire inexploré
                            {% endif %}
                        </h2>
                        <span class="text-sm text-encre-500" data-chiffres>
                            case {{ zoneDetaillee.x }}, {{ zoneDetaillee.y }}
                            {% if not zoneDetaillee.porteLaVille %}
                                · à {{ zoneDetaillee.distanceDepuis(ville.zoneDeLaVille) }} de la ville
                            {% endif %}
                        </span>
                    </div>

                    {# Une case sous brouillard ne dit rien de son terrain ni de
                       son contenu : c'est justement ce que l'éclaireur va
                       chercher. #}
                    <p class="mt-3 text-sm text-encre-600">
                        {% if zoneDetaillee.porteLaVille %}
                            Votre ville se dresse ici.
                        {% elseif not zoneDetaillee.estDecouverte %}
                            Nul ne sait ce qui s'y trouve. Une reconnaissance le dira.
                        {% elseif zoneDetaillee.porteUnChamp %}
                            {% set etape = zoneDetaillee.etapeDuChamp(partie.dateDeJeu.saison, partie.dateDeJeu.rangDansLaSaison) %}
                            Un champ y est établi, semé de <strong>{{ zoneDetaillee.culture.libelle }}</strong>.
                            {% set equipageDuChamp = equipages[zoneDetaillee.x ~ ':' ~ zoneDetaillee.y ~ ':champ'] %}
                            {% if equipageDuChamp %}
                                <span class="text-encre-500" data-chiffres>
                                    {{ equipageDuChamp.affectes }} / {{ equipageDuChamp.requis }} travailleurs
                                    · {{ equipageDuChamp.rendement }} % de rendement
                                </span>
                            {% endif %}
                            {{ zoneDetaillee.culture.usage }}
                            <br>
                            <strong>{{ etape.libelle }}</strong> — {{ etape.explication }}
                        {% elseif zoneDetaillee.porteUnGisement %}
                            Ce que la case recèle :
                        {% else %}
                            {{ zoneDetaillee.contenu.libelle }}.
                        {% endif %}
                    </p>

                    {# Le danger se dit **avant** qu'on tente d'exploiter : le
                       découvrir par un refus serait le subir au lieu de le
                       jouer (doc 02, doc 03). La défense montrée est celle que
                       la case oppose réellement, renforts de la région
                       compris — c'est ce qu'il faut pour décider d'y aller. #}
                    {% if zoneDetaillee.estGardee %}
                        <p class="mt-3 rounded-sm border-l-4 border-terre-500 bg-terre-500/5 px-4 py-3 text-sm text-encre-900">
                            <strong>Des brigands tiennent cette case.</strong>
                            Rien ne s'y exploitera tant qu'ils y sont.
                            <span class="text-encre-600" data-chiffres>
                                Ils opposent {{ defenseDeLaZone }} de résistance ;
                                {% if medjaysDisponibles > 0 %}
                                    vous pouvez leur opposer {{ medjaysDisponibles }} homme{{ medjaysDisponibles > 1 ? 's' : '' }}.
                                {% else %}
                                    vous n'avez aucun homme en état de partir.
                                {% endif %}
                            </span>
                        </p>

                        {# Le combat se résout d'un bloc : aucun écran de
                           bataille, l'engagement du joueur était en amont —
                           qui lever, comment les armer, sous quel dieu. #}
                        {% if medjaysDisponibles > 0 and partie.estEnCours %}
                            <form method="post" action="{{ path('app_partie_attaquer', {id: partie.id}) }}" class="mt-3">
                                <input type="hidden" name="_token" value="{{ csrf_token('attaquer') }}">
                                <input type="hidden" name="zone" value="{{ zoneDetaillee.x }}-{{ zoneDetaillee.y }}">
                                <button type="submit"
                                        class="rounded-sm border border-terre-500/50 px-3 py-1 text-sm text-encre-900 hover:bg-terre-500/10">
                                    Y envoyer vos Medjaÿ
                                </button>
                            </form>
                        {% endif %}
                    {% endif %}

                    {# L'émissaire va parler aux gens d'une case reconnue : c'est
                       son emploi propre, et la seule façon d'entendre un
                       témoignage (doc 04, doc 10). #}
                    {% if peutEnvoyerUnEmissaire %}
                        <form method="post" action="{{ path('app_partie_explorer', {id: partie.id}) }}" class="mt-4">
                            <input type="hidden" name="_token" value="{{ csrf_token('explorer') }}">
                            <input type="hidden" name="zone" value="{{ zoneDetaillee.x }}-{{ zoneDetaillee.y }}">
                            <input type="hidden" name="role" value="emissaire">
                            <button type="submit"
                                    class="rounded-sm border border-lapis-500/50 px-4 py-2 text-sm text-encre-700 hover:bg-lapis-500/10">
                                Envoyer un émissaire
                            </button>
                            <span class="ml-3 text-sm text-encre-500" data-chiffres>
                                {{ coutDeLEmissaire }} deben · {{ provisionsDeLEmissaire }} vivres
                            </span>
                        </form>
                    {% endif %}

                    {# Un filon épuisé n'est pas une impasse : on peut envoyer
                       sonder la case pour rouvrir la veine, ou en trouver une
                       autre. Le départ n'est proposé que si quelque chose peut
                       en sortir — annoncer une fouille qui ne peut rien
                       rapporter serait un piège. #}
                    {% if peutProspecter and partie.estEnCours %}
                        <form method="post" action="{{ path('app_partie_explorer', {id: partie.id}) }}" class="mt-4">
                            <input type="hidden" name="_token" value="{{ csrf_token('explorer') }}">
                            <input type="hidden" name="zone" value="{{ zoneDetaillee.x }}-{{ zoneDetaillee.y }}">
                            <input type="hidden" name="role" value="prospecteur">
                            <button type="submit"
                                    class="rounded-sm border border-lapis-500/50 px-4 py-2 text-sm text-encre-700 hover:bg-lapis-500/10">
                                Envoyer un prospecteur
                            </button>
                            <span class="ml-3 text-sm text-encre-500" data-chiffres>
                                {{ coutDuProspecteur }} deben · {{ provisionsDuProspecteur }} vivres
                                · {{ dureeDuProspecteur }} cycle{{ dureeDuProspecteur > 1 ? 's' : '' }}
                                · {{ chancesDeProspecter }} % de chances
                            </span>
                        </form>
                        <p class="mt-2 text-sm text-encre-500">
                            {% if chancesDeProspecter >= 100 %}
                                La veine est encore en activité : vos gens savent
                                exactement où elle s'est perdue, ils la retrouveront.
                            {% elseif chancesDeProspecter < 30 %}
                                Ce sol n'a jamais rien livré : on y sonde à l'aveugle.
                            {% endif %}
                            Ce que ce sol pourrait rendre :
                            {% for filon in filonsAProspecter %}{{ filon.libelle|lower }}{{ not loop.last ? ', ' : '' }}{% endfor %}.
                        </p>
                    {% endif %}

                    {# Les cases « quelque chose s'y trame » sont posées depuis le
                       lot 3.2 et ne menaient nulle part : elles rendent désormais
                       un indice, une fois. #}
                    {% if peutFouiller %}
                        <form method="post" action="{{ path('app_partie_fouiller', {id: partie.id}) }}" class="mt-4">
                            <input type="hidden" name="_token" value="{{ csrf_token('fouiller') }}">
                            <input type="hidden" name="zone" value="{{ zoneDetaillee.x }}-{{ zoneDetaillee.y }}">
                            <button type="submit"
                                    class="rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                                Fouiller les lieux
                            </button>
                        </form>
                    {% elseif zoneDetaillee.indiceRecueilli %}
                        <p class="mt-4 text-sm text-encre-500">
                            Vos gens ont déjà retourné cette terre : elle a livré ce qu'elle avait.
                        </p>
                    {% endif %}

                    {% if zoneDetaillee.porteUnChamp and not aUnGrenier %}
                        <p class="mt-3 text-sm text-terre-600">
                            Sans Grenier, ce champ travaille pour rien : la récolte n'a nulle part
                            où se conserver.
                        </p>
                    {% endif %}

                    {% if not zoneDetaillee.estDecouverte %}
                        {% if not partie.estEnCours %}
                            <p class="mt-4 text-sm text-encre-500">La partie a échoué : plus aucun éclaireur ne part.</p>
                        {% elseif expeditionEnCours %}
                            <p class="mt-4 text-sm text-encre-500">
                                Un éclaireur est déjà en chemin.
                            </p>
                        {% else %}
                            <form method="post" action="{{ path('app_partie_explorer', {id: partie.id}) }}" class="mt-5">
                                <input type="hidden" name="_token" value="{{ csrf_token('explorer') }}">
                                <input type="hidden" name="zone" value="{{ zoneDetaillee.x }}-{{ zoneDetaillee.y }}">
                                <button type="submit"
                                        class="rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                                    Envoyer un éclaireur
                                </button>
                                <span class="ml-3 text-sm text-encre-500" data-chiffres>
                                    {# Les cases à moins de trois cases de la
                                       ville se reconnaissent entièrement
                                       gratuitement — ni or ni vivres. #}
                                    {% if coutDeReconnaissance == 0 and provisionsDeReconnaissance == 0 %}
                                        gratuit
                                    {% else %}
                                        {{ coutDeReconnaissance > 0 ? coutDeReconnaissance ~ ' or' : 'sans frais' }}
                                        · {{ provisionsDeReconnaissance }} vivres
                                    {% endif %}
                                    · {{ dureeDeReconnaissance }} cycle{{ dureeDeReconnaissance > 1 ? 's' : '' }}
                                </span>
                            </form>
                        {% endif %}
                    {% else %}
                        {# Gisements et champ ne s'excluent pas : une berge du
                           Nil peut être à la fois poissonneuse et cultivable.
                           Les deux actions s'affichent donc côte à côte, là où
                           un enchaînement `elseif` masquait la seconde. #}
                        {% if zoneDetaillee.porteUnGisement %}
                            {# Une case porte jusqu'à deux gisements : chacun s'ouvre
                               pour lui-même, l'argile sans engager les roseaux. #}
                            <ul class="mt-4 space-y-3 list-none p-0">
                                {% for gisement in zoneDetaillee.gisements %}
                                    {% set estPoisson = gisement.ressource.value == 'poisson' %}
                                    <li class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
                                        <span class="text-sm text-encre-900">
                                            <strong>{{ gisement.ressource.libelle }}</strong>
                                            <span class="text-encre-500" data-chiffres>
                                                {# Un banc de poisson se reconstitue :
                                                   afficher un compteur qui ne bouge
                                                   jamais tromperait le joueur. #}
                                                · {{ estPoisson ? 'inépuisable' : gisement.quantiteRestante ~ ' unités' }}
                                            </span>
                                        </span>

                                        {% if not partie.estEnCours %}
                                            <span class="text-sm text-encre-500">Partie échouée.</span>
                                        {% elseif gisement.estEpuise %}
                                            <span class="text-sm text-encre-500">Filon épuisé.</span>
                                        {% elseif gisement.estExploitee %}
                                            {# L'équipage, pas seulement l'activité : c'est ce
                                               qui dit au joueur pourquoi une carrière rapporte
                                               moitié moins qu'attendu. #}
                                            {% set equipage = equipages[zoneDetaillee.x ~ ':' ~ zoneDetaillee.y ~ ':' ~ gisement.ressource.value] %}
                                            <span class="text-sm text-encre-500">
                                                {{ estPoisson ? 'Pêche en cours.' : 'Extraction en cours.' }}
                                                {% if equipage %}
                                                    <span data-chiffres>{{ equipage.affectes }} / {{ equipage.requis }} travailleurs · {{ equipage.rendement }} %</span>
                                                {% endif %}
                                            </span>
                                        {% elseif estPoisson and not aUnPort %}
                                            <span class="text-sm text-encre-500">Il faudra un Port pour pêcher ici.</span>
                                        {% else %}
                                            <form method="post" action="{{ path('app_partie_exploiter', {id: partie.id}) }}" class="ml-auto">
                                                <input type="hidden" name="_token" value="{{ csrf_token('exploiter') }}">
                                                <input type="hidden" name="zone" value="{{ zoneDetaillee.x }}-{{ zoneDetaillee.y }}">
                                                <input type="hidden" name="ressource" value="{{ gisement.ressource.value }}">
                                                <button type="submit"
                                                        class="rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                                                    {{ estPoisson ? 'Jeter les filets' : 'Ouvrir une carrière' }}
                                                </button>
                                            </form>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}

                        {% if zoneDetaillee.accepteUnChamp and not zoneDetaillee.porteUnChamp and partie.estEnCours %}
                            <form method="post" action="{{ path('app_partie_semer', {id: partie.id}) }}" class="mt-5 flex flex-wrap items-center gap-3">
                                <input type="hidden" name="_token" value="{{ csrf_token('semer') }}">
                                <input type="hidden" name="zone" value="{{ zoneDetaillee.x }}-{{ zoneDetaillee.y }}">
                                <label for="culture" class="text-sm text-encre-600">Semer</label>
                                <select id="culture" name="culture"
                                        class="rounded-sm border border-ocre-500/40 bg-sable-50 px-3 py-2 text-sm text-encre-900">
                                    {% for culture in cultures %}
                                        <option value="{{ culture.value }}">{{ culture.libelle }}</option>
                                    {% endfor %}
                                </select>
                                <button type="submit"
                                        class="rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                                    Établir un champ
                                </button>
                            </form>
                        {% endif %}
                    {% endif %}
                </article>
            {% else %}
                <p class="text-sm text-encre-500">
                    Cliquez une case pour en voir le détail, ou y envoyer un éclaireur.
                </p>
            {% endif %}
        </div>
        </aside>
    </section>
{% endblock %}
