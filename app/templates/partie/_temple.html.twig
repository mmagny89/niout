{# Le Temple : à qui l'on donne, et ce que les dieux en pensent.

   Un onglet de la ville, comme la Maison des scribes ou l'Auberge — **un
   onglet, un bâtiment** (décision de la joueuse) : un écran à part obligeait à
   quitter la ville pour porter une offrande, et rien ne disait au joueur que
   ces trois bâtiments se lisaient de trois façons différentes. #}
<h2 class="text-2xl text-encre-900">Le Temple {{ ville.avecPreposition }}</h2>

{# Le Temple d'un coup d'œil : autant d'ankhs que de dieux qu'il peut porter, allumés
   pour ceux qu'on honore, et ce que vaut une offrande. Décoratif (`aria-hidden`) :
   les deux paragraphes dessous disent la même chose en lettres. #}
<div class="mt-4 flex flex-wrap items-center gap-x-8 gap-y-3 rounded-sm border border-ocre-500/30 bg-sable-50 px-4 py-3">
    <div class="flex items-center gap-2" aria-hidden="true"
         data-infobulle="Autant d'ankhs que de divinités que votre Temple peut porter au-dessus du neutre. Un ankh allumé : un dieu que vous honorez.">
        <span class="text-sm text-encre-500">Dieux portés</span>
        <span class="flex items-center gap-1">
            {% for rang in 1..max(divinitesPortables, 1) %}
                {{ include('partie/_pictogramme.html.twig', {
                    nom: 'faveur', taille: 30,
                    classe: 'case-vivante ' ~ (rang <= honorees|length ? 'case-vivante--allumee' : 'opacity-25 grayscale'),
                }) }}
            {% endfor %}
        </span>
    </div>
    <div class="flex items-center gap-2 text-sm text-encre-700" aria-hidden="true" data-chiffres
         data-infobulle="Ce que vaut une offrande : {{ debenParOffrande }} deben, ou leur valeur en marchandise, donnent {{ pointsParOffrande }} points de faveur.">
        {{ include('partie/_pictogramme.html.twig', {nom: 'offrande', taille: 30}) }}
        <span>{{ debenParOffrande }}</span>
        {{ include('partie/_pictogramme.html.twig', {nom: 'deben', taille: 22}) }}
        <span class="text-encre-500">=</span>
        <span>{{ pointsParOffrande }}</span>
        {{ include('partie/_pictogramme.html.twig', {nom: 'faveur', taille: 22}) }}
    </div>
</div>

<p class="mt-3 text-sm text-encre-500">
    Un Temple de niveau <span data-chiffres>{{ niveauDuTemple }}</span> porte
    <span data-chiffres>{{ divinitesPortables }}</span> divinité{{ divinitesPortables > 1 ? 's' : '' }}
    au-dessus du neutre, et jusqu'à <span data-chiffres>{{ plafond }}</span> points de faveur.
    Agrandissez-le pour en honorer davantage, et plus haut.
</p>

<p class="mt-2 text-sm text-encre-500">
    Vous portez actuellement <span data-chiffres>{{ honorees|length }}</span>
    divinité{{ honorees|length > 1 ? 's' : '' }} sur <span data-chiffres>{{ divinitesPortables }}</span>.
    Offrir <span data-chiffres>{{ debenParOffrande }}</span> deben — ou leur valeur en
    marchandise — vaut <span data-chiffres>{{ pointsParOffrande }}</span> points de faveur.
</p>
{% if fete %}
    <p class="mt-4 rounded-sm border border-lapis-500/50 bg-lapis-500/5 px-5 py-3 text-sm text-encre-700">
        {{ include('partie/_pictogramme.html.twig', {nom: 'offrande', taille: 28, classe: 'mr-2 -mt-1'}) }}<span class="font-display text-lg text-encre-900">{{ fete.libelle }}</span> —
        {{ fete.description }} Toute offrande à {{ fete.divinite.libelle }} vaut
        <span data-chiffres>{{ pointsDeFete }}</span> points de plus tant qu'elle dure.
    </p>
{% endif %}

<ul class="mt-6 grid list-none grid-cols-1 gap-3 p-0 md:grid-cols-2">
    {% for dieu in pantheon %}
        <li class="carte-vivante rounded-sm border border-ocre-500/30 bg-sable-50 p-4">
            {# Le portrait du dieu, en tête de sa carte : la lecture du reste coule
               autour. Décoratif — le nom est écrit juste à côté. #}
            {% set portrait = image_de_divinite(dieu.divinite) %}
            {% if portrait %}
                <img src="{{ asset(portrait) }}" alt="" loading="lazy" decoding="async"
                     class="float-left mb-2 mr-4 select-none rounded-sm border border-ocre-500/40"
                     style="width: 96px; height: auto; float: left;">
            {% endif %}
            <div class="flex flex-wrap items-baseline justify-between gap-3">
                <h3 class="font-display text-xl text-encre-900">{{ dieu.divinite.libelle }}</h3>
                <span class="text-sm text-encre-500">{{ dieu.divinite.domaine }}</span>
                <span class="ml-auto rounded-sm border px-3 py-1 text-sm
                             {{ dieu.palier.nuit
                                ? 'border-terre-600/50 text-terre-600'
                                : (dieu.palier.estAuDessusDuNeutre ? 'border-lapis-500/50 text-lapis-500' : 'border-ocre-500/40 text-encre-500') }}">
                    {{ include('partie/_pictogramme.html.twig', {nom: 'faveur', taille: 18}) }}
                    {{ dieu.palier.libelle }} · <span data-chiffres>{{ dieu.faveur }}</span>
                </span>
            </div>

            {# La jauge dit d'un coup d'œil ce qu'une colonne de chiffres
               dirait mal : où en est ce dieu, et où s'arrête le Temple. #}
            <div class="mt-3 h-2.5 w-full overflow-hidden rounded-full bg-ocre-500/20">
                <div class="jauge h-full rounded-full {{ dieu.palier.nuit ? 'bg-terre-600' : 'bg-linear-to-r from-lapis-500 to-lapis-400' }}"
                     style="width: {{ dieu.faveur }}%"></div>
            </div>

            <p class="mt-3 text-sm text-encre-700">{{ dieu.divinite.effet }}</p>

            {% if dieu.supplementDeFete > 0 %}
                <p class="mt-1 text-sm text-lapis-500">
                    C'est sa fête : chaque offrande vaut
                    <span data-chiffres>{{ dieu.supplementDeFete }}</span> points de plus.
                </p>
            {% endif %}

            {% if dieu.divinite.precision %}
                <p class="mt-1 text-sm text-encre-500">{{ dieu.divinite.precision }}</p>
            {% endif %}

            <p class="mt-1 text-sm text-encre-500">{{ dieu.palier.description }}</p>

            {% if dieu.seDetourne %}
                <p class="mt-2 text-sm text-terre-600">
                    Sans offrande depuis <span data-chiffres>{{ dieu.quinzainesSansOffrande }}</span>
                    quinzaines, {{ dieu.divinite.libelle }} se détourne peu à peu — jamais
                    plus bas que le neutre.
                </p>
            {% endif %}

            {# Promettre un effet qui ne s'applique nulle part tromperait le
               joueur au moment même où il choisit à qui donner. Les huit dieux
               agissent depuis le lot 10.4 — Isis était la dernière —, mais le
               garde-fou reste pour celui qu'on ajouterait demain. #}
            {% if not dieu.divinite.agitDeja %}
                <p class="mt-2 rounded-sm border border-ocre-500/40 bg-ocre-300/10 px-4 py-2 text-sm text-encre-600">
                    {{ dieu.divinite.attente }}
                </p>
            {% endif %}

            {% if partie.estEnCours and not dieu.sansDomaineIci %}
                {% if corbeille is empty %}
                    <p class="mt-3 text-sm text-encre-500">Vos réserves n'ont rien à offrir.</p>
                {% else %}
                    <form method="post" action="{{ path('app_partie_offrir', {id: partie.id}) }}"
                          class="mt-4 flex flex-wrap items-baseline gap-x-4 gap-y-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('offrir') }}">
                        <input type="hidden" name="onglet" value="{{ onglet.cle }}">
                        <input type="hidden" name="divinite" value="{{ dieu.divinite.value }}">

                        <label for="offrande-{{ dieu.divinite.value }}" class="text-sm text-encre-600">Offrir</label>
                        <input type="number" id="offrande-{{ dieu.divinite.value }}" name="quantite"
                               value="10" min="1"
                               class="w-24 rounded-sm border border-ocre-500/40 bg-sable-50 px-3 py-2 text-sm text-encre-900"
                               data-chiffres>

                        <label for="ressource-{{ dieu.divinite.value }}" class="sr-only">Ce que vous offrez</label>
                        <select id="ressource-{{ dieu.divinite.value }}" name="ressource"
                                class="rounded-sm border border-ocre-500/40 bg-sable-50 px-3 py-2 text-sm text-encre-900">
                            {% for lot in corbeille %}
                                <option value="{{ lot.ressource.value }}">
                                    {{ lot.ressource.libelle }} ({{ lot.quantite }} en réserve,
                                    {{ lot.valeurUnitaire }} deben l'unité)
                                </option>
                            {% endfor %}
                        </select>

                        <button type="submit"
                                class="bouton-offrande group ml-auto inline-flex items-center gap-2 rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                            {{ include('partie/_pictogramme.html.twig', {nom: 'offrande', taille: 22, classe: 'bouton-offrande__image'}) }}
                            Porter au Temple
                        </button>
                    </form>
                {% endif %}
            {% endif %}
        </li>
    {% endfor %}
</ul>
