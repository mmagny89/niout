{# Le Temple : à qui l'on donne, et ce que les dieux en pensent.

   Un onglet de la ville, comme la Maison des scribes ou l'Auberge — **un
   onglet, un bâtiment** (décision de la joueuse) : un écran à part obligeait à
   quitter la ville pour porter une offrande, et rien ne disait au joueur que
   ces trois bâtiments se lisaient de trois façons différentes. #}
{# Le titre « Le Temple d'Avaris » redisait celui de la fenêtre : il est parti. La bande des ankhs dit ce que
   deux paragraphes redisaient — combien de dieux le Temple porte et lesquels on honore, ce que vaut une offrande, le
   plafond de faveur. Décoratif (`aria-hidden`) : les infobulles et les cartes disent tout en lettres. #}
<div class="mt-4 flex flex-wrap items-center gap-x-8 gap-y-3 rounded-sm border border-ocre-500/30 bg-sable-50 px-4 py-3">
    <div class="flex items-center gap-2" aria-hidden="true"
         data-infobulle="Un Temple de niveau {{ niveauDuTemple }} porte {{ divinitesPortables }} divinité{{ divinitesPortables > 1 ? 's' : '' }} au-dessus du neutre. Un ankh allumé : un dieu que vous honorez. Agrandissez le Temple pour en honorer davantage.">
        <span class="text-sm text-encre-500">Dieux portés</span>
        <span class="flex items-center gap-1">
            {% for rang in 1..max(divinitesPortables, 1) %}
                {{ include('partie/_pictogramme.html.twig', {
                    nom: 'faveur', taille: 30,
                    classe: 'case-vivante ' ~ (rang <= honorees|length ? 'case-vivante--allumee' : 'opacity-25 grayscale'),
                }) }}
            {% endfor %}
        </span>
        <span class="text-sm text-encre-700" data-chiffres>{{ honorees|length }} / {{ divinitesPortables }}</span>
    </div>
    <div class="flex items-center gap-2 text-sm text-encre-700" aria-hidden="true" data-chiffres
         data-infobulle="Ce que vaut une offrande : {{ debenParOffrande }} deben, ou leur valeur en marchandise, donnent {{ pointsParOffrande }} points de faveur.">
        {{ include('partie/_pictogramme.html.twig', {nom: 'offrande', taille: 30}) }}
        <span>{{ debenParOffrande }}</span>
        {{ include('partie/_pictogramme.html.twig', {nom: 'deben', taille: 22}) }}
        <span class="text-encre-500">=</span>
        <span>{{ pointsParOffrande }}</span>
        {{ include('partie/_pictogramme.html.twig', {nom: 'faveur', taille: 22}) }}
    </div>
    <div class="flex items-center gap-2 text-sm text-encre-700" aria-hidden="true" data-chiffres
         data-infobulle="Ce Temple porte la faveur d'un dieu jusqu'à {{ plafond }} points.">
        <span class="text-encre-500">Faveur max</span>
        <span>{{ plafond }}</span>
    </div>
    <span class="sr-only">Un Temple de niveau {{ niveauDuTemple }} porte {{ divinitesPortables }} divinités et jusqu'à {{ plafond }} points de faveur ; vous en honorez {{ honorees|length }}. Offrir {{ debenParOffrande }} deben vaut {{ pointsParOffrande }} points de faveur.</span>
</div>

{% if fete %}
    <p class="mt-4 rounded-sm border border-lapis-500/50 bg-lapis-500/5 px-5 py-3 text-sm text-encre-700">
        {{ include('partie/_pictogramme.html.twig', {nom: 'offrande', taille: 28, classe: 'mr-2 -mt-1'}) }}<span class="font-display text-lg text-encre-900">{{ fete.libelle }}</span> —
        {{ fete.description }} Toute offrande à {{ fete.divinite.libelle }} vaut
        <span data-chiffres>{{ pointsDeFete }}</span> points de plus tant qu'elle dure.
    </p>
{% endif %}

<ul class="mt-5 grid list-none grid-cols-1 gap-4 p-0 xl:grid-cols-2">
    {% for dieu in pantheon %}
        {# **Une carte de dieu se lit de gauche à droite** : son portrait, puis qui il est et où il en est (la faveur en jauge,
           coiffée de son palier), ce qu'il fait pour vous, et en bas ce qu'on lui offre. Le palier se décrit à
           l'infobulle ; la fête est un badge, plus une phrase répétée sous la bande. #}
        {% set ton = dieu.palier.nuit ? 'terre' : (dieu.palier.estAuDessusDuNeutre ? 'lapis' : 'ocre') %}
        <li class="carte-vivante flex flex-col rounded-sm border border-ocre-500/30 bg-sable-50 p-4">
            <div class="flex gap-4">
                {% set portrait = image_de_divinite(dieu.divinite) %}
                {% if portrait %}
                    <img src="{{ asset(portrait) }}" alt="" loading="lazy" decoding="async"
                         class="h-28 w-24 shrink-0 select-none rounded-sm border border-ocre-500/40 object-cover"
                         style="width: 96px; height: 112px; object-fit: cover;">
                {% endif %}
                <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                        <h3 class="font-display text-xl leading-tight text-encre-900">{{ dieu.divinite.libelle }}</h3>
                        <span class="inline-flex items-center gap-1 rounded-full border px-2.5 py-0.5 text-xs
                                     {{ ton == 'terre' ? 'border-terre-600/50 text-terre-600' : (ton == 'lapis' ? 'border-lapis-500/50 text-lapis-600' : 'border-ocre-500/40 text-encre-500') }}"
                              data-infobulle="{{ dieu.palier.description }}">
                            {{ include('partie/_pictogramme.html.twig', {nom: 'faveur', taille: 16}) }}
                            {{ dieu.palier.libelle }} · <span data-chiffres>{{ dieu.faveur }}</span>
                        </span>
                    </div>
                    <p class="text-xs text-encre-500">{{ dieu.divinite.domaine }}</p>

                    {# La jauge dit où en est ce dieu, et où s'arrête le Temple : au-delà du plafond, des hachures. #}
                    <div class="relative mt-2 h-2.5 w-full overflow-hidden rounded-full bg-ocre-500/20"
                         role="img" aria-label="Faveur : {{ dieu.faveur }} sur {{ plafond }} que le Temple peut porter">
                        {% if plafond < 100 %}
                            <div class="reserve-libre absolute inset-y-0 right-0" style="width: {{ 100 - plafond }}%" aria-hidden="true"></div>
                        {% endif %}
                        <div class="jauge relative h-full rounded-full {{ dieu.palier.nuit ? 'bg-terre-600' : 'bg-linear-to-r from-lapis-500 to-lapis-400' }}"
                             style="width: {{ dieu.faveur }}%"></div>
                    </div>

                    <p class="mt-2 text-sm text-encre-700">{{ dieu.divinite.effet }}</p>
                    {% if dieu.divinite.precision %}
                        <p class="mt-0.5 text-xs text-encre-500">{{ dieu.divinite.precision }}</p>
                    {% endif %}

                    {% if dieu.supplementDeFete > 0 or dieu.seDetourne or not dieu.divinite.agitDeja %}
                        <ul class="mt-2 flex list-none flex-wrap gap-1.5 p-0 text-xs">
                            {% if dieu.supplementDeFete > 0 %}
                                <li class="rounded-full border border-lapis-500/50 bg-lapis-500/5 px-2 py-0.5 text-lapis-600" data-chiffres>
                                    C'est sa fête : <strong class="font-medium">+{{ dieu.supplementDeFete }}</strong> par offrande
                                </li>
                            {% endif %}
                            {% if dieu.seDetourne %}
                                <li class="rounded-full border border-terre-500/50 bg-terre-500/10 px-2 py-0.5 text-terre-600" data-chiffres
                                    data-infobulle="Sans offrande depuis {{ dieu.quinzainesSansOffrande }} quinzaines, {{ dieu.divinite.libelle }} se détourne peu à peu — jamais plus bas que le neutre.">
                                    Se détourne · {{ dieu.quinzainesSansOffrande }} quinzaines
                                </li>
                            {% endif %}
                            {# Promettre un effet qui ne s'applique nulle part tromperait le joueur au moment même où il choisit à qui
                               donner. Les huit dieux agissent ; le garde-fou reste pour celui qu'on ajouterait demain. #}
                            {% if not dieu.divinite.agitDeja %}
                                <li class="rounded-full border border-ocre-500/40 bg-ocre-300/10 px-2 py-0.5 text-encre-600">{{ dieu.divinite.attente }}</li>
                            {% endif %}
                        </ul>
                    {% endif %}
                </div>
            </div>

            {% if partie.estEnCours and not dieu.sansDomaineIci %}
                {% if corbeille is empty %}
                    <p class="mt-3 text-sm text-encre-500">Vos réserves n'ont rien à offrir.</p>
                {% else %}
                    <form method="post" action="{{ path('app_partie_offrir', {id: partie.id}) }}"
                          class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-ocre-500/20 pt-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('offrir') }}">
                        <input type="hidden" name="onglet" value="{{ onglet.cle }}">
                        <input type="hidden" name="divinite" value="{{ dieu.divinite.value }}">

                        <label for="offrande-{{ dieu.divinite.value }}" class="text-sm text-encre-600">Offrir</label>
                        <input type="number" id="offrande-{{ dieu.divinite.value }}" name="quantite"
                               value="10" min="1"
                               class="w-20 rounded-sm border border-ocre-500/40 bg-sable-50 px-2 py-2 text-sm text-encre-900"
                               data-chiffres>

                        <label for="ressource-{{ dieu.divinite.value }}" class="sr-only">Ce que vous offrez</label>
                        <select id="ressource-{{ dieu.divinite.value }}" name="ressource"
                                class="min-w-0 flex-1 rounded-sm border border-ocre-500/40 bg-sable-50 px-2 py-2 text-sm text-encre-900">
                            {% for lot in corbeille %}
                                <option value="{{ lot.ressource.value }}">
                                    {{ lot.ressource.libelle }} ({{ lot.quantite }} en réserve,
                                    {{ lot.valeurUnitaire }} deben l'unité)
                                </option>
                            {% endfor %}
                        </select>

                        <button type="submit"
                                class="bouton-offrande group inline-flex items-center gap-2 rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                            {{ include('partie/_pictogramme.html.twig', {nom: 'offrande', taille: 22, classe: 'bouton-offrande__image'}) }}
                            Porter au Temple
                        </button>
                    </form>
                {% endif %}
            {% endif %}
        </li>
    {% endfor %}
</ul>
