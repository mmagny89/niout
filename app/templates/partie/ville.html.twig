{% extends 'partie/_layout.html.twig' %}

{% block title %}{{ ville.nom }} — Niout{% endblock %}

{% block body %}
    {# L'écran de ville tient dans la fenêtre : un bandeau fixe pour ce qui
       presse, une barre d'onglets, et un seul panneau ouvert à la fois — qui
       défile pour son compte. Empilée, la ville faisait plusieurs écrans de
       haut, et comparer sa masse salariale à son étal demandait de retenir. #}
    <section class="flex h-full min-h-0 flex-col"
             data-controller="onglets"
             data-onglets-actif-class="border-terre-500 text-terre-600"
             data-onglets-inactif-class="border-transparent text-encre-500">

        <div class="shrink-0 border-b border-ocre-500/25 bg-sable-50 px-6 pt-4">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
            <h1 class="font-display text-2xl text-encre-900">{{ ville.nom }}</h1>
            <div class="flex flex-wrap items-baseline gap-4">
                <a href="{{ path('app_partie_carte', {id: partie.id}) }}" class="text-sm text-lapis-500">
                    ← Retour au territoire
                </a>
            </div>
        </div>

        {# Une fièvre qui ne se voit pas est une production qui baisse sans
           raison apparente : elle s'annonce avant toute autre chose. #}
        {% if ville.estFrappeeParUneEpidemie %}
            <p class="mt-2 rounded-sm border border-terre-600/50 bg-terre-500/10 px-4 py-2 text-xs text-encre-700">
                <span class="font-display text-lg text-encre-900">La fièvre est dans la ville.</span>
                <span data-chiffres>{{ ville.malades }}</span> bras sur
                <span data-chiffres>{{ ville.actifs }}</span> restent couchés, encore
                <span data-chiffres>{{ ville.quinzainesDepidemie }}</span>
                quinzaine{{ ville.quinzainesDepidemie > 1 ? 's' : '' }}. Nul n'en meurt.
                {% if ville.possede(constant('App\\Game\\TypeDeBatiment::Temple')) %}
                    Une offrande à Sekhmet, dont les prêtres soignent, en abrégerait le cours.
                {% endif %}
            </p>
        {% endif %}

        {# Ce que la barre de jeu ne dit pas : ce que la saison change
           concrètement. Une ligne, pas un encadré — tout ce qui est fixe ici
           est de la hauteur en moins pour le panneau ouvert. #}
        <p class="mt-2 text-xs text-encre-500">
            {% if partie.dateDeJeu.saison %}
                <strong class="text-encre-700">{{ partie.dateDeJeu.saison.libelle }}</strong>,
                {{ partie.dateDeJeu.saison.sens }} — {{ partie.dateDeJeu.saison.description }}
            {% else %}
                <strong class="text-encre-700">Hériou-renpèt</strong> — les cinq jours
                « au-dessus de l'année », hors mois et hors saison.
            {% endif %}
        </p>

        {# Le mécontentement est une spirale : la subir sans la comprendre
           serait injuste. L'écran dit la cause et le remède. #}
        {% if villeMecontente %}
            <p class="mt-4 rounded-sm border-l-4 border-terre-500 bg-terre-500/5 px-4 py-3 text-sm text-encre-700">
                <strong class="text-encre-900">La ville est mécontente</strong>
                depuis {{ mecontentement }} quinzaine{{ mecontentement > 1 ? 's' : '' }} :
                on n'y mange pas à sa faim, ou l'on n'y est pas payé.
                La production tombe à <span data-chiffres>{{ rendementDeLHumeur }} %</span>,
                les départs s'accélèrent, et votre renom s'en ressent.
                Nourrissez et payez vos gens : la colère retombe aussi lentement
                qu'elle est montée.
            </p>
        {% endif %}


            {# **Un onglet, un bâtiment** (décision de la joueuse) : chaque
               bâtiment porte ce qui relève de sa fonction — sa direction, ses
               ouvrages, ses routes —, et la Résidence familiale recueille tout
               ce qui n'appartient à aucun. Le découpage par thème obligeait à
               deviner dans quel panneau ranger quoi.

               Les deux boucles lisent **la même liste**, dans le même ordre :
               `onglets_controller.js` apparie onglets et panneaux par rang, pas
               par identifiant, et deux listes construites séparément
               finiraient par diverger. #}
            <nav class="mt-4 flex flex-wrap gap-1 text-sm" role="tablist" aria-label="Sections de la ville">
                {% for onglet in onglets %}
                    <button type="button" role="tab" id="onglet-{{ onglet.cle }}"
                            aria-controls="panneau-{{ onglet.cle }}"
                            aria-selected="{{ loop.first ? 'true' : 'false' }}"
                            tabindex="{{ loop.first ? '0' : '-1' }}"
                            data-onglets-target="onglet" data-onglet-actif="{{ loop.first ? 'true' : 'false' }}"
                            data-action="onglets#choisir keydown->onglets#naviguer"
                            class="border-b-2 px-3 py-2 hover:text-terre-600">{{ onglet.libelle }}</button>
                {% endfor %}
            </nav>
        </div>

        {% for onglet in onglets %}
            <div class="min-h-0 flex-1 overflow-y-auto px-6 pb-10 pt-4" role="tabpanel"
                 id="panneau-{{ onglet.cle }}" aria-labelledby="onglet-{{ onglet.cle }}"
                 data-onglets-target="panneau" {{ loop.first ? '' : 'hidden' }}>
                {{ include('partie/batiments/_' ~ onglet.cle ~ '.html.twig') }}
            </div>
        {% endfor %}
    </section>
{% endblock %}
