{% extends 'partie/_layout.html.twig' %}

{% block title %}{{ ville.nom }} — Niout{% endblock %}

{% block body %}
    {# L'écran de ville tient dans la fenêtre : un bandeau fixe pour ce qui
       presse, une barre d'onglets, et un seul panneau ouvert à la fois — qui
       défile pour son compte. Empilée, la ville faisait plusieurs écrans de
       haut, et comparer sa masse salariale à son étal demandait de retenir. #}
    <section class="flex h-full min-h-0 flex-col"
             data-controller="onglets"
             data-onglets-actif-class="border-terre-500 text-terre-600"
             data-onglets-inactif-class="border-transparent text-encre-500">

        <div class="shrink-0 border-b border-ocre-500/25 bg-sable-50 px-6 pt-4">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
            <h1 class="font-display text-2xl text-encre-900">{{ ville.nom }}</h1>
            <div class="flex flex-wrap items-baseline gap-4">
                {# Le Temple ne se visite qu'une fois dressé : proposer l'écran
                   d'un bâtiment qu'on n'a pas ferait une porte sur du vide. #}
                {% if ville.possede(constant('App\\Game\\TypeDeBatiment::Temple')) %}
                    <a href="{{ path('app_partie_temple', {id: partie.id}) }}" class="text-sm text-lapis-500">
                        Temple
                    </a>
                {% endif %}
                <a href="{{ path('app_partie_carte', {id: partie.id}) }}" class="text-sm text-lapis-500">
                    ← Retour au territoire
                </a>
            </div>
        </div>

        {# Une fièvre qui ne se voit pas est une production qui baisse sans
           raison apparente : elle s'annonce avant toute autre chose. #}
        {% if ville.estFrappeeParUneEpidemie %}
            <p class="mt-2 rounded-sm border border-terre-600/50 bg-terre-500/10 px-4 py-2 text-xs text-encre-700">
                <span class="font-display text-lg text-encre-900">La fièvre est dans la ville.</span>
                <span data-chiffres>{{ ville.malades }}</span> bras sur
                <span data-chiffres>{{ ville.actifs }}</span> restent couchés, encore
                <span data-chiffres>{{ ville.quinzainesDepidemie }}</span>
                quinzaine{{ ville.quinzainesDepidemie > 1 ? 's' : '' }}. Nul n'en meurt.
                {% if ville.possede(constant('App\\Game\\TypeDeBatiment::Temple')) %}
                    Une offrande à Sekhmet, dont les prêtres soignent, en abrégerait le cours.
                {% endif %}
            </p>
        {% endif %}

        {# Ce que la barre de jeu ne dit pas : ce que la saison change
           concrètement. Une ligne, pas un encadré — tout ce qui est fixe ici
           est de la hauteur en moins pour le panneau ouvert. #}
        <p class="mt-2 text-xs text-encre-500">
            {% if partie.dateDeJeu.saison %}
                <strong class="text-encre-700">{{ partie.dateDeJeu.saison.libelle }}</strong>,
                {{ partie.dateDeJeu.saison.sens }} — {{ partie.dateDeJeu.saison.description }}
            {% else %}
                <strong class="text-encre-700">Hériou-renpèt</strong> — les cinq jours
                « au-dessus de l'année », hors mois et hors saison.
            {% endif %}
        </p>

        {# Le mécontentement est une spirale : la subir sans la comprendre
           serait injuste. L'écran dit la cause et le remède. #}
        {% if villeMecontente %}
            <p class="mt-4 rounded-sm border-l-4 border-terre-500 bg-terre-500/5 px-4 py-3 text-sm text-encre-700">
                <strong class="text-encre-900">La ville est mécontente</strong>
                depuis {{ mecontentement }} quinzaine{{ mecontentement > 1 ? 's' : '' }} :
                on n'y mange pas à sa faim, ou l'on n'y est pas payé.
                La production tombe à <span data-chiffres>{{ rendementDeLHumeur }} %</span>,
                les départs s'accélèrent, et votre renom s'en ressent.
                Nourrissez et payez vos gens : la colère retombe aussi lentement
                qu'elle est montée.
            </p>
        {% endif %}


            <nav class="mt-4 flex flex-wrap gap-1 text-sm" role="tablist" aria-label="Sections de la ville">
                {% if mission %}
                    <button type="button" role="tab" id="onglet-mission"
                            aria-controls="panneau-mission" aria-selected="false" tabindex="-1"
                            data-onglets-target="onglet" data-onglet-actif="false"
                            data-action="onglets#choisir keydown->onglets#naviguer"
                            class="border-b-2 px-3 py-2 hover:text-terre-600">Mission</button>
                {% endif %}
                <button type="button" role="tab" id="onglet-batiments"
                        aria-controls="panneau-batiments" aria-selected="true" tabindex="0"
                        data-onglets-target="onglet" data-onglet-actif="true"
                        data-action="onglets#choisir keydown->onglets#naviguer"
                        class="border-b-2 px-3 py-2 hover:text-terre-600">Bâtiments</button>
                <button type="button" role="tab" id="onglet-marche"
                        aria-controls="panneau-marche" aria-selected="false" tabindex="-1"
                        data-onglets-target="onglet" data-onglet-actif="false"
                        data-action="onglets#choisir keydown->onglets#naviguer"
                        class="border-b-2 px-3 py-2 hover:text-terre-600">Marché</button>
                <button type="button" role="tab" id="onglet-direction"
                        aria-controls="panneau-direction" aria-selected="false" tabindex="-1"
                        data-onglets-target="onglet" data-onglet-actif="false"
                        data-action="onglets#choisir keydown->onglets#naviguer"
                        class="border-b-2 px-3 py-2 hover:text-terre-600">Direction</button>
                <button type="button" role="tab" id="onglet-ateliers"
                        aria-controls="panneau-ateliers" aria-selected="false" tabindex="-1"
                        data-onglets-target="onglet" data-onglet-actif="false"
                        data-action="onglets#choisir keydown->onglets#naviguer"
                        class="border-b-2 px-3 py-2 hover:text-terre-600">Ateliers</button>
                <button type="button" role="tab" id="onglet-commerce"
                        aria-controls="panneau-commerce" aria-selected="false" tabindex="-1"
                        data-onglets-target="onglet" data-onglet-actif="false"
                        data-action="onglets#choisir keydown->onglets#naviguer"
                        class="border-b-2 px-3 py-2 hover:text-terre-600">Commerce</button>
                <button type="button" role="tab" id="onglet-habitants"
                        aria-controls="panneau-habitants" aria-selected="false" tabindex="-1"
                        data-onglets-target="onglet" data-onglet-actif="false"
                        data-action="onglets#choisir keydown->onglets#naviguer"
                        class="border-b-2 px-3 py-2 hover:text-terre-600">Habitants</button>
                <button type="button" role="tab" id="onglet-batir"
                        aria-controls="panneau-batir" aria-selected="false" tabindex="-1"
                        data-onglets-target="onglet" data-onglet-actif="false"
                        data-action="onglets#choisir keydown->onglets#naviguer"
                        class="border-b-2 px-3 py-2 hover:text-terre-600">À bâtir</button>
                {% if aUneMaisonDesScribes %}
                    <button type="button" role="tab" id="onglet-scribes"
                            aria-controls="panneau-scribes" aria-selected="false" tabindex="-1"
                            data-onglets-target="onglet" data-onglet-actif="false"
                            data-action="onglets#choisir keydown->onglets#naviguer"
                            class="border-b-2 px-3 py-2 hover:text-terre-600">Scribes</button>
                {% endif %}
                {% if is_granted('ROLE_DIVIN') %}
                    <button type="button" role="tab" id="onglet-essai"
                            aria-controls="panneau-essai" aria-selected="false" tabindex="-1"
                            data-onglets-target="onglet" data-onglet-actif="false"
                            data-action="onglets#choisir keydown->onglets#naviguer"
                            class="border-b-2 px-3 py-2 hover:text-terre-600">Essai</button>
                {% endif %}
            </nav>
        </div>

        {% if mission %}
            <div class="min-h-0 flex-1 overflow-y-auto px-6 pb-10 pt-4" role="tabpanel"
                 id="panneau-mission" aria-labelledby="onglet-mission" data-onglets-target="panneau" hidden>

                <h2 class="text-2xl text-encre-900">
                    Mission <span data-chiffres>{{ mission.numero }}</span> sur 10 — {{ mission.ville }}
                </h2>
                <p class="mt-2 max-w-3xl text-sm text-encre-500">
                    Commandée par <strong class="text-encre-700">{{ mission.pharaon }}</strong>.
                    {{ mission.contexte }}
                </p>

                {# Le doc 09 veut les objectifs visibles dès le premier jour :
                   découvrir tardivement une condition qu'on n'a pas pu
                   anticiper serait injuste. #}
                <h3 class="mt-6 text-lg text-encre-900">Ce que le pharaon attend</h3>
                <ul class="mt-3 max-w-3xl space-y-3 list-none p-0">
                    <li class="rounded-sm border border-ocre-500/30 bg-sable-50 px-5 py-3">
                        <div class="flex flex-wrap items-baseline justify-between gap-3">
                            <span class="text-encre-900">Résoudre le fil rouge de la mission</span>
                            <span class="text-sm {{ filRouge and filRouge.value == 'accompli' ? 'text-lapis-500' : 'text-encre-500' }}">
                                {{ filRouge ? filRouge.libelle : 'à venir' }}
                            </span>
                        </div>
                        <p class="mt-1 text-xs text-encre-500">Obligatoire : sans lui, rien n'est accompli.</p>
                    </li>

                    {% for ligne in objectifs %}
                        <li class="rounded-sm border border-ocre-500/30 bg-sable-50 px-5 py-3">
                            <div class="flex flex-wrap items-baseline justify-between gap-3">
                                <span class="text-encre-900">{{ ligne.objectif.libelle }}</span>
                                <span class="text-sm {{ ligne.atteint ? 'text-lapis-500' : 'text-encre-500' }}" data-chiffres>
                                    {{ ligne.avancement }} / {{ ligne.objectif.seuilMesure }}
                                </span>
                            </div>
                            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-sm bg-ocre-500/20">
                                <div class="h-full {{ ligne.atteint ? 'bg-lapis-500' : 'bg-terre-500' }}"
                                     style="width: {{ min(100, (ligne.avancement * 100 / max(1, ligne.objectif.seuilMesure))|round) }}%"></div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>

                <p class="mt-4 max-w-3xl text-xs text-encre-500">
                    Le fil rouge résolu suffit à clore la mission : les objectifs
                    non atteints donnent une reconnaissance plus modeste, jamais un échec.
                </p>
            </div>
        {% endif %}

        <div class="min-h-0 flex-1 overflow-y-auto px-6 pb-10 pt-4" role="tabpanel"
             id="panneau-batiments" aria-labelledby="onglet-batiments" data-onglets-target="panneau">
        {% if chantiers|length > 0 %}
            <h2 class="mt-10 text-2xl text-encre-900">Chantiers en cours</h2>
            <ul class="mt-4 space-y-3 list-none p-0">
                {% for chantier in chantiers %}
                    <li class="rounded-sm border border-ocre-500/40 bg-ocre-300/10 p-5">
                        <div class="flex flex-wrap items-baseline justify-between gap-3">
                            <h3 class="font-display text-lg text-encre-900">
                                {{ chantier.type.libelle }}
                                {% if chantier.estUneAmelioration %}
                                    <span class="font-sans text-sm text-encre-500" data-chiffres>
                                        · vers le niveau {{ chantier.niveauVise }}
                                    </span>
                                {% endif %}
                            </h3>
                            <span class="text-sm text-encre-500" data-chiffres>
                                encore {{ chantier.cyclesRestants }} cycle{{ chantier.cyclesRestants > 1 ? 's' : '' }}
                            </span>
                        </div>

                        <div class="mt-3 h-1.5 w-full overflow-hidden rounded-sm bg-ocre-500/20">
                            <div class="h-full bg-terre-500" style="width: {{ chantier.pourcentageDAvancement }}%"></div>
                        </div>

                        {# Les quatre étapes du doc 01, toutes affichées : un
                           chantier court en traverse deux par quinzaine, et
                           n'en montrer qu'une escamoterait la moitié du contenu
                           pédagogique. Celles de la quinzaine en cours portent
                           leur explication, les autres leur seul intitulé. #}
                        <ol class="mt-4 space-y-2 list-none p-0">
                            {% for rang in chantier.etapes(partie.dateDeJeu.saison) %}
                                <li class="flex gap-3 {{ rang.etat.value == 'a_venir' ? 'opacity-50' : '' }}">
                                    <span aria-hidden="true"
                                          class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full text-xs
                                                 {{ rang.etat.value == 'terminee' ? 'bg-terre-500 text-sable-50'
                                                    : (rang.etat.value == 'en_cours' ? 'border-2 border-terre-500 text-terre-600'
                                                    : 'border border-ocre-500/50 text-encre-500') }}"
                                          data-chiffres>{{ rang.etat.value == 'terminee' ? '✓' : rang.numero }}</span>
                                    <div>
                                        <p class="text-sm {{ rang.etat.value == 'en_cours' ? 'font-medium text-encre-900' : 'text-encre-600' }}">
                                            {{ rang.etape.nom }}
                                            {% if rang.etat.value == 'terminee' %}
                                                <span class="sr-only">— étape terminée</span>
                                            {% elseif rang.etat.value == 'en_cours' %}
                                                <span class="sr-only">— étape en cours</span>
                                            {% else %}
                                                <span class="sr-only">— étape à venir</span>
                                            {% endif %}
                                        </p>
                                        {% if rang.etat.value == 'en_cours' %}
                                            <p class="mt-1 text-sm text-encre-500">{{ rang.etape.explication }}</p>
                                        {% endif %}
                                    </div>
                                </li>
                            {% endfor %}
                        </ol>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <h2 class="mt-10 text-2xl text-encre-900">Bâtiments dressés</h2>
        <ul class="mt-4 space-y-3 list-none p-0">
            {% for batiment in batimentsDresses %}
                <li class="rounded-sm border border-ocre-500/30 bg-sable-50 p-5">
                    <div class="flex flex-wrap items-baseline justify-between gap-3">
                        <h3 class="font-display text-lg text-encre-900">{{ batiment.type.libelle }}</h3>
                        <span class="text-sm text-encre-500" data-chiffres>
                            Niveau {{ batiment.niveau }} sur {{ batiment.niveauMaxAtteignable }}
                        </span>
                    </div>
                    <p class="mt-2 text-sm text-encre-600">{{ batiment.type.fonction }}</p>

                    {# Une jauge, pas un recrutement : les ouvriers se puisent
                       dans le vivier d'actifs (doc 05), le joueur ne les
                       embauche pas un par un. #}
                    {% set effectif = effectifs[batiment.type.value] %}
                    <p class="mt-2 text-sm {{ effectif.rendement < 100 ? 'text-terre-600' : 'text-encre-500' }}" data-chiffres>
                        {% if effectif.requis == 0 %}
                            Sans chef : {{ effectif.rendement }} % de rendement.
                        {% else %}
                            {{ effectif.affectes }} / {{ effectif.requis }} travailleurs ·
                            {{ effectif.rendement }} % de rendement
                        {% endif %}
                    </p>
                </li>
            {% endfor %}
        </ul>

        </div>

        <div class="min-h-0 flex-1 overflow-y-auto px-6 pb-10 pt-4" role="tabpanel"
             id="panneau-marche" aria-labelledby="onglet-marche" data-onglets-target="panneau" hidden>
        {# Le Marché est la seule entrée de deben du jeu : sans lui, la dotation
           royale s'épuise et la partie se fige. C'est aussi la seule source de
           renommée branchée à ce jour (doc 13). #}
        {% if aUnMarche %}
            <h2 class="mt-10 text-2xl text-encre-900">Marché</h2>
            <p class="mt-2 text-sm text-encre-500">
                Écoulez votre surplus. C'est pour l'instant la seule façon de
                gagner des deben — l'achat et les caravanes viendront avec le
                commerce longue distance. Un gros contrat vous fait un nom.
            </p>

            {% if etal is empty %}
                <p class="mt-4 text-sm text-encre-500">Vos réserves n'ont rien à vendre pour le moment.</p>
            {% else %}
                <ul class="mt-4 space-y-3 list-none p-0">
                    {% for lot in etal %}
                        <li class="rounded-sm border border-ocre-500/30 bg-sable-50 p-5">
                            {% if partie.estEnCours %}
                                <form method="post" action="{{ path('app_partie_vendre', {id: partie.id}) }}"
                                      class="flex flex-wrap items-baseline gap-x-4 gap-y-3">
                                    <input type="hidden" name="_token" value="{{ csrf_token('vendre') }}">
                                    <input type="hidden" name="ressource" value="{{ lot.ressource.value }}">

                                    <span class="font-display text-lg text-encre-900">{{ lot.ressource.libelle }}</span>
                                    <span class="text-sm text-encre-500" data-chiffres>
                                        {{ lot.quantite }} en réserve · {{ lot.prix }} deben l'unité
                                    </span>

                                    <span class="ml-auto flex items-baseline gap-3">
                                        <label for="quantite-{{ lot.ressource.value }}" class="text-sm text-encre-600">Vendre</label>
                                        <input type="number" id="quantite-{{ lot.ressource.value }}" name="quantite"
                                               value="1" min="1" max="{{ lot.quantite }}"
                                               class="w-24 rounded-sm border border-ocre-500/40 bg-sable-50 px-3 py-2 text-sm text-encre-900"
                                               data-chiffres>
                                        <button type="submit"
                                                class="rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                                            Écouler
                                        </button>
                                    </span>
                                </form>
                            {% else %}
                                <span class="text-lg text-encre-900">{{ lot.ressource.libelle }}</span>
                                <span class="text-sm text-encre-500" data-chiffres>{{ lot.quantite }} en réserve</span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        {% endif %}

        </div>

        <div class="min-h-0 flex-1 overflow-y-auto px-6 pb-10 pt-4" role="tabpanel"
             id="panneau-direction" aria-labelledby="onglet-direction" data-onglets-target="panneau" hidden>
        {# Direction des bâtiments. Le doc 03 veut la compétence « chiffrée en
           interne, qualitative à l'affichage » : ces gabarits n'impriment donc
           que des étoiles, jamais `competence`. #}
        {% if directions is not empty %}
            <h2 class="mt-10 text-2xl text-encre-900">Direction</h2>
            <p class="mt-2 text-sm text-encre-500">
                Un bâtiment sans chef fonctionne, mais mal. Afficher une annonce
                ne coûte rien et ne prend aucune quinzaine ; c'est le chef que
                vous retenez qui se paiera — et il s'installe avec les siens.
            </p>

            <ul class="mt-5 space-y-3 list-none p-0">
                {% for direction in directions %}
                    <li class="rounded-sm border border-ocre-500/30 bg-sable-50 p-5">
                        <div class="flex flex-wrap items-baseline justify-between gap-3">
                            <h3 class="font-display text-lg text-encre-900">{{ direction.batiment.type.libelle }}</h3>
                            <span class="text-xs uppercase tracking-wide text-encre-500" data-chiffres>
                                {{ direction.chefs|length }} / {{ direction.batiment.nombreDeChefs }} chef{{ direction.batiment.nombreDeChefs > 1 ? 's' : '' }}
                            </span>
                        </div>

                        {% for chef in direction.chefs %}
                            <div class="mt-3 flex flex-wrap items-baseline gap-x-4 gap-y-2 border-t border-ocre-500/20 pt-3">
                                <span class="text-encre-900" aria-label="{{ chef.etoiles }} étoile{{ chef.etoiles > 1 ? 's' : '' }} sur 5">
                                    {{ '★★★★★'|slice(0, chef.etoiles) }}{{ '☆☆☆☆☆'|slice(0, 5 - chef.etoiles) }}
                                </span>
                                <span class="text-sm text-encre-600">
                                    {% if chef.specialite %}
                                        {{ chef.specialite.libelle }}
                                        {% if chef.specialite.agitDeja %}
                                            <span class="text-encre-500">— {{ chef.specialite.description }}</span>
                                        {% else %}
                                            <span class="text-encre-500">(sans effet pour l'instant)</span>
                                        {% endif %}
                                    {% else %}
                                        Sans spécialité
                                    {% endif %}
                                </span>
                                <span class="text-sm text-encre-500" data-chiffres>{{ chef.salaire }} deben la quinzaine</span>

                                {% if not chef.estEnPoste(partie.cycle) %}
                                    <span class="text-sm text-encre-500">Prend son poste à la prochaine quinzaine</span>
                                {% endif %}

                                {% if partie.estEnCours %}
                                    <form method="post" action="{{ path('app_partie_renvoyer', {id: partie.id}) }}" class="ml-auto">
                                        <input type="hidden" name="_token" value="{{ csrf_token('renvoyer') }}">
                                        <input type="hidden" name="employe" value="{{ chef.id }}">
                                        <button type="submit" class="text-sm text-encre-500 underline hover:text-terre-600">
                                            Renvoyer
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        {% endfor %}

                        {% if direction.offre %}
                            <p class="mt-4 border-t border-ocre-500/20 pt-3 text-sm text-encre-500">
                                {{ direction.offre.candidats|length }} candidats se présentent.
                            </p>

                            <ul class="mt-3 space-y-3 list-none p-0">
                                {% for candidat in direction.offre.candidats %}
                                    <li class="rounded-sm border border-ocre-500/20 bg-sable-50/60 p-4">
                                        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
                                            <span class="text-encre-900" aria-label="{{ candidat.etoiles }} étoile{{ candidat.etoiles > 1 ? 's' : '' }} sur 5">
                                                {{ '★★★★★'|slice(0, candidat.etoiles) }}{{ '☆☆☆☆☆'|slice(0, 5 - candidat.etoiles) }}
                                            </span>
                                            <span class="text-sm text-encre-600">
                                                {% if candidat.specialite %}
                                                    {{ candidat.specialite.libelle }}
                                                    {% if not candidat.specialite.agitDeja %}
                                                        <span class="text-encre-500">(sans effet pour l'instant)</span>
                                                    {% endif %}
                                                {% else %}
                                                    Sans spécialité
                                                {% endif %}
                                            </span>
                                            <span class="text-sm text-encre-500" data-chiffres>
                                                {{ candidat.salaire }} deben · {{ candidat.personnesAmenees }} personnes amenées
                                            </span>
                                        </div>

                                        <p class="mt-2 text-sm text-encre-500">{{ candidat.esperanceDeService }}</p>

                                        {% for trait in candidat.traits %}
                                            <p class="mt-2 text-sm text-encre-600">
                                                <strong class="font-medium">{{ trait.libelle }}</strong> — {{ trait.description }}
                                                {% if trait.dortEnAttendantSaPhase %}
                                                    <span class="text-encre-500">(sans effet pour l'instant)</span>
                                                {% endif %}
                                            </p>
                                        {% endfor %}

                                        {% if partie.estEnCours %}
                                            <form method="post" action="{{ path('app_partie_embaucher', {id: partie.id}) }}" class="mt-3">
                                                <input type="hidden" name="_token" value="{{ csrf_token('embaucher') }}">
                                                <input type="hidden" name="batiment" value="{{ direction.batiment.type.value }}">
                                                <input type="hidden" name="rang" value="{{ loop.index0 }}">
                                                <button type="submit"
                                                        class="rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                                                    Retenir ce candidat
                                                </button>
                                            </form>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>

                            {% if partie.estEnCours %}
                                <form method="post" action="{{ path('app_partie_embaucher', {id: partie.id}) }}" class="mt-3">
                                    <input type="hidden" name="_token" value="{{ csrf_token('embaucher') }}">
                                    <input type="hidden" name="batiment" value="{{ direction.batiment.type.value }}">
                                    <button type="submit" name="retirer" value="1"
                                            class="text-sm text-encre-500 underline hover:text-terre-600">
                                        Retirer l'annonce sans embaucher
                                    </button>
                                </form>
                            {% endif %}
                        {% elseif direction.postesLibres > 0 and partie.estEnCours %}
                            <form method="post" action="{{ path('app_partie_poster', {id: partie.id}) }}" class="mt-3">
                                <input type="hidden" name="_token" value="{{ csrf_token('poster') }}">
                                <input type="hidden" name="batiment" value="{{ direction.batiment.type.value }}">
                                <button type="submit"
                                        class="rounded-sm border border-ocre-500/40 px-4 py-2 text-sm text-encre-700 hover:bg-ocre-500/10">
                                    Afficher une annonce
                                </button>
                            </form>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        </div>

        <div class="min-h-0 flex-1 overflow-y-auto px-6 pb-10 pt-4" role="tabpanel"
             id="panneau-ateliers" aria-labelledby="onglet-ateliers" data-onglets-target="panneau" hidden>
        {# L'Atelier et la Forge. Un seul ouvrage à la fois **par bâtiment** :
           chacun est un lieu, pas une file, et c'est ce qui donne son coût
           d'opportunité à la fabrication — tisser, c'est ne pas cuire. Les deux
           partagent tout le reste, donc un seul gabarit les rend. #}
        {% for atelier in ateliers %}
            <h2 class="mt-10 text-2xl text-encre-900">{{ atelier.type.libelle }}</h2>

            {% if atelier.ordre %}
                <div class="mt-4 rounded-sm border border-ocre-500/40 bg-ocre-300/10 p-5">
                    <div class="flex flex-wrap items-baseline justify-between gap-3">
                        <h3 class="font-display text-lg text-encre-900">{{ atelier.ordre.recette.libelle }}</h3>
                        <span class="text-sm text-encre-500" data-chiffres>
                            encore {{ atelier.ordre.cyclesRestants }} quinzaine{{ atelier.ordre.cyclesRestants > 1 ? 's' : '' }}
                        </span>
                    </div>

                    <div class="mt-3 h-1.5 w-full overflow-hidden rounded-sm bg-ocre-500/20">
                        <div class="h-full bg-terre-500" style="width: {{ atelier.ordre.pourcentageDAvancement }}%"></div>
                    </div>

                    <p class="mt-3 text-sm text-encre-500" data-chiffres>
                        {{ atelier.ordre.lots }} lot{{ atelier.ordre.lots > 1 ? 's' : '' }} —
                        {{ atelier.ordre.piecesAttendues }} pièces à l'achèvement.
                        Les matières sont déjà payées ; rien ne rentre avant la fin.
                    </p>
                </div>
            {% else %}
                <p class="mt-2 text-sm text-encre-500">
                    Un lot consomme ses matières à l'engagement et rend plusieurs
                    pièces à l'achèvement. Ce bâtiment en mène jusqu'à
                    <span data-chiffres>{{ atelier.lotsMaximum }}</span> à la fois, et les
                    bras qui le tiennent en décident le rythme.
                </p>

                <ul class="mt-4 space-y-3 list-none p-0">
                    {% for offre in atelier.recettes %}
                        <li class="rounded-sm border p-5
                                   {{ offre.realisable ? 'border-ocre-500/30 bg-sable-50' : 'border-ocre-500/20 bg-sable-50/40' }}">
                            <div class="flex flex-wrap items-baseline justify-between gap-3">
                                <h3 class="font-display text-lg {{ offre.realisable ? 'text-encre-900' : 'text-encre-500' }}">
                                    {{ offre.recette.libelle }}
                                </h3>
                                <span class="text-sm text-encre-500" data-chiffres>
                                    {{ offre.recette.piecesDunLot }} pièces le lot ·
                                    {{ offre.recette.quinzainesDunLot }} quinzaine{{ offre.recette.quinzainesDunLot > 1 ? 's' : '' }}
                                </span>
                            </div>

                            <p class="mt-2 text-sm text-encre-600" data-chiffres>
                                Un lot :
                                {%- for libelle, quantite in offre.matieres %}
                                    {{ quantite }} {{ libelle }}{{ not loop.last ? ',' : '' }}
                                {%- endfor %}
                            </p>

                            {# Promettre un usage qui n'existe nulle part
                               tromperait le joueur au moment où il engage ses
                               matières. #}
                            {% if offre.recette.produitDortEnAttendantSonUsage %}
                                <p class="mt-2 text-sm text-encre-500">
                                    Se vend, mais n'a pas encore d'usage propre.
                                </p>
                            {% endif %}

                            {% if offre.empechement %}
                                <p class="mt-2 text-sm text-terre-600">{{ offre.empechement }}</p>
                            {% elseif partie.estEnCours %}
                                <form method="post" action="{{ path('app_partie_fabriquer', {id: partie.id}) }}"
                                      class="mt-3 flex flex-wrap items-baseline gap-3">
                                    <input type="hidden" name="_token" value="{{ csrf_token('fabriquer') }}">
                                    <input type="hidden" name="recette" value="{{ offre.recette.value }}">

                                    <label for="lots-{{ offre.recette.value }}" class="text-sm text-encre-600">Lots</label>
                                    <input type="number" id="lots-{{ offre.recette.value }}" name="lots"
                                           value="1" min="1" max="{{ atelier.lotsMaximum }}"
                                           class="w-20 rounded-sm border border-ocre-500/40 bg-sable-50 px-3 py-2 text-sm text-encre-900"
                                           data-chiffres>

                                    <button type="submit"
                                            class="ml-auto rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                                        Mettre à l'ouvrage
                                    </button>
                                </form>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        {% endfor %}

        </div>

        <div class="min-h-0 flex-1 overflow-y-auto px-6 pb-10 pt-4" role="tabpanel"
             id="panneau-commerce" aria-labelledby="onglet-commerce" data-onglets-target="panneau" hidden>
        {# Un rival ne détruit rien : il prend une part de ce qui passe. Les
           trois issues du doc 08 sont ouvertes, et l'une d'elles est de ne
           rien faire. #}
        {% if rival %}
            <div class="max-w-3xl rounded-sm border-l-4 border-terre-500 bg-terre-500/5 px-5 py-4">
                <h2 class="font-display text-lg text-encre-900">{{ rival.nom }}</h2>
                <p class="mt-1 text-sm text-encre-700">
                    Il s'est installé sur une de vos routes et vous prend
                    <span data-chiffres>{{ rival.malusEnCentiemes }} %</span> de ce qui passe.
                    Il se lassera dans <span data-chiffres>{{ rival.quinzainesRestantes }}</span>
                    quinzaine(s) si vous le laissez faire.
                </p>
                <p class="mt-2 text-sm text-encre-500">
                    Vous pouvez le payer pour qu'il s'écarte, ou chercher sur quoi il tient —
                    vos gens trouveront de quoi le démonter, et il ne reviendra pas.
                </p>

                {% if partie.estEnCours %}
                    <form method="post" action="{{ path('app_partie_accord', {id: partie.id}) }}" class="mt-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('accord') }}">
                        <button type="submit"
                                class="rounded-sm border border-ocre-500/40 px-4 py-2 text-sm text-encre-700 hover:bg-ocre-300/20">
                            Passer un accord — <span data-chiffres>{{ prixDeLAccord }}</span> deben
                        </button>
                    </form>
                {% endif %}
            </div>
        {% endif %}

        {# Les routes commerciales. Ce ne sont pas des cases sur la carte mais
           des débouchés, hors grille : le niveau du bâtiment qui les arme
           décide de ce qu'un convoi porte. #}
        {% if routes is not empty %}
            <h2 class="mt-10 text-2xl text-encre-900">Routes commerciales</h2>
            <p class="mt-2 text-sm text-encre-500">
                Ouvrir une route, c'est y envoyer une première caravane : elle
                déclare à la cité que vous êtes prêt à commercer, et la route
                n'existe qu'à son arrivée.
            </p>

            <ul class="mt-4 space-y-3 list-none p-0">
                {% for offre in routes %}
                    <li class="rounded-sm border p-5
                               {{ offre.route or offre.realisable ? 'border-ocre-500/30 bg-sable-50' : 'border-ocre-500/20 bg-sable-50/40' }}">
                        <div class="flex flex-wrap items-baseline justify-between gap-3">
                            <h3 class="font-display text-lg text-encre-900">{{ offre.partenaire.nom }}</h3>
                            <span class="text-xs uppercase tracking-wide text-encre-500">
                                {{ offre.partenaire.route.libelle }}
                            </span>
                        </div>

                        <p class="mt-2 text-sm text-encre-600">{{ offre.partenaire.description }}</p>

                        <p class="mt-2 text-sm text-encre-500" data-chiffres>
                            {{ offre.partenaire.distanceEnQuinzaines }} quinzaines de trajet ·
                            {{ offre.volume }} unités par convoi
                        </p>

                        <p class="mt-2 text-sm text-encre-600">
                            Vend
                            {%- for ressource in offre.partenaire.vend %}
                                {{ ressource.libelle }}{{ not loop.last ? ',' : '' }}
                            {%- endfor %} ·
                            achète
                            {%- for ressource in offre.partenaire.achete %}
                                {{ ressource.libelle }}{{ not loop.last ? ',' : '' }}
                            {%- endfor %}.
                        </p>

                        {% if offre.route %}
                            {% if offre.route.estOuverte %}
                                <p class="mt-3 text-sm text-encre-900">Route ouverte.</p>

                                {# Ce qui est en chemin. Un convoi parti est un
                                   engagement pris : sa marchandise a déjà quitté
                                   les réserves, ou ses deben la caisse. #}
                                {% set enChemin = offre.route.convois|filter(c => not c.estRentre) %}
                                {% if enChemin|length > 0 %}
                                    <ul class="mt-3 space-y-1 list-none p-0">
                                        {% for convoi in enChemin %}
                                            <li class="text-sm text-encre-600" data-chiffres>
                                                {{ convoi.sens.value == 'vendre' ? 'Parti avec' : 'Ramène' }}
                                                {{ convoi.quantite }} {{ convoi.ressource.libelle }}
                                                à {{ convoi.prix }} deben —
                                                retour dans {{ convoi.quinzainesAvantRetour }}
                                                quinzaine{{ convoi.quinzainesAvantRetour > 1 ? 's' : '' }}.
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}

                                {# L'étal : le joueur affiche ses conditions et
                                   attend. Le prix décide de l'empressement du
                                   partenaire, donc du volume qui bouge — et
                                   l'écran le montre **avant** qu'il ne s'engage. #}
                                <ul class="mt-3 space-y-2 list-none p-0">
                                    {% for ligne in etals[offre.partenaire.cle] ?? [] %}
                                        <li class="rounded-sm border border-ocre-500/20 bg-sable-50/60 p-3">
                                            <form method="post" action="{{ path('app_partie_etal', {id: partie.id}) }}"
                                                  class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
                                                <input type="hidden" name="_token" value="{{ csrf_token('etal') }}">
                                                <input type="hidden" name="partenaire" value="{{ offre.partenaire.cle }}">
                                                <input type="hidden" name="ressource" value="{{ ligne.ressource.value }}">
                                                <input type="hidden" name="sens" value="{{ ligne.sens.value }}">

                                                <span class="text-sm text-encre-900">
                                                    {{ ligne.sens.libelle }} {{ ligne.ressource.libelle }}
                                                </span>
                                                <span class="text-sm text-encre-500" data-chiffres>
                                                    entre {{ ligne.plancher }} et {{ ligne.plafond }} deben
                                                </span>

                                                {% if ligne.ordre %}
                                                    <span class="text-sm text-encre-900" data-chiffres>
                                                        posé à {{ ligne.ordre.prix }},
                                                        {{ ligne.ordre.quantiteParConvoi }} par convoi —
                                                        <span class="{{ ligne.empressement < 40 ? 'text-terre-600' : '' }}">
                                                            {{ ligne.empressement }} % d'empressement
                                                        </span>
                                                    </span>
                                                    <button type="submit" name="retirer" value="1"
                                                            class="ml-auto text-sm text-encre-500 underline hover:text-terre-600">
                                                        Retirer
                                                    </button>
                                                {% elseif partie.estEnCours %}
                                                    <label class="sr-only" for="prix-{{ offre.partenaire.cle }}-{{ ligne.ressource.value }}">Prix</label>
                                                    <input type="number" id="prix-{{ offre.partenaire.cle }}-{{ ligne.ressource.value }}"
                                                           name="prix" value="{{ ligne.plancher }}" min="1"
                                                           class="w-20 rounded-sm border border-ocre-500/40 bg-sable-50 px-2 py-1 text-sm text-encre-900"
                                                           data-chiffres>
                                                    <label class="sr-only" for="qte-{{ offre.partenaire.cle }}-{{ ligne.ressource.value }}">Quantité par convoi</label>
                                                    <input type="number" id="qte-{{ offre.partenaire.cle }}-{{ ligne.ressource.value }}"
                                                           name="quantite" value="{{ offre.volume }}" min="1"
                                                           class="w-20 rounded-sm border border-ocre-500/40 bg-sable-50 px-2 py-1 text-sm text-encre-900"
                                                           data-chiffres>
                                                    <button type="submit"
                                                            class="ml-auto rounded-sm border border-ocre-500/40 px-3 py-1 text-sm text-encre-700 hover:bg-ocre-500/10">
                                                        Annoncer
                                                    </button>
                                                {% endif %}
                                            </form>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                <p class="mt-3 text-sm text-encre-500" data-chiffres>
                                    Convoi en chemin : encore
                                    {{ offre.route.quinzainesAvantOuverture }}
                                    quinzaine{{ offre.route.quinzainesAvantOuverture > 1 ? 's' : '' }}.
                                </p>
                            {% endif %}
                        {% elseif offre.empechement %}
                            <p class="mt-3 text-sm text-terre-600">{{ offre.empechement }}</p>
                        {% elseif partie.estEnCours %}
                            <form method="post" action="{{ path('app_partie_commercer', {id: partie.id}) }}"
                                  class="mt-3 flex flex-wrap items-baseline gap-3">
                                <input type="hidden" name="_token" value="{{ csrf_token('commercer') }}">
                                <input type="hidden" name="partenaire" value="{{ offre.partenaire.cle }}">
                                <span class="text-sm text-encre-500" data-chiffres>{{ offre.cout }} deben</span>
                                <button type="submit"
                                        class="ml-auto rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                                    Envoyer une première {{ offre.partenaire.route.convoi }}
                                </button>
                            </form>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        </div>

        <div class="min-h-0 flex-1 overflow-y-auto px-6 pb-10 pt-4" role="tabpanel"
             id="panneau-habitants" aria-labelledby="onglet-habitants" data-onglets-target="panneau" hidden>
        {# Faire venir des habitants : deux verrous, le logement et la bourse.
           L'écran annonce les deux avant que la joueuse ne s'engage. #}
        <h2 class="mt-10 text-2xl text-encre-900">Habitants</h2>
        <p class="mt-2 text-sm text-encre-500">
            {{ ville.population }} habitants, dont {{ ville.actifs }} en âge de
            travailler et {{ ville.inactifs }} à charge.
            {{ ville.foyersOccupes }} maisonnées sur {{ ville.capaciteEnFoyers }} logées.
            {{ brasDisponibles }} bras restent à placer dans les bâtiments.
        </p>
        <p class="mt-2 text-sm {{ masseSalariale > ville.deben ? 'text-terre-600' : 'text-encre-500' }}" data-chiffres>
            Masse salariale : <strong class="font-medium">{{ masseSalariale }} deben</strong> par quinzaine,
            pour {{ ville.consommationDeNourriture }} vivres de rations.
            {% if masseSalariale > ville.deben %}
                Votre caisse ne suit plus : les équipes que vous ne pourrez pas
                payer cesseront le travail.
            {% endif %}
        </p>

        <div class="mt-4 rounded-sm border border-ocre-500/30 bg-sable-50 p-5">
            <p class="text-sm text-encre-600">
                Votre famille est <strong class="font-medium text-encre-900">{{ palier.libelle|lower }}</strong> :
                {{ palier.attractivite }}
            </p>

            {% if ville.manqueDeLogements %}
                <p class="mt-3 text-sm text-encre-500">
                    Vos maisons sont pleines. Montez le Quartier d'habitation
                    avant d'espérer faire venir du monde — et sachez qu'aucun
                    enfant ne naîtra tant qu'il n'y aura pas de place.
                </p>
            {% elseif partie.estEnCours %}
                <form method="post" action="{{ path('app_partie_appeler', {id: partie.id}) }}"
                      class="mt-3 flex flex-wrap items-baseline gap-4">
                    {# Jeton classique : « appeler » n'est pas dans
                       stateless_token_ids, donc pas de contrôleur Stimulus —
                       il écraserait un jeton valide par un jeton généré. #}
                    <input type="hidden" name="_token" value="{{ csrf_token('appeler') }}">

                    <span class="text-sm text-encre-500" data-chiffres>
                        {{ coutDUnAppel }} deben la maisonnée
                    </span>

                    <button type="submit"
                            class="ml-auto rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                        Faire venir une maisonnée
                    </button>
                </form>
            {% endif %}
        </div>

        </div>

        <div class="min-h-0 flex-1 overflow-y-auto px-6 pb-10 pt-4" role="tabpanel"
             id="panneau-batir" aria-labelledby="onglet-batir" data-onglets-target="panneau" hidden>
        <h2 class="mt-10 text-2xl text-encre-900">À bâtir</h2>
        <p class="mt-2 text-sm text-encre-500">
            Les ressources sont payées à l'engagement du chantier ; les travaux
            n'avancent ensuite qu'aux quinzaines que vous déclenchez. Pendant la crue
            d'Akhèt, la main-d'œuvre libérée les fait progresser de moitié plus vite.
        </p>

        <ul class="mt-5 space-y-3 list-none p-0">
            {% for offre in offres %}
                <li class="rounded-sm border p-5
                           {{ offre.estRealisable
                               ? 'border-ocre-500/30 bg-sable-50'
                               : 'border-ocre-500/20 bg-sable-50/40' }}">
                    <div class="flex flex-wrap items-baseline justify-between gap-3">
                        <h3 class="font-display text-lg {{ offre.estRealisable ? 'text-encre-900' : 'text-encre-500' }}">
                            {{ offre.type.libelle }}
                            {% if offre.estDejaDressé %}
                                <span class="font-sans text-sm text-encre-500" data-chiffres>
                                    · niveau {{ offre.existant.niveau }}
                                </span>
                            {% endif %}
                        </h3>
                        <span class="text-xs uppercase tracking-wide text-encre-500">
                            {{ offre.libelleDeLAction }}
                        </span>
                    </div>

                    <p class="mt-2 text-sm text-encre-600">{{ offre.type.fonction }}</p>

                    {% if offre.cout %}
                        <dl class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm" data-chiffres>
                            {% for ressource, quantite in offre.cout.detail %}
                                <div class="flex gap-1.5">
                                    <dt class="text-encre-500">{{ ressource }}</dt>
                                    <dd class="text-encre-900">{{ quantite }}</dd>
                                </div>
                            {% endfor %}
                            <div class="flex gap-1.5">
                                <dt class="text-encre-500">chantier</dt>
                                <dd class="text-encre-900">
                                    {{ offre.type.dureeDeBase + (offre.existant ? offre.existant.niveau + 1 : 1) }} cycles
                                </dd>
                            </div>
                        </dl>
                    {% endif %}

                    {% if not partie.estEnCours %}
                        {# La partie a échoué : plus aucun chantier ne s'engage. #}
                    {% elseif offre.empechement %}
                        <p class="mt-3 text-sm text-terre-600">{{ offre.empechement }}</p>
                    {% elseif ville.aUnChantierPour(offre.type) %}
                        <p class="mt-3 text-sm text-encre-500">Travaux déjà en cours.</p>
                    {% else %}
                        <form method="post" action="{{ path('app_partie_batir', {id: partie.id}) }}" class="mt-4">
                            <input type="hidden" name="_token" value="{{ csrf_token('batir') }}">
                            <input type="hidden" name="type" value="{{ offre.type.value }}">
                            <button type="submit"
                                    class="rounded-sm bg-terre-500 px-4 py-2 text-sm font-medium text-sable-50 hover:bg-terre-600">
                                {{ offre.libelleDeLAction }}
                            </button>
                        </form>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>

        </div>

        {% if aUneMaisonDesScribes %}
            <div class="min-h-0 flex-1 overflow-y-auto px-6 pb-10 pt-4" role="tabpanel"
                 id="panneau-scribes" aria-labelledby="onglet-scribes" data-onglets-target="panneau" hidden>

                {# Le fil rouge d'abord : c'est ce que le roi attend, et un fil
                   dont on ne sait pas ce qu'il demande n'est qu'une décoration. #}
                {% if filRouge %}
                    <div class="max-w-3xl rounded-sm border-l-4 border-terre-500 bg-terre-500/5 px-5 py-4">
                        <h2 class="font-display text-lg text-encre-900">{{ filRouge.libelle }}</h2>
                        <p class="mt-1 text-sm text-encre-700">{{ filRouge.consigne }}</p>
                    </div>
                {% endif %}

                {# L'inscription passe avant la clé : c'est ce qu'on vient
                   faire ici, la clé n'est que l'outil. #}
                {% if inscription %}
                    <h2 class="mt-8 text-2xl text-encre-900">Une inscription à lire</h2>
                    <p class="mt-2 max-w-2xl text-sm text-encre-500">{{ inscription.provenance }}</p>

                    <form method="post" action="{{ path('app_partie_dechiffrer', {id: partie.id}) }}"
                          class="mt-4 max-w-3xl rounded-sm border border-ocre-500/30 bg-sable-50 p-5"
                          data-controller="dechiffrage">
                        <input type="hidden" name="_token" value="{{ csrf_token('dechiffrer') }}">
                        <input type="hidden" name="inscription" value="{{ inscription.value }}">
                        <input type="hidden" name="ordre" value="" data-dechiffrage-target="reponse">

                        <p class="text-center font-display text-5xl leading-tight text-encre-900" aria-hidden="true">
                            {%- for signe in inscription.signes %}{{ signe.signe }}{% endfor -%}
                        </p>
                        <p class="mt-1 text-center text-xs text-encre-500">
                            <span data-chiffres>{{ inscription.signes|length }}</span> signes, gravés dans cet ordre.
                        </p>

                        <p class="mt-5 text-sm text-encre-600">
                            Placez les sens dans l'ordre des signes. Cliquez un mot pour le
                            poser, une case pour la vider — ou faites-les glisser.
                        </p>

                        <ol class="mt-3 flex flex-wrap justify-center gap-3 list-none p-0">
                            {% for rang in 1..inscription.signes|length %}
                                <li>
                                    <button type="button" data-dechiffrage-target="case"
                                            data-action="click->dechiffrage#retirer dragover->dechiffrage#survoler drop->dechiffrage#deposer"
                                            aria-label="Case {{ rang }}, vide"
                                            class="flex h-16 w-16 items-center justify-center rounded-sm border-2 border-dashed
                                                   border-ocre-500/50 bg-sable-100 font-display text-3xl text-encre-900"></button>
                                </li>
                            {% endfor %}
                        </ol>

                        <ul class="mt-5 flex flex-wrap justify-center gap-2 list-none p-0"
                            data-dechiffrage-target="reserve">
                            {% for signe in melange %}
                                <li>
                                    <button type="button" draggable="true"
                                            data-signe="{{ signe.value }}"
                                            data-glyphe="{{ signe.signe }}"
                                            data-libelle="{{ signe.libelle }}"
                                            data-action="click->dechiffrage#placer dragstart->dechiffrage#prendre"
                                            class="rounded-sm border border-ocre-500/40 bg-sable-100 px-3 py-2 text-sm
                                                   text-encre-700 hover:bg-ocre-300/20">
                                        {{ signe.libelle }}
                                    </button>
                                </li>
                            {% endfor %}
                        </ul>

                        <div class="mt-5 text-center">
                            <button type="submit" data-dechiffrage-target="valider" disabled
                                    class="rounded-sm bg-terre-500 px-5 py-2 text-sm font-medium text-sable-50
                                           hover:bg-terre-600 disabled:cursor-not-allowed disabled:opacity-40">
                                Lire l'inscription
                            </button>
                        </div>
                    </form>
                {% elseif inscriptionsLues > 0 %}
                    <h2 class="text-2xl text-encre-900">Rien à lire pour l'instant</h2>
                    <p class="mt-2 max-w-2xl text-sm text-encre-500">
                        Vos scribes ont lu tout ce qui leur est passé sous les yeux.
                        De nouveaux signes ouvriront de nouvelles inscriptions.
                    </p>
                {% endif %}

                {% if inscriptionsLues > 0 %}
                    <h2 class="mt-8 text-2xl text-encre-900">Déjà lues</h2>
                    <ul class="mt-3 space-y-2 list-none p-0">
                        {% for lue in ville.inscriptionsDechiffrees %}
                            <li class="rounded-sm border border-ocre-500/30 bg-sable-50 px-4 py-3 text-sm">
                                <span class="font-display text-2xl align-middle" aria-hidden="true">
                                    {%- for signe in lue.signes %}{{ signe.signe }}{% endfor -%}
                                </span>
                                <span class="ml-3 text-encre-700">{{ lue.lecture }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if dossiers is not empty %}
                    <h2 class="mt-8 text-2xl text-encre-900">Dossiers d'enquête</h2>
                    <p class="mt-2 max-w-2xl text-sm text-encre-500">
                        Ce que vos gens ont rapporté. Tout ne concourt pas :
                        c'est à vous de démêler ce qui tient de ce qui égare.
                    </p>

                    <ul class="mt-4 space-y-4 list-none p-0">
                        {% for entree in dossiers %}
                            {% set dossier = entree.dossier %}
                            <li class="max-w-3xl rounded-sm border border-ocre-500/30 bg-sable-50 p-5">
                                <div class="flex flex-wrap items-baseline justify-between gap-3">
                                    <h3 class="font-display text-lg text-encre-900">
                                        {{ dossier.enquete.libelle }}
                                        {% if dossier.enquete.estPrincipale %}
                                            <span class="ml-2 text-xs text-terre-600">fil rouge</span>
                                        {% endif %}
                                    </h3>
                                    <span class="text-sm text-encre-500" data-chiffres>
                                        {{ dossier.concordantsReunis }} / {{ dossier.enquete.indicesRequis }}
                                        indices concordants
                                    </span>
                                </div>

                                <p class="mt-2 text-sm text-encre-600">{{ dossier.enquete.question }}</p>

                                <ul class="mt-3 space-y-2 list-none p-0">
                                    {% for indice in dossier.indices %}
                                        <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-l-2 border-ocre-500/40 pl-3 text-sm">
                                            <span class="text-encre-700">{{ indice.texte }}</span>
                                            <span class="text-xs text-encre-500">
                                                {{ indice.source.libelle }} · {{ indice.nature.libelleAffiche|lower }}
                                            </span>
                                        </li>
                                    {% endfor %}
                                </ul>

                                {% if dossier.statut.value != 'en_cours' %}
                                    <p class="mt-3 text-sm {{ dossier.statut.value == 'resolue' ? 'text-lapis-500' : 'text-terre-600' }}">
                                        {{ dossier.statut.libelle }}. {{ dossier.enquete.denouement }}
                                    </p>
                                {% elseif entree.peutConclure %}
                                    <p class="mt-4 text-sm text-encre-700">
                                        Vous en savez assez pour trancher.
                                        {% if dossier.enquete.estPrincipale %}
                                            Se tromper coûtera deux quinzaines, et rien d'autre.
                                        {% else %}
                                            Se tromper enterrera l'affaire.
                                        {% endif %}
                                    </p>

                                    <form method="post" action="{{ path('app_partie_conclure', {id: partie.id}) }}"
                                          class="mt-3 flex flex-col gap-2">
                                        <input type="hidden" name="_token" value="{{ csrf_token('conclure') }}">
                                        <input type="hidden" name="enquete" value="{{ dossier.enquete.value }}">

                                        {% for conclusion in entree.conclusions %}
                                            <button type="submit" name="conclusion" value="{{ conclusion }}"
                                                    class="rounded-sm border border-ocre-500/40 bg-sable-100 px-4 py-2 text-left
                                                           text-sm text-encre-700 hover:bg-ocre-300/20">
                                                {{ conclusion }}
                                            </button>
                                        {% endfor %}
                                    </form>
                                {% elseif dossier.rejouableAuCycle > partie.cycle %}
                                    <p class="mt-3 text-sm text-encre-500">
                                        Vos scribes reprennent le dossier depuis le début : encore
                                        <span data-chiffres>{{ dossier.rejouableAuCycle - partie.cycle }}</span>
                                        quinzaine(s).
                                    </p>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if enigmes is not empty %}
                    <h2 class="mt-8 text-2xl text-encre-900">Questions en suspens</h2>
                    <p class="mt-2 max-w-2xl text-sm text-encre-500">
                        Rien ne vous oblige à y répondre — mais on ne répond
                        qu'une fois. Juste ou faux, vous saurez pourquoi.
                    </p>

                    <ul class="mt-4 space-y-4 list-none p-0">
                        {% for question in enigmes %}
                            <li class="max-w-3xl rounded-sm border border-ocre-500/30 bg-sable-50 p-5">
                                <div class="flex flex-wrap items-baseline justify-between gap-3">
                                    <p class="text-encre-900">{{ question.enigme.enonce }}</p>
                                    <span class="text-xs text-encre-500">
                                        {{ question.enigme.lieu.libelle }} ·
                                        {{ question.enigme.sourceAttestee ? 'd\'après les sources' : 'dans leur esprit' }}
                                    </span>
                                </div>

                                <form method="post" action="{{ path('app_partie_enigme', {id: partie.id}) }}"
                                      class="mt-4 flex flex-col gap-2">
                                    <input type="hidden" name="_token" value="{{ csrf_token('enigme') }}">
                                    <input type="hidden" name="enigme" value="{{ question.enigme.value }}">

                                    {% for proposition in question.propositions %}
                                        <button type="submit" name="reponse" value="{{ proposition }}"
                                                class="rounded-sm border border-ocre-500/40 bg-sable-100 px-4 py-2 text-left
                                                       text-sm text-encre-700 hover:bg-ocre-300/20">
                                            {{ proposition }}
                                        </button>
                                    {% endfor %}
                                </form>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                <h2 class="mt-8 text-2xl text-encre-900">Clé de lecture</h2>
                <p class="mt-2 max-w-2xl text-sm text-encre-500">
                    Les signes que vos scribes savent lire, tirés de la liste de
                    Gardiner — la classification de référence des hiéroglyphes.
                    Chacun porte son vrai code et son vrai sens : ce que vous
                    apprenez ici est ce qu'un égyptologue lirait.
                    <span data-chiffres>{{ cleDeLecture|length }}</span> sur
                    <span data-chiffres>{{ signesEnTout }}</span>.
                </p>

                {% if prochainSigne %}
                    <p class="mt-3 rounded-sm border-l-4 border-lapis-500 bg-lapis-500/5 px-4 py-2 text-sm text-encre-600">
                        Monter la Maison des scribes ouvrirait le signe suivant :
                        <span class="font-display text-2xl align-middle">{{ prochainSigne.signe }}</span>
                        {{ prochainSigne.libelle|lower }} ({{ prochainSigne.codeDeGardiner }}).
                    </p>
                {% else %}
                    <p class="mt-3 text-sm text-encre-600">
                        Vos scribes lisent tout ce que cette clé contient.
                    </p>
                {% endif %}

                <ul class="mt-4 grid gap-3 list-none p-0 sm:grid-cols-2 lg:grid-cols-3">
                    {% for symbole in cleDeLecture %}
                        <li class="flex gap-4 rounded-sm border border-ocre-500/30 bg-sable-50 p-4">
                            <span class="font-display text-4xl leading-none text-encre-900"
                                  aria-hidden="true">{{ symbole.signe }}</span>
                            <span>
                                <span class="block text-encre-900">{{ symbole.libelle }}</span>
                                <span class="block text-xs text-encre-500" data-chiffres>{{ symbole.codeDeGardiner }}</span>
                                <span class="mt-1 block text-sm text-encre-600">{{ symbole.sens }}</span>
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {% if is_granted('ROLE_DIVIN') %}
            <div class="min-h-0 flex-1 overflow-y-auto px-6 pb-10 pt-4" role="tabpanel"
                 id="panneau-essai" aria-labelledby="onglet-essai" data-onglets-target="panneau" hidden>
        {# Une partie d'essai le dit en toutes lettres : elle ne doit jamais se
           confondre avec une vraie. Le bouton n'existe que pour un compte qui
           porte le rôle — la route le vérifie de son côté, l'absence
           d'affichage n'étant pas une barrière. #}
        {% if is_granted('ROLE_DIVIN') %}
            <div class="mt-4 rounded-sm border border-lapis-500/40 bg-lapis-500/5 px-4 py-3 text-sm text-encre-700">
                {% if partie.estEnModeDivin %}
                    <strong class="text-encre-900">Partie d'essai.</strong>
                    Un million de chaque ressource, aucun plafond de réserve.
                    Rien de ce qui s'y passe ne vaut comme partie jouée.
                {% else %}
                    <strong class="text-encre-900">Partie ordinaire.</strong>
                    Le mode d'essai comble les réserves et lève les plafonds,
                    pour éprouver un système sans jouer les heures qui y mènent.
                {% endif %}

                <form method="post" action="{{ path('app_partie_divin', {id: partie.id}) }}"
                      class="mt-3 flex flex-wrap items-center gap-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('divin') }}">
                    <input type="hidden" name="retour" value="app_partie_ville">
                    <button type="submit"
                            class="rounded-sm border border-lapis-500/50 px-4 py-2 text-sm text-encre-700 hover:bg-lapis-500/10">
                        {{ partie.estEnModeDivin ? 'Revenir aux règles ordinaires' : 'Passer en partie d\'essai' }}
                    </button>
                    {% if partie.estEnModeDivin %}
                        <button type="submit" name="combler" value="1"
                                class="text-sm text-encre-500 underline hover:text-lapis-500">
                            Recombler les réserves
                        </button>
                        <button type="submit" name="brouillard" value="1"
                                class="text-sm text-encre-500 underline hover:text-lapis-500">
                            Lever le brouillard
                        </button>
                    {% endif %}
                </form>
            </div>
        {% endif %}
            </div>
        {% endif %}
    </section>
{% endblock %}
