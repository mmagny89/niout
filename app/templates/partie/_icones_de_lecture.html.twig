{# Les icônes de la barre de lecture et de la frise : de simples pictogrammes pleins, décoratifs.
   **Le nom accessible vit sur le bouton** (`aria-label` + `title`), jamais sur l'icône :
   un bouton sans texte visible reste lisible au lecteur d'écran.

   Usage : `{% import 'partie/_icones_de_lecture.html.twig' as icones %}` puis `{{ icones.icone('lecture') }}`. #}
{% macro icone(nom, classe = 'size-5') %}
    <svg class="{{ classe }} shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
        {% if 'lecture' == nom %}
            <path d="M6 4.2v11.6a.7.7 0 0 0 1.06.6l9.2-5.8a.7.7 0 0 0 0-1.2L7.06 3.6A.7.7 0 0 0 6 4.2Z"/>
        {% elseif 'pause' == nom %}
            <rect x="5" y="4" width="3.6" height="12" rx="1"/><rect x="11.4" y="4" width="3.6" height="12" rx="1"/>
        {% elseif 'jour-precedent' == nom %}
            <rect x="3.5" y="4" width="2.2" height="12" rx="1"/><path d="M16.5 4.6v10.8a.6.6 0 0 1-.95.5l-7.4-5.4a.6.6 0 0 1 0-1l7.4-5.4a.6.6 0 0 1 .95.5Z"/>
        {% elseif 'jour-suivant' == nom %}
            <rect x="14.3" y="4" width="2.2" height="12" rx="1"/><path d="M3.5 4.6v10.8a.6.6 0 0 0 .95.5l7.4-5.4a.6.6 0 0 0 0-1L4.45 4.1a.6.6 0 0 0-.95.5Z"/>
        {% elseif 'vitesse-1' == nom %}
            <path d="M8 4.5 13.5 10 8 15.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        {% elseif 'vitesse-2' == nom %}
            <path d="M5 4.5 10.5 10 5 15.5M10.5 4.5 16 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        {% elseif 'vitesse-3' == nom %}
            <path d="M2.5 5 7 10l-4.5 5M7.5 5l4.5 5-4.5 5M12.5 5l4.5 5-4.5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        {% elseif 'maintenant' == nom %}
            <circle cx="10" cy="10" r="6.2" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="10" cy="10" r="2.6"/>
        {% endif %}
    </svg>
{% endmacro %}
