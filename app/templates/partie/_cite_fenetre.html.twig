{# La fenêtre de la cité, par-dessus la carte : un carré par bâtiment construit.

   **Des carrés, pas encore des images** : les visuels viennent plus tard.
   Chaque carré a son emplacement — l'image s'il en existe une
   (`assets/images/batiments/<type>.webp`), un monogramme sinon —, de sorte que
   les déposer ne change rien d'autre.

   Un clic sur un carré ouvre l'onglet du bâtiment. La fenêtre est un
   `<dialog>` natif : Échap, piège à focus et inertie du fond sont ceux du
   navigateur (`cite_controller.js`). Sans JavaScript, elle reste fermée et la
   tuile mène à la page de la cité. #}
<dialog data-cite-target="fenetre" data-action="click->cite#surFond"
        aria-labelledby="cite-titre"
        class="m-auto w-[min(92vw,44rem)] max-h-[85vh] overflow-y-auto rounded-sm border border-ocre-500/40
               bg-sable-50 p-0 text-encre-900 shadow-xl backdrop:bg-encre-900/50">
    <div class="flex items-baseline justify-between gap-4 border-b border-ocre-500/25 px-5 py-3">
        <div>
            <h2 id="cite-titre" class="font-display text-xl text-encre-900">La cité {{ ville.avecPreposition }}</h2>
            <p class="text-xs text-encre-500" data-chiffres>
                {{ batimentsDeLaCite|length }} bâtiment{{ batimentsDeLaCite|length > 1 ? 's' : '' }}
                · {{ ville.population }} habitants
            </p>
        </div>
        <button type="button" data-action="cite#fermer"
                class="rounded-sm px-2 py-1 text-2xl leading-none text-encre-500 hover:text-terre-600"
                aria-label="Fermer la cité">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>

    <ul class="grid list-none grid-cols-3 gap-3 p-5 sm:grid-cols-4">
        {% for entree in batimentsDeLaCite %}
            {% set type = entree.type %}
            <li>
                <a href="{{ path('app_partie_ville', {id: partie.id, onglet: type.value}) }}"
                   class="group relative flex aspect-square flex-col items-center justify-center overflow-hidden rounded-sm
                          border border-ocre-500/40 bg-sable-200 text-center no-underline
                          hover:border-terre-500/70 hover:bg-ocre-300/30 focus-visible:outline-2 focus-visible:outline-lapis-500"
                   title="{{ type.libelle }}{{ entree.batiment ? ' — niveau ' ~ entree.batiment.niveau : '' }}">
                    {% if entree.visuel %}
                        <img src="{{ asset(entree.visuel) }}" alt="" loading="lazy" decoding="async"
                             class="absolute inset-0 h-full w-full object-cover">
                    {% else %}
                        <span class="font-display text-4xl text-ocre-600/70 group-hover:text-terre-500" aria-hidden="true">
                            {{ type.libelle|first|upper }}
                        </span>
                    {% endif %}

                    <span class="absolute inset-x-0 bottom-0 bg-sable-50/90 px-1 py-1 text-xs leading-tight text-encre-900">
                        {{ type.libelle }}
                        {% if entree.batiment %}
                            <span class="block text-encre-500" data-chiffres>niv. {{ entree.batiment.niveau }}</span>
                        {% endif %}
                    </span>

                    {% if entree.chantier %}
                        <span class="absolute right-1 top-1 rounded-sm bg-ocre-500 px-1.5 py-0.5 text-[10px] font-medium text-sable-50"
                              title="Travaux en cours">
                            <span aria-hidden="true">⚒</span>
                            <span class="sr-only">Travaux en cours</span>
                        </span>
                    {% endif %}
                </a>
            </li>
        {% endfor %}
    </ul>

    <div class="flex flex-wrap items-baseline justify-between gap-3 border-t border-ocre-500/25 px-5 py-3 text-sm">
        <a href="{{ path('app_partie_cite', {id: partie.id}) }}" class="text-lapis-500">Voir la cité en page</a>
        <a href="{{ path('app_partie_ville', {id: partie.id}) }}" class="text-lapis-500">Gérer la ville →</a>
    </div>
</dialog>
