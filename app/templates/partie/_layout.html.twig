{% extends 'base.html.twig' %}

{# Gabarit commun aux écrans de partie. Il porte la barre de jeu, que le
   document 15 veut visible en permanence : le joueur doit toujours savoir de
   quoi il dispose et à quelle date il se trouve, sans changer de page. #}

{% block barreDeJeu %}
    <div class="border-b border-ocre-500/25 bg-sable-50">
        <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-8 gap-y-3 px-5 py-3">
            <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1">
                <a href="{{ path('app_partie_carte', {id: partie.id}) }}"
                   class="font-display text-lg text-terre-600 no-underline">
                    {{ partie.ville.nom }}
                </a>

                {# Chaque matériau garde son nom propre : un compteur générique
                   « bois » qui agrégerait roseaux et cèdre cacherait au joueur
                   ce qu'il possède réellement. Deben et vivres restent des
                   compteurs à part — le second est une somme délibérée (blé,
                   orge, dattes, poisson), c'est ce qui paie une expédition
                   quel que soit le vivre en réserve. L'or, lui, s'affiche
                   désormais parmi les matériaux : c'est un métal qu'on extrait. #}
                <dl class="flex flex-wrap gap-x-5 gap-y-1 text-sm" data-chiffres>
                    <div class="flex items-baseline gap-1.5">
                        <dt class="text-encre-500">Deben</dt>
                        <dd class="text-encre-900">{{ partie.ville.deben }}</dd>
                    </div>
                    {% for ligne in partie.ville.stockAffichable %}
                        {% if not ligne.ressource.estLaMonnaie and not ligne.ressource.estNourriture %}
                            <div class="flex items-baseline gap-1.5">
                                <dt class="text-encre-500">{{ ligne.ressource.libelle|capitalize }}</dt>
                                <dd class="text-encre-900">{{ ligne.quantite }}</dd>
                            </div>
                        {% endif %}
                    {% endfor %}
                    {# Chaque réserve avec son plafond : le joueur doit voir la
                       saturation venir, pas la découvrir en perdant une
                       moisson. #}
                    <div class="flex items-baseline gap-1.5"
                         title="Le Grenier tient les vivres. Au-delà de {{ partie.ville.plafondDesVivres }}, ce qui rentre se perd.">
                        <dt class="text-encre-500">Vivres</dt>
                        <dd class="{{ partie.ville.vivresPresqueSatures ? 'text-terre-600' : 'text-encre-900' }}">
                            {{ partie.ville.nourriture }} / {{ partie.ville.plafondDesVivres }}
                        </dd>
                    </div>
                    <div class="flex items-baseline gap-1.5"
                         title="L'Entrepôt tient les matériaux et les objets. Au-delà de {{ partie.ville.plafondDesMateriaux }}, ce qui rentre se perd.">
                        <dt class="text-encre-500">Réserves</dt>
                        <dd class="{{ partie.ville.materiauxPresqueSatures ? 'text-terre-600' : 'text-encre-900' }}">
                            {{ partie.ville.materiaux }} / {{ partie.ville.plafondDesMateriaux }}
                        </dd>
                    </div>
                    {# Un actif est un bras et une ration ; un inactif — enfant
                       ou ancien — une demi-ration. Le détail explique pourquoi
                       deux villes de même population ne coûtent pas la même
                       chose. #}
                    <div class="flex items-baseline gap-1.5"
                         title="{{ partie.ville.actifs }} actif(s), {{ partie.ville.inactifs }} inactif(s) — consomme {{ partie.ville.consommationDeNourriture }} vivre(s) par quinzaine">
                        <dt class="text-encre-500">Habitants</dt>
                        <dd class="text-encre-900">{{ partie.ville.population }}</dd>
                    </div>
                    <div class="flex items-baseline gap-1.5" title="Les bras que la ville peut mettre au travail">
                        <dt class="text-encre-500">Actifs</dt>
                        <dd class="text-encre-900">{{ partie.ville.actifs }}</dd>
                    </div>
                    {# Le diagnostic du logement : tant qu'il reste des places,
                       la ville peut accueillir ; à zéro, il faut bâtir avant
                       d'espérer un habitant de plus. #}
                    <div class="flex items-baseline gap-1.5"
                         title="{{ partie.ville.manqueDeLogements
                             ? 'Plus une place : montez le Quartier d\'habitation pour faire venir du monde'
                             : 'Maisonnées que la ville peut encore loger' }}">
                        <dt class="text-encre-500">Logements</dt>
                        <dd class="{{ partie.ville.manqueDeLogements ? 'text-terre-600' : 'text-encre-900' }}">
                            {{ partie.ville.foyersOccupes }}/{{ partie.ville.capaciteEnFoyers }}
                        </dd>
                    </div>
                </dl>
            </div>

            <div class="flex flex-wrap items-center gap-4">
                <p class="text-sm text-encre-600">
                    {{ partie.dateDeJeu.libelle }}
                    <span class="text-encre-500" data-chiffres>· cycle {{ partie.cycle }}</span>
                    {# La crue de l'année conditionne la moisson de Chémou : le
                       joueur doit l'avoir sous les yeux quand il décide de semer. #}
                    <span class="text-encre-500" title="{{ partie.crue.presage }}">· crue {{ partie.crue.libelle }}</span>
                    {# Une fête qu'on n'a pas vue passer est une fête qui n'existe
                       pas : elle ne dure que deux à quatre quinzaines par an. #}
                    {% if partie.feteEnCours %}
                        <span class="text-lapis-500" title="{{ partie.feteEnCours.description }}">
                            · {{ partie.feteEnCours.libelle }}
                        </span>
                    {% endif %}
                </p>

                {% block actionDeCycle %}
                    {% if partie.estEnCours %}
                        <form method="post" action="{{ path('app_partie_cycle', {id: partie.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('cycle') }}">
                            {# Le joueur revient où il était : avancer le temps
                               depuis la ville ne doit pas l'éjecter sur la carte. #}
                            <input type="hidden" name="retour" value="{{ app.request.attributes.get('_route') }}">
                            <button type="submit"
                                    class="rounded-sm bg-lapis-500 px-4 py-1.5 text-sm font-medium text-sable-50 hover:bg-lapis-600">
                                Quinzaine suivante
                            </button>
                        </form>
                    {% else %}
                        {# La famine a eu raison de la ville : le temps ne
                           s'avance plus, mais la partie reste consultable
                           (doc 00 — chaque partie est une run complète). #}
                        <span class="rounded-sm bg-terre-100 px-4 py-1.5 text-sm font-medium text-terre-700">
                            Partie échouée — famine
                        </span>
                    {% endif %}
                {% endblock %}
            </div>
        </div>
    </div>
{% endblock %}
