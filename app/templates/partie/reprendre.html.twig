{% extends 'partie/_layout.html.twig' %}

{% block title %}{{ partie.ville.nom }} — Niout{% endblock %}

{% block body %}
    <section class="mx-auto w-full max-w-2xl px-5 py-14">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-terre-500">
            {% if mission %}
                Mission {{ mission.numero }} sur 10 · {{ mission.region }}
            {% else %}
                Mode Aventure
            {% endif %}
        </p>
        <h1 class="mt-4 text-4xl leading-tight text-encre-900">{{ partie.ville.nom }}</h1>
        <p class="mt-3 text-encre-600">
            Famille {{ partie.famille.nom }} · renommée {{ partie.famille.palierDeRenommee|lower }}
        </p>

        <div class="mt-9 rounded-sm border border-ocre-500/30 bg-sable-50 p-6">
            <h2 class="text-lg text-encre-900">Où vous en êtes</h2>

            <dl class="mt-4 grid grid-cols-2 gap-5 sm:grid-cols-4" data-chiffres>
                {# Un récapitulatif tient sur peu de cases : la monnaie et les vivres
                   sont les deux ressources universelles, à toujours montrer.
                   Le détail matériau par matériau vit dans la barre de jeu,
                   une fois la partie reprise. #}
                {% set indicateurs = [
                    { libelle: 'Cycle', valeur: partie.cycle },
                    { libelle: 'Deben', valeur: partie.ville.deben },
                    { libelle: 'Vivres', valeur: partie.ville.nourriture },
                    { libelle: 'Bâtiments', valeur: partie.ville.batiments|length },
                ] %}
                {% for indicateur in indicateurs %}
                    <div>
                        <dt class="text-xs uppercase tracking-wide text-encre-500">{{ indicateur.libelle }}</dt>
                        <dd class="font-display text-2xl text-terre-600">{{ indicateur.valeur }}</dd>
                    </div>
                {% endfor %}
            </dl>

            <p class="mt-5 text-sm text-encre-500">
                Rien ne s'est produit en votre absence : dans Niout, le temps n'avance
                que lorsque vous déclenchez un cycle.
            </p>
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-5">
            <a href="{{ path('app_partie_carte', {id: partie.id}) }}"
               class="rounded-sm bg-terre-500 px-5 py-2.5 font-medium text-sable-50 no-underline hover:bg-terre-600">
                Reprendre la partie
            </a>
            <a href="{{ path('app_compte') }}" class="text-lapis-500">Retour à mes parties</a>
            <a href="{{ path('app_partie_abandonner', {id: partie.id}) }}"
               class="text-sm text-encre-500 hover:text-terre-600">
                Abandonner cette partie
            </a>
        </div>
    </section>
{% endblock %}
