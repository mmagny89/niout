# Variables Docker Compose — lues uniquement par Docker Compose
# (conventions, section 3). Committe, sans secret. Genere par
# .claude/scripts/setup-symfony.sh le 2026-08-27.
#
# En staging et production, remplace (pas complete) par --env-file
# .env.staging.local / .env.prod.local, qui portent toutes les cles.

COMPOSE_FILE=compose.yml:compose.dev.yml

# Suffixe des noms de conteneurs, reseau et volumes (section 2). Sans lui,
# deux environnements du meme projet sur un meme hote partageraient le meme
# volume de base de donnees, sans qu'aucune erreur ne le signale.
ENV=dev

# Versions d'images — verifiees aupres des registres le 2026-08-27.
PHP_VERSION=8.5
FRANKENPHP_VERSION=1.12.7
PHP_EXTENSION_INSTALLER_VERSION=2.11.12
POSTGRES_VERSION=18
EMBER_VERSION=1.6.0
# Attrapeur d'emails de developpement : aucun message ne sort de la machine.
MAILPIT_VERSION=1.31.1

# Stage du Dockerfile PHP construit par un "docker compose -f compose.yml
# build" autonome ; les overrides figent target:/image: en dur.
TARGET=dev

# UID/GID de l'hote (section 6) — machine de generation.
USER_ID=501
GROUP_ID=20

# Xdebug — jamais fige au build (section 13).
XDEBUG_MODE=off

# Ports (section 4) — valeurs fixes, jamais deduites de l'hote.
HTTP_PORT=80
HTTPS_PORT=443
HTTP3_PORT=443
POSTGRES_PORT=5432
EMBER_PORT=9191
# Interface web de Mailpit. Son port SMTP (1025) reste interne : rien ne le
# joint depuis l'hote, et rien ne doit le joindre.
MAILPIT_PORT=8025

# Mise a jour de schema au demarrage (section 8) — active en dev.
RUN_MIGRATIONS=1

# PostgreSQL — developpement uniquement.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=!ChangeMe!

###> emails ###
# Transport des emails. En developpement, tout part vers Mailpit, qui les
# retient et les affiche sur http://localhost:${MAILPIT_PORT} ; rien ne quitte
# la machine. Staging et production portent leur propre valeur dans leur
# fichier de secrets, ce fichier n'etant pas lu la-bas.
MAILER_DSN=smtp://mailpit:1025
# Adresse expeditrice des emails transactionnels. En developpement elle n'est
# jamais delivree, Mailpit acceptant tout.
MAILER_FROM=noreply@niout.localhost
###< emails ###
